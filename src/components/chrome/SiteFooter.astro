---
import Icon from '@/components/ui/Icon.astro';
import Logomark from '@/components/ui/Logomark.astro';
import { closing } from '@/config/home';
import { legalLinks, navigation, siteConfig } from '@/config/site';
import { socialIcon } from '@/lib/socials';

interface Props {
  closing?: boolean;
}

const { closing: showClosing = true } = Astro.props;
const { email } = siteConfig.author;
const year = new Date().getFullYear();
---

{showClosing && (
  <section class="shell mt-24 sm:mt-32" aria-labelledby="closing-title">
    <div class="relative overflow-hidden rounded-[2rem] bg-night px-6 py-14 text-night-ink sm:px-12 sm:py-20 lg:p-20">
      <div class="relative flex flex-col gap-10 lg:flex-row lg:items-stretch lg:gap-0">
        <div class="flex min-w-0 flex-1 flex-col items-start justify-between gap-10">
          <div class="flex flex-col items-start gap-8">
            <p class="eyebrow text-night-muted">{closing.eyebrow}</p>
            <h2 id="closing-title" class="closing-title">
              {closing.title} <span class="whitespace-nowrap text-accent">{closing.highlight}</span> {closing.suffix}
            </h2>
          </div>
          <a class="btn btn-accent self-start" href={`mailto:${email}`}>
            {email}
            <Icon name="arrow-up-right" class="icon-nudge-diagonal size-4" />
          </a>
        </div>
        <img
          src="/wechat-qr.png"
          alt="微信二维码：扫码添加我"
          width="204"
          height="238"
          loading="lazy"
          class="block h-[238px] w-[204px] shrink-0 self-start rounded-lg bg-white"
        />
      </div>
    </div>
  </section>
)}

<footer class="mt-24 border-t border-line sm:mt-32">
  <div class="shell grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
    <div>
      <a href="/" class="inline-flex items-center gap-2.5 text-[1.15rem] font-semibold tracking-[-0.03em]">
        <Logomark />
        <span>{siteConfig.name}</span>
        <span class="sr-only">, home</span>
      </a>
      <p class="mt-5 max-w-xs text-muted">
        {siteConfig.author.role} based in {siteConfig.author.location}. Working with teams worldwide.
      </p>
    </div>

    <nav aria-labelledby="footer-pages">
      <h2 id="footer-pages" class="text-sm font-medium text-muted">
        Pages
      </h2>
      <ul class="mt-4 grid gap-2.5">
        <li>
          <a class="footer-link" href="/">
            Home
          </a>
        </li>
        {navigation.map((link) => (
          <li>
            <a class="footer-link" href={link.href}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="footer-elsewhere">
      <h2 id="footer-elsewhere" class="text-sm font-medium text-muted">
        Elsewhere
      </h2>
      <ul class="mt-4 grid gap-2.5">
        {siteConfig.socials.map((social) => (
          <li>
            <a class="footer-link inline-flex items-center gap-2.5" href={social.href} rel="me noopener">
              <Icon name={socialIcon(social.label)} class="size-3.5 text-muted" />
              {social.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="footer-legal">
      <h2 id="footer-legal" class="text-sm font-medium text-muted">
        Legal
      </h2>
      <ul class="mt-4 grid gap-2.5">
        {legalLinks.map((link) => (
          <li>
            <a class="footer-link" href={link.href}>
              {link.label}
            </a>
          </li>
        ))}
        {siteConfig.cookieConsent.enabled && (
          <li>
            <button type="button" class="footer-link text-left" data-cookie-preferences data-needs-js>
              Cookie preferences
            </button>
          </li>
        )}
      </ul>
    </nav>
  </div>

  <div class="shell flex flex-wrap items-center justify-between gap-4 border-t border-line py-6 text-sm text-muted">
    <p>
      &copy; {year} {siteConfig.author.name}. All rights reserved.
    </p>
    <a href="#content" class="inline-flex items-center gap-1.5 hover:text-ink">
      Back to top
      <Icon name="arrow-up" class="size-3.5" />
    </a>
  </div>
</footer>

<style>
  .footer-link {
    color: var(--ink);
    transition: color 160ms ease;
  }

  .footer-link:hover {
    color: var(--muted);
  }

  .closing-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.09) 1px, transparent 0);
    background-size: 24px 24px;
    mask-image: radial-gradient(ellipse 70% 90% at 100% 100%, #000 10%, transparent 70%);
  }

  .closing-title {
    font-size: clamp(2rem, 1rem + 3.6vw, 3.5rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -2.72px;
    text-wrap: balance;
  }
</style>
