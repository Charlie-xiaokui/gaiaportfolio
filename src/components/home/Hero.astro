---
import Icon from '@/components/ui/Icon.astro';
import { hero } from '@/config/home';
---

<section class="shell pt-14 pb-20 sm:pt-20 sm:pb-28 lg:pt-24" aria-labelledby="hero-title">
  <p class="rise eyebrow">introduction</p>

  <h1 id="hero-title" class="rise mt-8 max-w-[17ch] text-display" style="--rise-step: 1">
    {hero.greeting} {hero.title} <span class="serif">{hero.highlight}</span>
  </h1>

  <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
    <div class="rise" style="--rise-step: 2">
      <p class="max-w-xl text-lead text-body">{hero.text}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={hero.secondary.href}>
          {hero.secondary.label}
          <Icon name="arrow-right" class="icon-nudge size-4" />
        </a>
      </div>
    </div>

    <dl
      class="rise grid grid-cols-3 gap-6 border-t border-line pt-6 sm:gap-10 lg:border-t-0 lg:pt-0"
      style="--rise-step: 3"
    >
      {hero.facts.map((fact) => (
        <div class="flex flex-col-reverse gap-1">
          <dt class="max-w-[13ch] text-sm leading-snug text-muted">{fact.label}</dt>
          <dd class="text-section">{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

