---
interface Props {
  before: { src: string; alt: string };
  after: { src: string; alt: string };
  width: number;
  height: number;
  initialSplit?: number;
}

const { before, after, width, height, initialSplit = 50 } = Astro.props;
const split = Math.round(Math.min(100, Math.max(0, initialSplit)));
---

<image-comparison style={`--split: ${split}%; aspect-ratio: ${width} / ${height}`}>
  <img class="before" src={before.src} alt={before.alt} {width} {height} draggable="false" />
  <img class="after" src={after.src} alt={after.alt} {width} {height} draggable="false" />
  <span class="handle" aria-hidden="true"></span>
  <input type="range" min="0" max="100" value={split} aria-label="调整 Before 与 After 的分割位置" />
</image-comparison>

<style>
  image-comparison {
    display: block;
    position: relative;
    isolation: isolate;
    width: 100%;
    overflow: hidden;
    border-radius: 16px;
    background: conic-gradient(#eee 25%, white 0 50%, #eee 0 75%, white 0) 0 0 / 16px 16px;
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
  }

  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
  }

  .before {
    clip-path: inset(0 calc(100% - var(--split)) 0 0);
  }

  .after {
    clip-path: inset(0 0 0 var(--split));
  }

  .handle {
    position: absolute;
    top: 50%;
    left: clamp(22px, var(--split), calc(100% - 22px));
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 44px;
    height: 44px;
    translate: -50% -50%;
    border-radius: 50%;
    background: #fff;
    color: #121211;
    box-shadow: 0 2px 12px #12121130;
    pointer-events: none;
  }

  .handle::before,
  .handle::after {
    content: '';
    width: 7px;
    height: 7px;
    border-top: 2px solid;
    border-right: 2px solid;
    rotate: -135deg;
  }

  .handle::after {
    rotate: 45deg;
  }

  input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
  }

  image-comparison:has(input:focus-visible) .handle {
    outline: 2px solid #121211;
    outline-offset: -4px;
  }
</style>

<script>
  class ImageComparison extends HTMLElement {
    connectedCallback() {
      const input = this.querySelector('input');
      if (!input) return;

      input.oninput = () => this.style.setProperty('--split', `${input.value}%`);
      input.oninput(new Event('input'));

      const updateSplit = (event: PointerEvent) => {
        const bounds = this.getBoundingClientRect();
        const percentage = ((event.clientX - bounds.left) / bounds.width) * 100;
        input.valueAsNumber = Math.round(Math.min(100, Math.max(0, percentage)));
        input.dispatchEvent(new Event('input', { bubbles: true }));
      };

      this.onpointerdown = (event) => {
        if (!event.isPrimary || event.button !== 0) return;
        event.preventDefault();
        input.focus({ preventScroll: true });
        this.setPointerCapture(event.pointerId);
        updateSplit(event);
      };

      this.onpointermove = (event) => {
        if (this.hasPointerCapture(event.pointerId)) updateSplit(event);
      };
    }
  }

  if (!customElements.get('image-comparison')) {
    customElements.define('image-comparison', ImageComparison);
  }
</script>
