---
interface Props {
  before: { src: string; alt: string };
  after: { src: string; alt: string };
  width: number;
  height: number;
  initialSplit?: number;
}

const { before, after, width, height, initialSplit = 50 } = Astro.props;
const split = Math.round(Math.min(100, Math.max(0, initialSplit)));
---

<image-comparison style={`--split: ${split}%; aspect-ratio: ${width} / ${height}`}>
  <img class="before" src={before.src} alt={before.alt} {width} {height} draggable="false" />
  <img class="after" src={after.src} alt={after.alt} {width} {height} draggable="false" />
  <span class="handle" aria-hidden="true"></span>
  <input type="range" min="0" max="100" value={split} aria-label="调整 Before 与 After 的分割位置" />
</image-comparison>

<style>
  image-comparison {
    display: block;
    position: relative;
    isolation: isolate;
    width: 100%;
    overflow: hidden;
    border-radius: 16px;
    background: conic-gradient(#eee 25%, white 0 50%, #eee 0 75%, white 0) 0 0 / 16px 16px;
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
  }

  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
  }

  .before {
    clip-path: inset(0 calc(100% - var(--split)) 0 0);
  }

  .after {
    clip-path: inset(0 0 0 var(--split));
  }

  image-comparison::after {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 0;
    z-index: 1;
    width: var(--split);
    box-shadow: 4px 0 20px 0 rgb(91 84 106 / 15%);
    clip-path: inset(0 calc(0px - min(24px, var(--split))) 0 100%);
    pointer-events: none;
  }

  .handle {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: clamp(22px, var(--split), calc(100% - 22px));
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 44px;
    height: 44px;
    translate: -50% -50%;
    border-radius: 50%;
    background: #fff;
    color: #121211;
    box-shadow: 0 2px 12px #12121130;
    pointer-events: none;
  }

  .handle::before,
  .handle::after {
    content: '';
    width: 7px;
    height: 7px;
    border-top: 2px solid;
    border-right: 2px solid;
    rotate: -135deg;
  }

  .handle::after {
    rotate: 45deg;
  }

  input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
  }

  image-comparison:has(input:focus-visible) .handle {
    outline: 2px solid #121211;
    outline-offset: -4px;
  }
</style>

<script>
  const autoMin = 35;
  const autoMax = 65;
  const autoSpeed = (autoMax - autoMin) / 10_000;
  const resumeDelay = 5_000;

  class ImageComparison extends HTMLElement {
    private dispose?: () => void;

    connectedCallback() {
      const input = this.querySelector('input');
      if (!input) return;

      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      const listeners = new AbortController();
      let position = input.valueAsNumber;
      let direction = 1;
      let frame = 0;
      let resumeTimer: number | undefined;
      let lastTime: number | undefined;
      let activePointer: number | undefined;

      const render = () => {
        this.style.setProperty('--split', `${position}%`);
        input.valueAsNumber = Math.round(position);
      };

      const animate = (time: number) => {
        const elapsed = lastTime === undefined ? 0 : Math.min(time - lastTime, 100);
        lastTime = time;
        position += direction * elapsed * autoSpeed;

        if (direction > 0 && position >= autoMax) {
          position = 2 * autoMax - position;
          direction = -1;
        } else if (direction < 0 && position <= autoMin) {
          position = 2 * autoMin - position;
          direction = 1;
        }

        render();
        frame = requestAnimationFrame(animate);
      };

      const stop = () => {
        cancelAnimationFrame(frame);
        frame = 0;
        lastTime = undefined;
      };

      const start = () => {
        if (motion.matches || frame || resumeTimer !== undefined || activePointer !== undefined) return;
        if (position <= autoMin) direction = 1;
        if (position >= autoMax) direction = -1;
        frame = requestAnimationFrame(animate);
      };

      const pause = () => {
        stop();
        clearTimeout(resumeTimer);
        resumeTimer = undefined;
      };

      const resumeAfterDelay = () => {
        pause();
        resumeTimer = window.setTimeout(() => {
          resumeTimer = undefined;
          start();
        }, resumeDelay);
      };

      input.addEventListener(
        'input',
        () => {
          position = input.valueAsNumber;
          render();
          if (activePointer === undefined) resumeAfterDelay();
        },
        { signal: listeners.signal },
      );

      motion.addEventListener(
        'change',
        () => {
          if (motion.matches) stop();
          else start();
        },
        { signal: listeners.signal },
      );

      const updateSplit = (event: PointerEvent) => {
        const bounds = this.getBoundingClientRect();
        const percentage = ((event.clientX - bounds.left) / bounds.width) * 100;
        input.valueAsNumber = Math.round(Math.min(100, Math.max(0, percentage)));
        input.dispatchEvent(new Event('input', { bubbles: true }));
      };

      this.onpointerdown = (event) => {
        if (!event.isPrimary || event.button !== 0 || activePointer !== undefined) return;
        activePointer = event.pointerId;
        pause();
        event.preventDefault();
        input.focus({ preventScroll: true });
        this.setPointerCapture(event.pointerId);
        updateSplit(event);
      };

      this.onpointermove = (event) => {
        if (event.pointerId === activePointer && this.hasPointerCapture(event.pointerId)) updateSplit(event);
      };

      this.onlostpointercapture = (event) => {
        if (event.pointerId !== activePointer) return;
        activePointer = undefined;
        resumeAfterDelay();
      };

      this.dispose = () => {
        listeners.abort();
        pause();
        this.onpointerdown = null;
        this.onpointermove = null;
        this.onlostpointercapture = null;
      };

      render();
      start();
    }

    disconnectedCallback() {
      this.dispose?.();
    }
  }

  if (!customElements.get('image-comparison')) {
    customElements.define('image-comparison', ImageComparison);
  }
</script>
