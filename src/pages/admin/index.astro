---
import '@/styles/global.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>管理后台 · Guanyu Dai</title>
  </head>
  <body>
    <div class="admin-shell">
      <aside>
        <a class="brand" href="/admin/">
          Guanyu Dai <span>管理后台</span>
        </a>
        <nav aria-label="管理导航">
          <a href="/admin/" aria-current="page">
            访问统计
          </a>
        </nav>
        <a href="/" class="site-link">
          打开作品集 ↗
        </a>
      </aside>
      <main>
        <header>
          <div>
            <p class="eyebrow">作品集管理</p>
            <h1>访问统计</h1>
          </div>
          <button id="logout" hidden>
            退出登录
          </button>
        </header>
        <p id="status" role="status" aria-live="polite">
          正在检查登录状态…
        </p>
        <section id="login" hidden>
          <h2>管理员登录</h2>
          <p>使用管理员密码查看访问记录。</p>
          <form id="login-form">
            <label for="password">管理员密码</label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              maxlength="256"
            />
            <button type="submit">登录</button>
          </form>
        </section>
        <section id="dashboard" hidden>
          <div class="toolbar">
            <label for="range">时间范围</label>
            <select id="range">
              <option value="1">最近 24 小时</option>
              <option value="7" selected>
                最近 7 天
              </option>
              <option value="30">最近 30 天</option>
            </select>
            <button id="refresh">刷新</button>
            <span id="updated"></span>
          </div>
          <div class="metrics">
            <div>
              <span>活跃会话 · 最近 5 分钟</span>
              <strong id="active">—</strong>
            </div>
            <div>
              <span>访问会话</span>
              <strong id="sessions">—</strong>
            </div>
            <div>
              <span>页面浏览量</span>
              <strong id="views">—</strong>
            </div>
          </div>
          <h2>最近访问</h2>
          <p class="hint">
            每行是一段浏览会话对一个页面的访问，最多显示最近 200 条。系统和浏览器为推断信息，地点为 IP 所在地区。
          </p>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>最近活动</th>
                  <th>会话</th>
                  <th>设备</th>
                  <th>地区</th>
                  <th>页面</th>
                  <th>浏览次数</th>
                </tr>
              </thead>
              <tbody id="visits"></tbody>
            </table>
          </div>
          <p class="hint">
            仅记录同意访问统计的访客，忽略已登录管理员及常见机器人。会话使用当前标签页中的随机编号，记录保留约 30
            天。打开此页时每分钟刷新。
          </p>
        </section>
      </main>
    </div>
    <script>
      const login = document.querySelector<HTMLElement>('#login')!;
      const dashboard = document.querySelector<HTMLElement>('#dashboard')!;
      const status = document.querySelector<HTMLElement>('#status')!;
      const logout = document.querySelector<HTMLButtonElement>('#logout')!;
      const range = document.querySelector<HTMLSelectElement>('#range')!;
      const form = document.querySelector<HTMLFormElement>('#login-form')!;
      let loading = false;
      const number = new Intl.NumberFormat('zh-CN');
      const date = new Intl.DateTimeFormat('zh-CN', {
        dateStyle: 'short',
        timeStyle: 'short',
        timeZone: 'Asia/Singapore',
      });
      function signedOut() {
        login.hidden = false;
        dashboard.hidden = true;
        logout.hidden = true;
        document.querySelector('#visits')!.replaceChildren();
        for (const id of ['active', 'sessions', 'views']) document.getElementById(id)!.textContent = '—';
      }
      async function report() {
        if (loading) return;
        loading = true;
        status.textContent = '正在读取访问记录…';
        try {
          const response = await fetch('/api/analytics?days=' + range.value, { cache: 'no-store' });
          const data = await response.json();
          if (response.status === 401) {
            signedOut();
            status.textContent = '请登录后查看访问记录。';
            return;
          }
          if (!response.ok) throw new Error(data.error || '读取记录失败');
          for (const key of ['active', 'sessions', 'views'])
            document.getElementById(key)!.textContent = number.format(data[key]);
          const rows = data.rows as Array<{
            session_id: string;
            last_seen: string;
            device: string;
            os: string;
            browser: string;
            country: string;
            city: string;
            path: string;
            views: number;
          }>;
          const body = document.querySelector('#visits')!;
          body.replaceChildren();
          for (const row of rows) {
            const tr = document.createElement('tr');
            for (const value of [
              date.format(new Date(row.last_seen)),
              row.session_id.slice(0, 8),
              [row.device, row.os, row.browser].join(' · '),
              [row.country, row.city].filter(Boolean).join(' · ') || '未知',
              row.path,
              number.format(row.views),
            ]) {
              const td = document.createElement('td');
              td.textContent = value;
              tr.append(td);
            }
            body.append(tr);
          }
          if (!rows.length) {
            const td = document.createElement('td');
            td.colSpan = 6;
            td.textContent = '这个时间范围内还没有访问记录。';
            const tr = document.createElement('tr');
            tr.append(td);
            body.append(tr);
          }
          login.hidden = true;
          dashboard.hidden = false;
          logout.hidden = false;
          status.textContent = '';
          document.querySelector('#updated')!.textContent = '更新时间 ' + date.format(new Date()) + '（新加坡时间）';
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : '读取失败，请重试。';
        } finally {
          loading = false;
        }
      }
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const submit = form.querySelector('button')!;
        submit.disabled = true;
        try {
          const input = document.querySelector<HTMLInputElement>('#password')!;
          const response = await fetch('/api/admin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password: input.value }),
          });
          input.value = '';
          const data = await response.json();
          if (!response.ok) throw new Error(data.error);
          await report();
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : '登录失败';
        } finally {
          submit.disabled = false;
        }
      });
      logout.addEventListener('click', async () => {
        try {
          const response = await fetch('/api/admin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'logout' }),
          });
          if (!response.ok) throw new Error();
          signedOut();
          status.textContent = '已退出登录。';
        } catch {
          status.textContent = '退出失败，请重试。';
        }
      });
      range.addEventListener('change', () => void report());
      document.querySelector('#refresh')!.addEventListener('click', () => void report());
      async function initialize() {
        try {
          const response = await fetch('/api/admin', { cache: 'no-store' });
          const data = await response.json();
          if (response.ok) await report();
          else {
            signedOut();
            status.textContent = response.status === 401 ? '' : data.error;
          }
        } catch {
          signedOut();
          status.textContent = '无法连接后台服务，请稍后重试。';
        }
      }
      void initialize();
      setInterval(() => {
        if (!dashboard.hidden && document.visibilityState === 'visible') void report();
      }, 60000);
    </script>
  </body>
</html>
<style>
  body {
    margin: 0;
    background: #fafaf7;
    color: #171716;
    font-family: 'Hanken Grotesk', 'PingFang SC', sans-serif;
  }
  [hidden] {
    display: none !important;
  }
  .admin-shell {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
  }
  aside {
    display: flex;
    flex-direction: column;
    padding: 32px 24px;
    border-right: 1px solid #e3e3dc;
  }
  .brand {
    font-size: 20px;
    font-weight: 600;
    text-decoration: none;
  }
  .brand span {
    display: block;
    margin-top: 8px;
    color: #74746b;
    font-size: 14px;
    font-weight: 400;
  }
  nav {
    margin-top: 48px;
  }
  nav a {
    display: block;
    padding: 12px;
    border-radius: 10px;
    background: #d4f84a;
    color: #171716;
    text-decoration: none;
  }
  .site-link {
    margin-top: auto;
    padding-top: 40px;
    color: #626258;
  }
  main {
    max-width: 1400px;
    width: 100%;
    padding: 48px;
  }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }
  h1 {
    margin: 8px 0;
    font-size: 34px;
    font-weight: 500;
  }
  h2 {
    font-size: 20px;
    font-weight: 500;
    margin: 28px 0 12px;
  }
  .eyebrow,
  .hint {
    color: #74746b;
    font-size: 14px;
  }
  .hint {
    line-height: 1.7;
    margin-bottom: 16px;
  }
  #status {
    margin-bottom: 16px;
    font-size: 15px;
  }
  #status:empty {
    display: none;
  }
  #login {
    max-width: 440px;
    border: 1px solid #e3e3dc;
    padding: 28px;
    border-radius: 18px;
    background: white;
  }
  #login p {
    margin: 12px 0 24px;
    color: #74746b;
  }
  form {
    display: grid;
    gap: 12px;
  }
  input,
  select,
  button {
    border: 1px solid #d8d8d0;
    border-radius: 8px;
    padding: 10px 14px;
    font: inherit;
    background: white;
  }
  button {
    cursor: pointer;
  }
  button[type='submit'] {
    background: #d4f84a;
    border-color: #d4f84a;
  }
  button:disabled {
    opacity: 0.5;
    cursor: wait;
  }
  :is(a, button, input, select):focus-visible {
    outline: 2px solid #477513;
    outline-offset: 3px;
  }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-bottom: 24px;
  }
  #updated {
    font-size: 13px;
    color: #74746b;
    margin-left: auto;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .metrics > div {
    display: grid;
    gap: 16px;
    padding: 24px;
    background: white;
    border: 1px solid #e3e3dc;
    border-radius: 16px;
  }
  .metrics span {
    font-size: 14px;
    color: #626258;
  }
  .metrics strong {
    font-size: 36px;
    font-weight: 500;
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid #e3e3dc;
    border-radius: 14px;
    background: white;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  th,
  td {
    padding: 16px;
    border-bottom: 1px solid #e3e3dc;
    text-align: left;
    vertical-align: top;
  }
  th {
    white-space: nowrap;
    font-weight: 500;
    background: #f3f3ed;
  }
  td {
    overflow-wrap: anywhere;
    min-width: 90px;
  }
  @media (max-width: 850px) {
    .admin-shell {
      grid-template-columns: 1fr;
    }
    aside {
      padding: 20px;
      border-right: 0;
      border-bottom: 1px solid #e3e3dc;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 24px;
    }
    nav {
      margin: 0;
    }
    .site-link {
      margin: 0 0 0 auto;
      padding: 0;
    }
    main {
      padding: 24px 16px;
    }
    .metrics {
      grid-template-columns: 1fr;
    }
    .metrics > div {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
