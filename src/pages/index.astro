---
import { caseStudyCopy } from '@/config/case-studies';
import Icon from '@/components/ui/Icon.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
const detail = '/work/nextpoint/';
const cases = [
  { ...caseStudyCopy.aily, href: '/work/aily/', tags: ['Agent skill/mcp/plugin', '信息架构重构', '复杂体验配置'], color: '#FFE7D8', image: '/work-covers/aily.png' },
  { ...caseStudyCopy.miaoda, href: '/work/miaoda/', tags: ['AI 应用开发平台', '产品整合与渐进式体验'], color: '#DCD3FB', image: '/work-covers/miaoda.png' },
  { ...caseStudyCopy.laike, href: '/work/laike/', tags: ['APP 设计', '复杂产品视图拆分'], color: '#D2EBFF', image: '/work-covers/laike.png' },
  { ...caseStudyCopy.dashboard, href: '/work/dashboard/', tags: ['数据报表设计', '设计驱动业务增长'], color: '#FCE0E0', image: '/work-covers/dashboard.png' },
  { ...caseStudyCopy.qibao, href: '/work/qibao/', tags: ['多端服务设计', '流程重构与信任体系'], color: '#C0E9F7', image: '/work-covers/qibao.png' },
  { ...caseStudyCopy.viz, href: '/work/viz/', tags: ['WEB 设计', '生产力工具产品重构'], color: '#CCF1E3', image: '/work-covers/viz.png' },
];
const explorations = [
  { title: 'Demo 演示', icon: 'lightbulb' }, { title: 'Figma 插件', icon: 'workflow' },
  { title: '可复用资产', icon: 'layers' }, { title: '边界场景设计', icon: 'pen-tool' },
] as const;
---
<BaseLayout closing={false}>
  <header class="shell grid items-end gap-12 pt-16 pb-20 sm:pt-24 sm:pb-28 lg:grid-cols-[minmax(0,1fr)_352px] lg:gap-16">
    <div class="flex flex-col items-start gap-12 [font-synthesis:none] antialiased">
      <div class="flex flex-col items-start gap-10">
        <p class="rise eyebrow leading-[160%]">introduction</p>
        <h1 class="rise intro-title text-balance" style="--rise-step: 1"><span>你好,我叫</span>戴冠宇</h1>
        <ul class="rise flex flex-wrap gap-3" aria-label="专业与经历" style="--rise-step: 2">
          {['Agent 平台设计', 'B端UX设计', '自学SQL和系统分析师', '工作 10 年'].map((label) => (
            <li class="flex min-h-7 items-center rounded-full border border-line px-[11.2px] py-[3.2px] text-[13px] font-medium leading-[120%] text-body">{label}</li>
          ))}
        </ul>
      </div>
      <div class="rise mt-8" style="--rise-step: 3">
        <a class="btn btn-primary" href="/resume/">关于我 <Icon name="arrow-right" class="icon-nudge size-4" /></a>
      </div>
    </div>
    <div class="rise relative overflow-hidden rounded-3xl" style="--rise-step: 3">
      <img src="/gaia-portrait.jpg" alt="戴冠宇手持麦克风的照片" class="aspect-[4/5] w-full object-cover" />
      <span class="absolute bottom-4 left-4 flex items-center gap-2 rounded-full bg-white/90 px-3.5 py-1.5 text-sm font-medium text-[#121211]"><Icon name="map-pin" class="size-3.5" /> Hangzhou, Zhejiang</span>
    </div>
  </header>
  <section id="work" class="shell" aria-labelledby="work-title">
    <div class="reveal [font-synthesis:none] antialiased">
      <p class="eyebrow leading-[160%]">Selected work</p>
      <h2 id="work-title" class="mt-4 text-balance text-[48px] font-medium leading-[106%] tracking-[5px] text-ink">作品案例</h2>
      <p class="work-intro mt-5 text-pretty text-base leading-[155%] text-muted">以下是我在职期间的一些工作产出，包括B端、C端、WEB端等</p>
    </div>
    <div class="mt-12 grid gap-x-8 gap-y-16 md:grid-cols-2">
      {cases.map((item) => <article class="case-card reveal relative">
        <div class="relative aspect-5/4 overflow-hidden rounded-card" style={`background-color:${item.color}`}>
          <img src={item.image} alt={item.title} class="case-cover-image absolute inset-0 size-full object-cover" loading="lazy" />
          <span class="case-arrow absolute top-5 right-5 grid size-11 place-items-center rounded-full bg-inverse text-on-inverse" aria-hidden="true"><Icon name="arrow-up-right" class="size-5" /></span>
        </div>
        <div class="mt-6"><h3 class="text-title"><a href={item.href ?? detail} class="after:absolute after:inset-0">{item.title}</a></h3><p class="mt-1.5 text-sm leading-7 text-muted">{item.description}</p><ul class="mt-5 flex flex-wrap gap-2" aria-label="项目标签">{item.tags.map((tag) => <li class="chip">{tag}</li>)}</ul></div>
      </article>)}
    </div>
  </section>
  <section class="shell mt-24 sm:mt-32" aria-labelledby="explore-title">
    <SectionHead id="explore-title" eyebrow="explore" title="AI 设计工作流探索" />
    <div class="mt-12 grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {explorations.map((item) => <article class="explore-card reveal flex flex-col bg-surface p-8">
        <span class="grid size-11 place-items-center rounded-xl bg-accent text-night"><Icon name={item.icon} class="size-5" /></span>
        <div class="mt-10 min-h-30"><h3 class="text-title">{item.title}</h3><p class="mt-3 text-[15px] leading-6 text-muted">用于前期探索方案演示，让用户、产品研发对设计方案有实际感受</p></div>
        <a href={detail} class="explore-more mt-4 inline-flex w-fit items-center gap-1.5 text-[17px]" aria-label={`查看更多：${item.title}`}>更多 <Icon name="arrow-right" class="icon-nudge size-5" /></a>
      </article>)}
    </div>
  </section>
</BaseLayout>
<style>
  .intro-title { font-family: 'PingFang SC', system-ui, sans-serif; font-size: clamp(2.5rem, 5.42vw, 78px); font-weight: 500; letter-spacing: clamp(4px, .56vw, 8px); line-height: 1.02; }
  .intro-title span { font-weight: 200; }
  .work-intro { font-family: 'PingFang SC', system-ui, sans-serif; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .case-cover-image { transition: transform 950ms cubic-bezier(.16, 1, .3, 1); }
    .case-card:hover .case-cover-image { transform: scale(1.1); }
  }
  .case-arrow { z-index: 3; opacity: 0; scale: .6; transition: opacity 250ms ease, scale 450ms var(--ease-out-expo); }
  .case-card:hover .case-arrow, .case-card:has(a:focus-visible) .case-arrow { opacity: 1; scale: 1; }
  .case-card:has(a:focus-visible) { outline: 2px solid var(--ink); outline-offset: 8px; border-radius: var(--radius-card); }
  .explore-more { opacity: 0; transition: opacity 200ms ease; }
  .explore-card:hover .explore-more, .explore-card:focus-within .explore-more { opacity: 1; }
  @media (hover: none) { .explore-more { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .case-arrow, .explore-more { transition: none !important; } }
</style>
