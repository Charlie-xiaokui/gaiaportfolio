---
import '@/styles/case-unified.css';
import BaseLayout from '@/layouts/BaseLayout.astro';
const sections = [
 { id:'decision', label:'01 / 成员 · 选择能力', title:'先回答“能帮我做什么”，再谈如何维护。', problem:'技能详情曾同时承载介绍、评测、版本、文件更新、可见范围和删除。只是来判断技能是否合适的成员，被迫面对一整套资产管理逻辑。', strategy:'将详情拆为安装前了解与试用、安装后资产管理两种场景。市场回答是什么、是否可信、怎么试；对话承接怎么用；管理面板负责维护与治理。', value:'同一个技能，在市场是待选择的能力，在对话是可调用的方法，在后台才是需要维护的资产。', images:['市场/技能详情 安装前.png','市场/技能详情 安装后.png','技能管理弹窗01.png','技能管理弹窗02.png'] },
 { id:'authorize', label:'02 / 成员 · 开始使用', title:'先获得能力，在任务需要时再授权。', problem:'还没感知技能价值，就要求填写 API Key，用户需要先承担配置成本，也难以理解授权的对象和目的。', strategy:'把安装与授权拆开：安装决定伙伴具备什么能力，授权决定这次允许访问哪个系统。当用户提出“查我的 GitHub 仓库”时，再解释为什么需要连接 GitHub。', value:'把空白表单里的系统配置，变成具体任务中的一次确认，让授权对象、目的与收益同时可见。', images:['技能安装01.png','技能安装02.png','技能安装03.png','授权01.png','授权02.png','授权03.png'] },
 { id:'ownership', label:'03 / 成员 · 能力归属', title:'装给谁、在哪管、何时用，都有明确落点。', problem:'多 Agent 平台里的能力并非装上就全局生效。一次安装需要选择一个或多个伙伴，否则用户难以建立每位伙伴能做什么的预期。', strategy:'安装时明确伙伴选择；伙伴详情的能力页集中展示技能、连接器和开关；对话里通过 /、+ 等显式入口查看或指定能力，与自动调用共同工作。', value:'增加一次有意义的选择，换来伙伴级能力边界的可见与可控。', images:['安装时提供明确的能力落点01.png','安装时提供明确的能力落点02.png','把能力边界转化为可理解的信息.png','对话中保留显式控制，降低多伙伴场景下的能力管理困惑.png'] },
 { id:'configure', label:'04 / 管理员 · 接入能力', title:'复杂现实要覆盖，复杂字段不必同时出现。', problem:'MCP、CLI、API Key、OAuth、传输类型、参数与 token 映射共同构成企业接入的真实复杂度。过度简化会让非标准系统无法配通。', strategy:'按基础信息 → 配置连接器 → 关联技能分三步；随连接器、认证与传输选择动态展开字段；提供员工授权界面的实时预览，并支持管理员预先配置授权。', value:'首期可以接受效率仍待优化，但接入路径必须闭环。控制力来自完整能力与清晰反馈，而非所有字段同时可见。', images:['配置表单：先覆盖复杂现实，再通过分层降低认知负担01.png','配置表单：先覆盖复杂现实，再通过分层降低认知负担02.png','配置表单：先覆盖复杂现实，再通过分层降低认知负担03.png'] },
 { id:'govern', label:'05 / 管理员 · 持续治理', title:'从“编辑配置项”，走向“判断该向谁开放”。', problem:'只有新建、编辑、删除，无法回答谁能用、凭证是否配好、谁已安装，以及出问题后如何止损。', strategy:'让列表同时呈现名称与描述、来源、可用范围、预授权和启用状态，并就近提供配置范围、配置凭证、详情与启停操作。', value:'预授权状态把后台技术动作翻译成业务结果：管理员配好凭证后，指定范围的员工可以直接使用，将重复且高门槛的配置集中处理。', images:['借助功能列表让管理员围绕范围、凭证、启停状态做决策和治理动作.png'] },
];
const asset = (name: string) => '/aily-case/' + name.split('/').map(encodeURIComponent).join('/');
---
<BaseLayout title="Aily 工作伙伴能力接入与管理体验设计" description="让普通成员敢装、会用，让管理员能配、敢管。" closing={false}>
<article class="aily-case shell">
 <header><nav><a href="/">作品案例</a> / Aily 工作伙伴能力接入与管理</nav><p class="label">企业级多 Agent 平台 / 能力接入与治理</p><h1>从“能聊天”，<br />到真正能完成工作。</h1><p class="lead">连接外部系统只是第一步。更难的是，让普通成员知道如何获得能力，让企业知道如何管理能力。</p><dl><div><dt>项目</dt><dd>Aily 工作伙伴能力接入与管理体验设计</dd></div><div><dt>核心命题</dt><dd>成员敢装、会用；管理员能配、敢管</dd></div><div><dt>设计边界</dt><dd>市场、伙伴、对话与企业后台的完整接入体验</dd></div></dl></header>
 <section class="context"><h2>技术概念很多，用户的判断其实很具体。</h2><p>工作伙伴要完成任务，需要连接外部系统；企业也开始要求管控能力，而既有管理体系并不统一。连接器、技能、技能包、MCP、CLI 和认证方式不断叠加，成员却只想知道：它能不能帮我完成眼前这件事？</p><div class="role-switch" role="group" aria-label="切换角色视角"><button aria-pressed="true" data-role="member">我是普通成员</button><button aria-pressed="false" data-role="admin">我是管理员</button></div><div class="role-message" aria-live="polite">“这个能力能解决我的问题吗？安装后在哪里用？”</div><p class="role-note">同一套能力体系，需要以两种不同的信息密度呈现。</p></section>
 <nav class="chapter-nav" aria-label="案例章节">{sections.map(s=><a href={`#${s.id}`}>{s.label.split(' / ')[1]}</a>)}</nav>
 {sections.map(s=><section class="chapter" id={s.id}><p class="label">{s.label}</p><h2>{s.title}</h2><div class="reason"><div><h3>设计挑战</h3><p>{s.problem}</p></div><div><h3>设计取舍</h3><p>{s.strategy}</p></div></div><div class="gallery" data-gallery><div class="gallery-toolbar"><span>方案原稿 · 点击图片放大</span><div>{s.images.map((_,i)=><button type="button" aria-label={`查看第 ${i+1} 张方案`} aria-pressed={i===0?'true':'false'} data-slide={i}>{String(i+1).padStart(2,'0')}</button>)}</div></div>{s.images.map((name,i)=><figure hidden={i!==0}><button class="image-open" data-image={asset(name)} aria-label="放大查看方案原稿"><img src={asset(name)} alt={name.replace('.png','')} loading="lazy" /></button><figcaption>{name.replace('.png','').split('/').pop()}</figcaption></figure>)}</div><p class="takeaway">{s.value}</p></section>)}
 <section class="future"><p class="label">后续优化方向</p><h2>让能力接入从手动配置，逐渐走向主动引导。</h2><details><summary>01 · 基于伙伴类型推荐添加</summary><p>结合伙伴角色、已有能力和当前任务推荐安装目标；从伙伴详情进入时默认当前伙伴，减少重复选择。</p></details><details><summary>02 · 模板化能力组合</summary><p>为高频伙伴预置推荐组合，同时保留授权确认和启停控制，让初始能力完整、边界清晰。</p></details><details><summary>03 · 配置中校验与引导</summary><p>通过模板、文件识别、自动填充、连接测试和错误定位，降低非标准系统的接入成本。</p></details></section>
 <footer class="closing"><p>设计的价值，是把技术复杂度转成清晰的选择。</p><a href="/">返回作品集 ↗</a></footer>
</article>
<dialog class="image-dialog"><button class="close-viewer" autofocus>关闭 ×</button><img src={asset('市场/技能详情 安装前.png')} alt="方案原稿放大预览" /></dialog>
</BaseLayout>
<script>
document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(g=>{const buttons=g.querySelectorAll<HTMLButtonElement>('[data-slide]');const figures=g.querySelectorAll('figure');buttons.forEach((b,i)=>b.addEventListener('click',()=>{buttons.forEach((x,j)=>x.setAttribute('aria-pressed',String(i===j)));figures.forEach((f,j)=>f.hidden=i!==j)}))});
const message=document.querySelector('.role-message');document.querySelectorAll<HTMLButtonElement>('[data-role]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-role]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));if(message)message.textContent=b.dataset.role==='admin'?'“谁能用？凭证配好了吗？出问题时能不能先停用？”':'“这个能力能解决我的问题吗？安装后在哪里用？”'}));
const viewer=document.querySelector<HTMLDialogElement>('.image-dialog');document.querySelectorAll<HTMLButtonElement>('[data-image]').forEach(b=>b.addEventListener('click',()=>{if(!viewer)return;viewer.querySelector('img')!.src=b.dataset.image!;viewer.showModal()}));viewer?.querySelector('button')?.addEventListener('click',()=>viewer.close());viewer?.addEventListener('click',e=>{if(e.target===viewer)viewer.close()});
</script>
<style>
.aily-case{font-family:'PingFang SC',sans-serif;padding-bottom:80px}header{padding:48px 40px 0}nav{font-size:14px;color:var(--muted)}.label{font-size:13px;color:var(--muted);letter-spacing:.06em;margin-bottom:24px}header .label{margin-top:72px}h1{font-size:clamp(40px,5vw,68px);line-height:1.15;letter-spacing:-.035em}.lead{font-size:22px;line-height:1.8;max-width:780px;margin-top:32px;color:var(--body)}dl{display:grid;grid-template-columns:1fr 1fr 1fr;gap:40px;border-block:1px solid var(--line);padding-block:32px;margin-top:64px}dt{font-size:13px;color:var(--muted)}dd{margin-top:8px;line-height:1.8}h2{font-size:clamp(28px,3.4vw,48px);line-height:1.3;letter-spacing:-.025em;max-width:900px}.context,.chapter,.future{margin-top:140px;scroll-margin-top:110px}.context{padding:64px;background:var(--night);color:var(--night-ink);border-radius:24px}.context>p{max-width:800px;line-height:1.9;margin-top:28px}.role-switch{display:flex;flex-wrap:wrap;gap:12px;margin-top:40px}button{cursor:pointer}.role-switch button,.gallery-toolbar button{padding:10px 18px;border:1px solid var(--line-strong);border-radius:999px;font-size:14px}.role-switch button[aria-pressed=true],.gallery-toolbar button[aria-pressed=true]{background:var(--accent);color:#121211;border-color:var(--accent)}.role-message{font-size:clamp(21px,2.5vw,32px);line-height:1.6;margin-top:32px;min-height:3.2em}.role-note{color:var(--night-muted);font-size:14px}.chapter-nav{display:flex;flex-wrap:wrap;gap:12px 28px;margin-top:48px;padding:24px 0;border-bottom:1px solid var(--line)}.chapter-nav a:hover{text-decoration:underline}.chapter>h2,.chapter>.label{margin-left:40px}.reason{display:grid;grid-template-columns:1fr 1fr;gap:64px;margin:40px}.reason h3{font-size:16px;margin-bottom:16px}.reason p,.future p{font-size:17px;line-height:1.9;color:var(--body)}.gallery{background:var(--sunken);border-radius:24px;padding:24px;margin-top:48px}.gallery-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:24px}.gallery-toolbar span{font-size:13px;color:var(--muted)}.gallery-toolbar>div{display:flex;gap:6px;flex-wrap:wrap}.gallery-toolbar button{padding:6px 12px}.image-open{width:100%;display:block}.image-open img{width:100%;height:auto;max-height:760px;object-fit:contain;display:block}.gallery figcaption{font-size:13px;color:var(--muted);text-align:center;margin-top:16px}.takeaway{margin:32px 40px 0;max-width:850px;font-size:20px;line-height:1.8}.future{padding-inline:40px}.future details{border-bottom:1px solid var(--line);padding:24px 0}.future summary{cursor:pointer;font-size:20px}.future details p{margin-top:20px;max-width:800px}.closing{margin:120px 40px 0;border-top:1px solid var(--line);padding-top:48px}.closing p{font-size:28px;margin-bottom:32px}.image-dialog{max-width:96vw;max-height:94vh;padding:48px 16px 16px;background:var(--surface);border:0;border-radius:16px;margin:auto}.image-dialog::backdrop{background:#000b}.image-dialog img{max-width:90vw;height:auto}.close-viewer{position:sticky;top:0;display:block;margin-left:auto;margin-bottom:16px;padding:8px 16px;background:var(--inverse);color:var(--on-inverse);border-radius:999px}button:focus-visible,summary:focus-visible{outline:2px solid var(--accent-strong);outline-offset:4px}@media(prefers-reduced-motion:no-preference){figure:not([hidden]){animation:fade 200ms ease-out}@keyframes fade{from{opacity:0}to{opacity:1}}}@media(max-width:767px){header{padding-inline:0}.context{padding:28px}.reason,dl{grid-template-columns:1fr;gap:28px}.reason{margin-inline:0}.chapter>h2,.chapter>.label{margin-left:0}.takeaway{margin-inline:0}.gallery{padding:12px}.future{padding-inline:0}.context,.chapter,.future{margin-top:88px}.closing{margin-inline:0}.lead{font-size:18px}}
</style>
