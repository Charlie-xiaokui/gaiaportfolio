---
import '@/styles/case-unified.css';
import BaseLayout from '@/layouts/BaseLayout.astro';
const sections = [
 { id:'decision', label:'01 / 成员 · 选择能力', title:'先回答“能帮我做什么”，再谈如何维护。', problem:'技能详情曾同时承载介绍、评测、版本、文件更新、可见范围和删除。只是来判断技能是否合适的成员，被迫面对一整套资产管理逻辑。', strategy:'将详情拆为安装前了解与试用、安装后资产管理两种场景。市场回答是什么、是否可信、怎么试；对话承接怎么用；管理面板负责维护与治理。', value:'同一个技能，在市场是待选择的能力，在对话是可调用的方法，在后台才是需要维护的资产。', images:['市场/技能详情 安装前.png','市场/技能详情 安装后.png','技能管理弹窗01.png','技能管理弹窗02.png'] },
 { id:'authorize', label:'02 / 成员 · 开始使用', title:'先获得能力，在任务需要时再授权。', problem:'还没感知技能价值，就要求填写 API Key，用户需要先承担配置成本，也难以理解授权的对象和目的。', strategy:'把安装与授权拆开：安装决定伙伴具备什么能力，授权决定这次允许访问哪个系统。当用户提出“查我的 GitHub 仓库”时，再解释为什么需要连接 GitHub。', value:'把空白表单里的系统配置，变成具体任务中的一次确认，让授权对象、目的与收益同时可见。', images:['技能安装01.png','技能安装02.png','技能安装03.png','授权01.png','授权02.png','授权03.png'] },
 { id:'ownership', label:'03 / 成员 · 能力归属', title:'装给谁、在哪管、何时用，都有明确落点。', problem:'多 Agent 平台里的能力并非装上就全局生效。一次安装需要选择一个或多个伙伴，否则用户难以建立每位伙伴能做什么的预期。', strategy:'安装时明确伙伴选择；伙伴详情的能力页集中展示技能、连接器和开关；对话里通过 /、+ 等显式入口查看或指定能力，与自动调用共同工作。', value:'增加一次有意义的选择，换来伙伴级能力边界的可见与可控。', images:['安装时提供明确的能力落点01.png','安装时提供明确的能力落点02.png','把能力边界转化为可理解的信息.png','对话中保留显式控制，降低多伙伴场景下的能力管理困惑.png'] },
 { id:'configure', label:'04 / 管理员 · 接入能力', title:'复杂现实要覆盖，复杂字段不必同时出现。', problem:'MCP、CLI、API Key、OAuth、传输类型、参数与 token 映射共同构成企业接入的真实复杂度。过度简化会让非标准系统无法配通。', strategy:'按基础信息 → 配置连接器 → 关联技能分三步；随连接器、认证与传输选择动态展开字段；提供员工授权界面的实时预览，并支持管理员预先配置授权。', value:'首期可以接受效率仍待优化，但接入路径必须闭环。控制力来自完整能力与清晰反馈，而非所有字段同时可见。', images:['配置表单：先覆盖复杂现实，再通过分层降低认知负担01.png','配置表单：先覆盖复杂现实，再通过分层降低认知负担02.png','配置表单：先覆盖复杂现实，再通过分层降低认知负担03.png'] },
 { id:'govern', label:'05 / 管理员 · 持续治理', title:'从“编辑配置项”，走向“判断该向谁开放”。', problem:'只有新建、编辑、删除，无法回答谁能用、凭证是否配好、谁已安装，以及出问题后如何止损。', strategy:'让列表同时呈现名称与描述、来源、可用范围、预授权和启用状态，并就近提供配置范围、配置凭证、详情与启停操作。', value:'预授权状态把后台技术动作翻译成业务结果：管理员配好凭证后，指定范围的员工可以直接使用，将重复且高门槛的配置集中处理。', images:['借助功能列表让管理员围绕范围、凭证、启停状态做决策和治理动作.png'] },
];
const asset = (name: string) => '/aily-case/' + name.split('/').map(encodeURIComponent).join('/');
---
<BaseLayout title="Aily 工作伙伴能力接入与管理体验设计" description="让普通成员敢装、会用，让管理员能配、敢管。" closing={false}>
<article class="aily-case shell">
 <header class="aily-hero"><nav aria-label="面包屑"><a href="/">作品案例</a><span aria-hidden="true">/</span><span>Aily 工作伙伴能力接入与管理体验设计</span></nav><h1>让 Agent 接得上，也管得住</h1><p class="lead">让成员在不理解复杂技术配置的情况下获得并使用能力，同时让管理员清晰、可控地完成企业能力配置与治理</p><dl><div><dt>设计范围</dt><dd>Aily 市场模块 &amp; 企业管理后台设计</dd></div><div><dt>方案成果</dt><dd>Aily前端用户敢装、会用；Aily企业管理员能配、敢管</dd></div></dl></header>
 <section class="aily-bg-section" id="background" aria-labelledby="aily-bg-title">
  <div class="aily-bg-head">
   <p class="aily-bg-eyebrow">01 / 背景与问题</p>
   <h2 id="aily-bg-title">伙伴要接系统，企业要管能力，<br />但底层概念多、角色多</h2>
  </div>
  <div class="aily-bg-grid">
   <article class="aily-bg-card">
    <h3>能聊天，还要能办事</h3>
    <p>真实任务需要读取数据、操作工具，工作伙伴不能只停留在对话里，还要连接企业内外系统</p>
    <img src="/aily-case/background/bg-chat.png" width="1254" height="1254" alt="工作伙伴连接企业系统的插画" loading="lazy" />
   </article>
   <article class="aily-bg-card">
    <h3>企业需要开放能力，也需要可控</h3>
    <p>企业不仅关心有哪些能力，也需要决定开放给谁、凭证由谁配置，以及何时启用或停用</p>
    <img src="/aily-case/background/bg-control.png" width="1254" height="1254" alt="企业管控能力开放范围的插画" loading="lazy" />
   </article>
   <article class="aily-bg-card">
    <h3>多个伙伴增加复杂度</h3>
    <p>不同伙伴有不同的技能和连接器，普通用户除了选择能力，还要弄清装给谁、在哪里管理</p>
    <img src="/aily-case/background/bg-partners.png" width="1254" height="1254" alt="多个伙伴能力安装归属的插画" loading="lazy" />
   </article>
   <article class="aily-bg-card">
    <h3>技术概念增加理解成本</h3>
    <p>技能、技能包、连接器和授权方式各不相同，但普通用户只想知道：它能帮我做什么，怎样开始用</p>
    <img src="/aily-case/background/bg-concepts.png" width="1254" height="1254" alt="技术概念挡住任务的插画" loading="lazy" />
   </article>
  </div>
 </section>
 <section class="aily-strategy-section" id="strategy" aria-labelledby="aily-strategy-title">
  <div class="aily-strategy-head">
   <p class="aily-strategy-eyebrow">02 / 设计策略</p>
   <h2 id="aily-strategy-title">拆分：普通用户敢装会用、管理员敢配能管</h2>
   <p class="aily-strategy-lead">同一套能力接入体系，对不同角色呈现不同信息密度：成员侧聚焦 “判断、安装与使用”，管理员侧聚焦 “配置、范围与管控”</p>
  </div>
  <div class="aily-strategy-grid">
   <article class="aily-strategy-card">
    <span class="aily-strategy-tag tag-blue">01 / 普通用户</span>
    <h3>让能力选择和使用更轻</h3>
    <p>普通用户重点判断这项能力能否解决当前任务，设计上拆分“安装前了解与试用”+“技能资产管理面板”，在不同场景下应呈现不同信息密度</p>
   </article>
   <article class="aily-strategy-card">
    <span class="aily-strategy-tag tag-amber">02 / 管理员用户</span>
    <h3>让能力配置与治理更清晰</h3>
    <p>管理员需要判断能力开放给谁、凭证是否配置完成，以及出现风险时能否及时停用。设计上将来源、可用范围、凭证状态和启停操作集中呈现，支撑企业能力的持续管理。</p>
   </article>
  </div>
 </section>
 <section class="aily-decision-section" id="decision" aria-labelledby="aily-decision-title">
  <div class="aily-decision-head">
   <p class="aily-decision-eyebrow">03 / 普通用户 · 选择能力</p>
   <h2 id="aily-decision-title">先回答“能帮我做什么”，再谈如何维护</h2>
  </div>
  <div class="aily-decision-points">
   <div>
    <h3>问题：技能弹窗信息过载，影响用户决策</h3>
    <p>• 市场详情承载了介绍、评测、版本、文件更新、可见范围、下架、删除等信息<br />• 普通成员的主任务是判断和试用，但页面混入了管理动作</p>
   </div>
   <div>
    <h3>解决思路：安装链路做轻，管理链路做全</h3>
    <p>• 市场详情回答 “是什么、是否可信、怎么试”<br />• 技能管理回答 “如何维护、发布和治理”</p>
   </div>
  </div>
  <div class="aily-decision-panel">
   <div class="aily-decision-tabs" role="tablist" aria-label="技能详情改造前后">
    <button type="button" role="tab" aria-selected="true" class="is-active" data-decision-tab="before">改造前</button>
    <button type="button" role="tab" aria-selected="false" data-decision-tab="after">改造后</button>
   </div>
   <div class="aily-decision-stage" data-decision-stage="before">
    <figure><img src="/aily-case/decision/before-1.png" alt="改造前：技能详情承载全量信息" loading="lazy" /><figcaption>技能详情-技能介绍</figcaption></figure>
    <figure><img src="/aily-case/decision/before-2.png" alt="改造前：技能详情版本记录" loading="lazy" /><figcaption>技能详情-版本记录</figcaption></figure>
    <figure><img src="/aily-case/decision/before-3.png" alt="改造前：技能详情评测报告" loading="lazy" /><figcaption>技能详情-评测报告</figcaption></figure>
   </div>
   <div class="aily-decision-stage" data-decision-stage="after" hidden>
    <figure><img src="/aily-case/decision/after-intro.png" alt="改造后：聚焦技能介绍" loading="lazy" /><figcaption>技能详情-技能介绍</figcaption></figure>
    <figure><img src="/aily-case/decision/after-version.png" alt="改造后：版本记录" loading="lazy" /><figcaption>技能详情-版本记录</figcaption></figure>
    <figure><img src="/aily-case/decision/after-review.png" alt="改造后：评测报告" loading="lazy" /><figcaption>技能详情-评测报告</figcaption></figure>
   </div>
  </div>
 </section>
 {sections.filter(s=>s.id!=='decision').map(s=>s.id==='authorize' ? <section class="aily-authorize-section" id="authorize" aria-labelledby="aily-authorize-title">
  <div class="aily-authorize-head"><p class="aily-authorize-eyebrow">03 / 普通用户 · 开始使用</p><h2 id="aily-authorize-title">先获得能力，在任务需要时再授权</h2></div>
  <div class="aily-authorize-body">
   <div class="aily-authorize-reasons"><div><h3>问题：安装阶段要求API Key，用户前置承担配置成本</h3><p>• 安装 / 添加解决的是 “这个伙伴具备这项能力”<br />• 授权解决的是 “这次可以访问我的某个系统”</p></div><div><h3>解决思路：拆分 “安装能力” 和 “完成授权”</h3><p>• 降低首次使用门槛<br />• 当用户在对话里提出明确任务时，再引导授权，用户更容易理解授权的意义</p></div></div>
   <div class="aily-authorize-tabs" data-case-tabs><div class="aily-authorize-tablist" role="tablist" aria-label="安装与授权方式"><button type="button" role="tab" id="authorize-tab-immediate" aria-controls="authorize-panel-immediate" aria-selected="true" tabindex="0">安装后立刻授权</button><button type="button" role="tab" id="authorize-tab-deferred" aria-controls="authorize-panel-deferred" aria-selected="false" tabindex="-1">安装与授权拆分</button></div>
    <div class="aily-authorize-panel" role="tabpanel" id="authorize-panel-immediate" aria-labelledby="authorize-tab-immediate"><button type="button" class="aily-authorize-image" data-image="/aily-case/authorize-immediate.png" aria-label="放大查看安装后立刻授权方案"><img src="/aily-case/authorize-immediate.png" width="868" height="543" alt="安装后立刻弹出授权配置，要求填写 API Key" loading="lazy" /></button><p>必须完成授权后才安装成功</p></div>
    <div class="aily-authorize-panel" role="tabpanel" id="authorize-panel-deferred" aria-labelledby="authorize-tab-deferred" hidden><button type="button" class="aily-authorize-image" data-image={asset('授权01.png')} aria-label="放大查看安装与授权拆分方案"><img src={asset('授权01.png')} width="2440" height="1600" alt="在对话任务中需要连接外部系统时，再引导用户授权" loading="lazy" /></button><p>先完成安装，实际任务需要访问系统时再引导授权</p></div>
   </div>
  </div>
 </section> : s.id==='ownership' ? <section class="aily-authorize-section aily-ownership-section" id="ownership" aria-labelledby="aily-ownership-title">
  <div class="aily-authorize-head"><p class="aily-authorize-eyebrow">03 / 普通用户 · 能力归属</p><h2 id="aily-ownership-title">装给谁、在哪管、何时用，都有明确落点</h2></div>
  <div class="aily-authorize-body"><div class="aily-authorize-reasons"><div><h3>难点：多伙伴场景下，能力容易 “装了但找不到归属”</h3><p>• 技能和连接器安装到具体工作伙伴后，用户需要判断装给谁、在哪里管理<br />• 对话时调用了哪些能力<br />• 伙伴越多，能力归属越容易变得不清晰</p></div><div><h3>方案取舍：让能力的安装、管理和调用都回到具体伙伴</h3><p>• 安装时明确目标伙伴，让能力有明确落点<br />• 伙伴详情承接能力查看与启停，让能力归属可见、可控<br />• 对话中保留显式调用入口，降低多伙伴场景下的能力使用困惑</p></div></div>
   <div class="aily-authorize-tabs" data-case-tabs><div class="aily-authorize-tablist" role="tablist" aria-label="能力归属方案"><button type="button" role="tab" id="ownership-tab-install" aria-controls="ownership-panel-install" aria-selected="true" tabindex="0">安装时展示落点</button><button type="button" role="tab" id="ownership-tab-manage" aria-controls="ownership-panel-manage" aria-selected="false" tabindex="-1">能力可见、可控</button><button type="button" role="tab" id="ownership-tab-conversation" aria-controls="ownership-panel-conversation" aria-selected="false" tabindex="-1">保留显示控制</button></div>
    <div class="aily-authorize-panel" role="tabpanel" id="ownership-panel-install" aria-labelledby="ownership-tab-install"><div class="aily-ownership-image-grid"><div><button type="button" class="aily-authorize-image" data-image={asset('安装时提供明确的能力落点01.png')} aria-label="放大查看安装目标伙伴"><img src={asset('安装时提供明确的能力落点01.png')} width="1048" height="1040" alt="安装时选择目标智能体" loading="lazy" /></button><p>安装时支持选择智能体，明确能力落点</p></div><div><button type="button" class="aily-authorize-image" data-image={asset('安装时提供明确的能力落点02.png')} aria-label="放大查看已添加的智能体"><img src={asset('安装时提供明确的能力落点02.png')} width="1200" height="1280" alt="已安装的技能显示已添加的智能体" loading="lazy" /></button><p>已安装的技能展示已添加的智能体</p></div></div></div>
    <div class="aily-authorize-panel" role="tabpanel" id="ownership-panel-manage" aria-labelledby="ownership-tab-manage" hidden><button type="button" class="aily-authorize-image" data-image={asset('把能力边界转化为可理解的信息.png')} aria-label="放大查看伙伴能力管理界面"><img src={asset('把能力边界转化为可理解的信息.png')} width="2440" height="1600" alt="伙伴详情集中展示技能、连接器及启停状态" loading="lazy" /></button><p>伙伴详情承接能力查看与启停，让归属可见、可控</p></div>
    <div class="aily-authorize-panel" role="tabpanel" id="ownership-panel-conversation" aria-labelledby="ownership-tab-conversation" hidden><button type="button" class="aily-authorize-image" data-image={asset('对话中保留显式控制，降低多伙伴场景下的能力管理困惑.png')} aria-label="放大查看对话中的能力控制"><img src={asset('对话中保留显式控制，降低多伙伴场景下的能力管理困惑.png')} width="2880" height="1800" alt="对话中保留显式调用和能力控制入口" loading="lazy" /></button><p>对话中保留显式调用入口，随时确认当前可用能力</p></div>
   </div>
  </div>
 </section> : s.id==='configure' ? <section class="aily-authorize-section aily-admin-section aily-configure-section" id="configure" aria-labelledby="aily-configure-title">
  <div class="aily-authorize-head"><p class="aily-authorize-eyebrow">04 / 管理员用户 · 接入能力</p><h2 id="aily-configure-title">复杂现实要覆盖，复杂字段不必同时出现</h2></div>
  <div class="aily-authorize-body"><div class="aily-authorize-reasons"><div><h3>问题：配置信息过于复杂</h3><p>企业自定义技能包的创建非常复杂。管理员可能面对<br />• MCP / CLI 两种连接器<br />• API Key、OAuth 2.0、OAuth 2.1等认证方式<br />• 传输类型、请求头、查询参数、请求体等不同的协议与参数<br />• token 获取、刷新和返回字段映射不同的凭证链路</p></div><div><h3>解决思路：用分步和条件展示，把字段放到正确的配置时刻</h3><p>• 按流程切分：基础信息 → 连接器配置 → 关联技能；<br />• 先定类型，再出字段：先选择 MCP/CLI 和认证方式，再展示对应参数；<br />• 用预览和状态确认结果：管理员能看到员工侧授权表单，以及当前是否配置完成<br />• 首期保覆盖，后续提效率：先兼容标准和非标准服务，再补文件识别和自动填充</p></div></div>
   <div class="aily-authorize-tabs" data-case-tabs><div class="aily-authorize-tablist" role="tablist" aria-label="管理员接入能力方案"><button type="button" role="tab" id="configure-tab-steps" aria-controls="configure-panel-steps" aria-selected="true" tabindex="0">按流程切分</button><button type="button" role="tab" id="configure-tab-conditions" aria-controls="configure-panel-conditions" aria-selected="false" tabindex="-1">先定类型，再出字段</button><button type="button" role="tab" id="configure-tab-preview" aria-controls="configure-panel-preview" aria-selected="false" tabindex="-1">用预览和状态确认结果</button><button type="button" role="tab" id="configure-tab-coverage" aria-controls="configure-panel-coverage" aria-selected="false" tabindex="-1">首期保覆盖，后续提效率</button></div>
    <div class="aily-authorize-panel" role="tabpanel" id="configure-panel-steps" aria-labelledby="configure-tab-steps"><div class="aily-configure-image-grid">{['配置表单：先覆盖复杂现实，再通过分层降低认知负担01.png','配置表单：先覆盖复杂现实，再通过分层降低认知负担02.png','配置表单：先覆盖复杂现实，再通过分层降低认知负担03.png'].map((name,i)=><div><button type="button" class="aily-authorize-image" data-image={asset(name)} aria-label={`放大查看第 ${i+1} 步配置界面`}><img src={asset(name)} alt={['基础信息配置','连接器与认证配置','关联技能'][i]} loading="lazy" /></button><p>{['01 / 基础信息','02 / 连接器配置','03 / 关联技能'][i]}</p></div>)}</div></div>
