<script>
document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(g=>{const buttons=g.querySelectorAll<HTMLButtonElement>('[data-slide]');const figures=g.querySelectorAll('figure');buttons.forEach((b,i)=>b.addEventListener('click',()=>{buttons.forEach((x,j)=>x.setAttribute('aria-pressed',String(i===j)));figures.forEach((f,j)=>f.hidden=i!==j)}))});
document.querySelectorAll<HTMLElement>('[data-case-tabs]').forEach(group=>{const tabs=Array.from(group.querySelectorAll<HTMLButtonElement>('[role="tab"]'));const panels=Array.from(group.querySelectorAll<HTMLElement>('[role="tabpanel"]'));const select=(index:number,focus=false)=>{tabs.forEach((tab,i)=>{tab.setAttribute('aria-selected',String(i===index));tab.tabIndex=i===index?0:-1});panels.forEach((panel,i)=>panel.hidden=i!==index);if(focus)tabs[index]?.focus()};tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>select(index));tab.addEventListener('keydown',event=>{if(event.key==='ArrowRight'||event.key==='ArrowLeft'){event.preventDefault();select((index+(event.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length,true)}else if(event.key==='Home'||event.key==='End'){event.preventDefault();select(event.key==='Home'?0:tabs.length-1,true)}})})});
document.querySelectorAll<HTMLButtonElement>('[data-decision-tab]').forEach(btn=>btn.addEventListener('click',()=>{const mode=btn.dataset.decisionTab;document.querySelectorAll<HTMLButtonElement>('[data-decision-tab]').forEach(b=>{const on=b.dataset.decisionTab===mode;b.setAttribute('aria-selected',String(on));b.classList.toggle('is-active',on)});document.querySelectorAll<HTMLElement>('[data-decision-stage]').forEach(stage=>{stage.hidden=stage.dataset.decisionStage!==mode})}));
const viewer=document.querySelector<HTMLDialogElement>('.image-dialog');document.querySelectorAll<HTMLButtonElement>('[data-image]').forEach(b=>b.addEventListener('click',()=>{if(!viewer)return;viewer.querySelector('img')!.src=b.dataset.image!;viewer.showModal()}));viewer?.querySelector('button')?.addEventListener('click',()=>viewer.close());viewer?.addEventListener('click',e=>{if(e.target===viewer)viewer.close()});
</script>
