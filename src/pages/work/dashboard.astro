---
import '@/styles/case-unified.css';
import BaseLayout from '@/layouts/BaseLayout.astro';

const a = (name: string) => `/dashboard-case/${name}.jpg`;

const decisions = [
  { key: 'axis', tab: '坐标轴', alt: '时间抽样与分类轴标签策略' },
  { key: 'label', tab: '数据标签', alt: '数据标签反色、避让与换行' },
  { key: 'width', tab: '图元展示', alt: '图元宽度档位对照' },
  { key: 'tip', tab: '提示信息', alt: '提示框位置与自定义内容' },
];

const demoTabs = ['头部氛围', '指标卡设计', '提取行业特征', '4类仪表盘输出'];
---

<BaseLayout
  title="仪表盘优化专项 · 从图表可读性到售前演示体验"
  description="客户说看不清、售前需要讲得清。建立图表评估标准、优化四类高优图表问题，并把散乱的仪表盘重组为有层次、有行业辨识度的产品演示。"
  type="article"
  closing={false}
>
  <article class="case-media-hover dash-case">
    <header class="shell case-header">
      <div class="flex flex-col items-start">
        <nav aria-label="面包屑" class="case-header-breadcrumb rise">
          <a href="/">作品案例</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">仪表盘优化专项</span>
        </nav>
        <h1 class="case-title text-balance self-stretch case-header-title rise" style="--rise-step: 2">
          让图表更好读，让仪表盘讲清业务
        </h1>
      </div>
      <p class="text-pretty case-header-intro rise" style="--rise-step: 3">
        客户说“看不清”，售前却需要“讲得清”。从模糊的反馈出发，建立评估标准、优化图表，再把散乱的仪表盘重组为有层次、有行业辨识度的产品演示
      </p>
      <dl class="dashboard-meta case-header-meta rise" style="--rise-step: 4">
        <div>
          <dt>我的职责</dt>
          <dd>项目设计 Owner</dd>
        </div>
        <div>
          <dt>工作范围</dt>
          <dd>
            <ul role="list">
              <li>根据实际场景，解决图表展示问题，全方位提升图表视觉效果</li>
              <li>根据产品销售策略，结合目标行业特征，定向优化仪表盘demo</li>
            </ul>
          </dd>
        </div>
        <div>
          <dt>项目结果</dt>
          <dd>
            <ul role="list">
              <li>图表整体评分 6.8 → 7.9（+16.2%）</li>
              <li>作为学习材料供81.4%的新用户学习</li>
            </ul>
          </dd>
        </div>
      </dl>
    </header>

    <section class="shell story-section reveal problem-section" aria-labelledby="problem-title">
      <div class="story-copy">
        <p class="eyebrow">01 / 背景与问题</p>
        <h2 id="problem-title">客户看不清图表，售前讲不清业务</h2>
        <p>
          商业售卖中，客户反复提到图表残缺、模糊、挤在一起，但这些词无法直接变成设计任务；另一端，售前 Demo
          缺少故事线与行业特征，也难以有效展示产品能力
        </p>
      </div>
      <div class="problem-images">
        <img
          src="/dashboard-case/problem-01.png"
          width="3840"
          height="2160"
          alt="图表展示问题"
          loading="lazy"
          data-lightbox
        />
        <img
          src="/dashboard-case/problem-02.png"
          width="3840"
          height="2160"
          alt="售前仪表盘 Demo 的问题"
          loading="lazy"
          data-lightbox
        />
      </div>
    </section>

    <section class="shell story-section reveal problem-section" aria-labelledby="standard-title">
      <div class="story-copy">
        <p class="eyebrow">02 / 评估标准和高优问题</p>
        <h2 id="standard-title">建立评估标准，明确优化重点</h2>
        <p>
          通过体验自查和专家讨论，把图表表现拆成可描述的维度，再关联到具体影响因素；之后结合用户反馈与评估结果，聚焦轴标签、数据标签、图元展示和提示信息四类高优问题
        </p>
      </div>
      <div class="problem-images">
        <img
          src="/dashboard-case/standard-01.png"
          width="3840"
          height="2160"
          alt="图表评估标准"
          loading="lazy"
          data-lightbox
        />
        <img
          src="/dashboard-case/standard-02.png"
          width="3840"
          height="2160"
          alt="四类高优图表问题"
          loading="lazy"
          data-lightbox
        />
      </div>
    </section>

    <!-- 03 四个决策 -->
    <section class="shell story-section reveal problem-section" aria-labelledby="decision-title">
      <div class="story-copy">
        <p class="eyebrow">03 / 图表优化</p>
        <h2 id="decision-title">让图表自动适应真实数据</h2>
        <p>
          四类问题背后有一个共同点：数据条件变化时，原有展示规则失效。方向是把常见场景的处理变成系统策略，同时保留必要的场景弹性
        </p>
      </div>
      <div class="decision-gallery">
        <div class="decision-tabs" data-decision-tabs role="tablist" aria-label="四项图表设计决策">
          {decisions.map((d, i) => (
            <button
              type="button"
              role="tab"
              id={`dash-decision-tab-${d.key}`}
              aria-controls={`dash-decision-panel-${d.key}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class={i === 0 ? 'is-active' : ''}
              data-decision-key={d.key}
            >
              {d.tab}
            </button>
          ))}
        </div>
        <div class="decision-viewport">
          {decisions.map((d, i) => (
            <div
              class:list={['decision-panel', { 'is-active': i === 0 }]}
              id={`dash-decision-panel-${d.key}`}
              role="tabpanel"
              aria-labelledby={`dash-decision-tab-${d.key}`}
              aria-hidden={i !== 0}
              data-decision-panel={d.key}
            >
              <img
                src={`/dashboard-case/decision-0${i + 1}.png`}
                width="3840"
                height="2160"
                alt={d.alt}
                loading="lazy"
                data-lightbox
              />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 05 验证 -->
    <section class="shell story-section reveal problem-section" aria-labelledby="result-title">
      <div class="story-copy">
        <p class="eyebrow">04 / 图表效果</p>
        <h2 id="result-title">用同一套标准验证优化效果</h2>
        <p>
          使用真实数据在原环境和测试环境搭建对照看板，先让用户比较差异，再收集维度评分与影响因素。评分用来比较各维度的改善。仍被至少
          20% 的参与者提及的问题，继续按图表组件和评分维度归类，作为后续迭代的依据
        </p>
      </div>
      <div class="problem-images result-images">
        <img
          src="/dashboard-case/result-01.png"
          width="3840"
          height="2160"
          alt="图表效果验证，图一"
          loading="lazy"
          data-lightbox
        />
        <img
          src="/dashboard-case/result-02.png"
          width="3840"
          height="2160"
          alt="图表效果验证，图二"
          loading="lazy"
          data-lightbox
        />
      </div>
    </section>

    <section class="dark-section demo-section" aria-labelledby="story-title">
      <div class="shell story-section problem-section">
        <div class="story-copy on-dark">
          <p class="eyebrow">05 / 售前 Demo 重构</p>
          <h2 id="story-title">梳理故事线：看趋势-找差异-查明细</h2>
          <p>
            先明确看板主题、使用目的和核心指标，再将分散的图表按 “大盘趋势 — 维度对比 — 明细查询”
            重新组织，形成逐层深入的阅读路径，让售前演示能围绕业务问题展开，而不只是逐个介绍图表功能
          </p>
        </div>
        <ol class="demo-steps">
          {['重构故事线', '提升视觉效果', '融合行业特征'].map((step, index) => (
            <li>
              <span>0{index + 1}</span> {step}
            </li>
          ))}
        </ol>
        <div class="problem-images result-images demo-images">
          <img
            src="/dashboard-case/demo-story-01.png"
            width="3840"
            height="2160"
            alt="售前 Demo 故事线梳理"
            loading="lazy"
            data-lightbox
          />
          <img
            src="/dashboard-case/demo-story-02.png"
            width="3840"
            height="2160"
            alt="售前 Demo 阅读路径重构"
            loading="lazy"
            data-lightbox
          />
        </div>
        <div class="demo-visual">
          <h3>视觉效果+行业特征</h3>
          <p>
            在理顺故事线的基础上，重点优化头部、指标卡与图表容器，并融入行业视觉特征，在突出核心数据的同时，让 Demo
            更贴合目标行业的演示场景
          </p>
        </div>
        <div class="decision-gallery">
          <div class="decision-tabs" data-decision-tabs role="tablist" aria-label="视觉效果与行业特征">
            {demoTabs.map((tab, i) => (
              <button
                type="button"
                role="tab"
                id={`demo-tab-${i}`}
                aria-controls={`demo-panel-${i}`}
                aria-selected={i === 0}
                tabindex={i === 0 ? 0 : -1}
                data-decision-key={String(i)}
              >
                {tab}
              </button>
            ))}
          </div>
          <div class="decision-viewport">
            {demoTabs.map((tab, i) => (
              <div
                class:list={['decision-panel', { 'is-active': i === 0 }]}
                id={`demo-panel-${i}`}
                role="tabpanel"
                aria-labelledby={`demo-tab-${i}`}
                aria-hidden={i !== 0}
                data-decision-panel={String(i)}
              >
                <img
                  src={`/dashboard-case/demo-visual-0${i + 1}.png`}
                  width="3840"
                  height="2160"
                  alt={tab}
                  loading="lazy"
                  data-lightbox
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="shell story-section reveal outcome-section" aria-labelledby="adoption-title">
      <div class="story-copy">
        <p class="eyebrow">06 / 项目成果</p>
        <h2 id="adoption-title">售前演示也成了用户的学习范例</h2>
        <p>多主题 Demo 上线后，用户可以参考这些范例学习如何组织数据、搭建自己的看板</p>
      </div>
      <aside class="business-stats">
        <div>
          <strong>超出预期</strong>
          <p>多主题 Demo 产出在双月总结中获得项目团队“超出预期”的评价</p>
        </div>
        <div>
          <strong>1600+</strong>
          <p>学习 Demo 材料的用户</p>
        </div>
        <div>
          <strong>220+</strong>
          <p>完成学习和看板搭建的用户</p>
        </div>
      </aside>
      <img
        class="outcome-image"
        src="/dashboard-case/outcome-05.png"
        width="3840"
        height="2160"
        alt="项目成果与用户学习反馈"
        loading="lazy"
        data-lightbox
      />
    </section>

    <div class="shell back-link">
      <a href="/">
        返回作品集 <span aria-hidden="true">↗</span>
      </a>
    </div>
  </article>

  <div class="dash-lightbox" id="dash-lightbox" aria-hidden="true">
    <button type="button" class="dash-lightbox-close" id="dash-lightbox-close" aria-label="关闭">
      ×
    </button>
    <div class="dash-lightbox-body" id="dash-lightbox-body"></div>
  </div>
</BaseLayout>

<script>
  (function () {
    try {
      var reduce = matchMedia('(prefers-reduced-motion: reduce)');

      // 四项图表设计决策切换
      document.querySelectorAll<HTMLElement>('[data-decision-tabs]').forEach(function (tablist) {
        var tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
        var panels = Array.from(
          tablist.closest('.decision-gallery')!.querySelectorAll<HTMLElement>('[data-decision-panel]'),
        );
        let request = 0;
        let animations: Animation[] = [];
        async function activate(key: string) {
          const token = ++request;
          const incoming = panels.find((panel) => panel.dataset.decisionPanel === key);
          if (!incoming || incoming.classList.contains('is-active')) return;
          await incoming
            .querySelector('img')
            ?.decode()
            .catch(() => {});
          if (token !== request) return;
          const outgoing = panels.find((panel) => panel.classList.contains('is-active'));
          animations.forEach((animation) => animation.cancel());
          animations = [];
          tabs.forEach(function (tab) {
            var selected = tab.dataset.decisionKey === key;
            tab.setAttribute('aria-selected', String(selected));
            tab.classList.toggle('is-active', selected);
            tab.tabIndex = selected ? 0 : -1;
          });
          panels.forEach(function (panel) {
            var selected = panel.dataset.decisionPanel === key;
            panel.classList.toggle('is-active', selected);
            panel.setAttribute('aria-hidden', String(!selected));
          });
          if (!outgoing || reduce.matches) return;
          const direction = panels.indexOf(incoming) > panels.indexOf(outgoing) ? 1 : -1;
          const options = { duration: 520, easing: 'cubic-bezier(0.25, 0.8, 0.25, 1)' };
          animations = [
            outgoing.animate(
              [
                { transform: 'translateX(0)', visibility: 'visible' },
                { transform: `translateX(${-direction * 100}%)`, visibility: 'visible' },
              ],
              options,
            ),
            incoming.animate(
              [{ transform: `translateX(${direction * 100}%)` }, { transform: 'translateX(0)' }],
              options,
            ),
          ];
        }
        tabs.forEach(function (tab, index) {
          tab.addEventListener('click', function () {
            activate(tab.dataset.decisionKey || '');
          });
          tab.addEventListener('keydown', function (event) {
            if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
            event.preventDefault();
            var next =
              event.key === 'Home'
                ? 0
                : event.key === 'End'
                  ? tabs.length - 1
                  : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
            activate(tabs[next].dataset.decisionKey || '');
            tabs[next].focus();
          });
        });
      });

      // 原稿灯箱
      var box = document.getElementById('dash-lightbox');
      var bodyEl = document.getElementById('dash-lightbox-body');
      var closeBtn = document.getElementById('dash-lightbox-close');
      function closeBox() {
        if (!box || !bodyEl) return;
        box.classList.remove('is-open');
        box.setAttribute('aria-hidden', 'true');
        bodyEl.innerHTML = '';
      }
      document.querySelectorAll<HTMLImageElement>('[data-lightbox]').forEach(function (img) {
        img.style.cursor = 'zoom-in';
        img.addEventListener('click', function () {
          if (!box || !bodyEl) return;
          var clone = img.cloneNode(true) as HTMLImageElement;
          clone.removeAttribute('loading');
          clone.style.cursor = 'default';
          bodyEl.innerHTML = '';
          bodyEl.appendChild(clone);
          box.classList.add('is-open');
          box.setAttribute('aria-hidden', 'false');
        });
      });
      if (closeBtn) closeBtn.addEventListener('click', closeBox);
      if (box)
        box.addEventListener('click', function (e) {
          if (e.target === box) closeBox();
        });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeBox();
      });

      // 滚动揭示
      var revealEls = Array.from(document.querySelectorAll('.reveal'));
      if (!reduce.matches && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 },
        );
        revealEls.forEach(function (el) {
          io.observe(el);
        });
      } else {
        revealEls.forEach(function (el) {
          el.classList.add('in');
        });
      }
    } catch (error) {
      console.error(error);
    }
  })();
</script>

<style>
  /* finesse · register=brand · existing portfolio palette · editorial case */
  .dash-case .story-copy .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9.6px;
    color: var(--muted);
  }
  .eyebrow::before {
    content: '';
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #d4f84a;
  }
  .dash-case .dark-section {
    background: #1e1f20;
  }
  .demo-section .decision-gallery,
  .demo-section .demo-images,
  .demo-steps li {
    background: #2a2b2c;
    border-color: #444544;
  }
  .demo-section .decision-tabs button {
    color: #fafaf7;
    border-color: #666764;
  }
  .demo-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }
  .demo-steps li {
    position: relative;
    padding: 24px 12px;
    border: 1px solid #444544;
    border-radius: 24px;
    text-align: center;
    color: #fafaf7;
    font-size: 18px;
  }
  .demo-steps li:not(:last-child)::after {
    content: '→';
    position: absolute;
    left: 100%;
    width: 24px;
    color: #c7c7bf;
  }
  .demo-steps li span {
    color: #d4f84a;
  }
  .demo-section .demo-images {
    margin-top: 20px;
  }
  .demo-visual {
    margin-top: 64px;
  }
  .demo-visual h3 {
    color: #fafaf7;
    font-size: clamp(26px, 4vw, 34px);
    line-height: 1.4;
    font-weight: 500;
  }
  .demo-visual p {
    max-width: 900px;
    margin-top: 12px;
    color: #c7c7bf;
    font-size: 17px;
    line-height: 1.85;
  }
  .demo-section .decision-gallery {
    margin-top: 32px;
  }
  @media (max-width: 599px) {
    .demo-steps {
      grid-template-columns: 1fr;
    }
    .demo-steps li:not(:last-child)::after {
      content: '↓';
      left: calc(50% - 12px);
      top: 100%;
    }
  }
  .dash-case .dark-section .eyebrow {
    color: #c7c7bf !important;
  }
  .dash-case .chart-results {
    grid-template-columns: minmax(0, 1fr);
  }
  .dash-case .business-stats {
    margin-top: 36px;
  }
  .dash-case .business-stats > div {
    background: var(--surface);
  }
  @media (min-width: 760px) {
    .dash-case .business-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .dash-case {
    font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  }
  .dash-case {
    --d-ink: #142036;
    --d-muted: #57647a;
    --d-accent: #1555df;
    --d-deep: #0b1424;
    --d-line: #d5dce6;
    --d-paper: #f5f7fa;
    padding-bottom: 96px;
  }
  .dash-case .shell {
    width: min(1120px, calc(100% - 40px));
    margin-inline: auto;
  }
  .dash-case .kicker {
    color: var(--d-accent);
    font-size: 13px;
    letter-spacing: 0.14em;
    font-weight: 700;
  }
  .case-title {
    font-size: clamp(38px, 5.6vw, 70px);
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 650;
  }
  .dashboard-meta {
    display: grid;
    gap: 24px;
    padding-block: 32px;
    border-block: 1px solid var(--line);
  }
  .dashboard-meta li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35em;
  }
  .dashboard-meta li::before {
    content: '•';
    color: var(--muted);
  }
  .hero-panel {
    margin: 0;
    background: #e6eefc;
    border-radius: 20px;
    padding: 32px;
    text-align: center;
  }
  .hero-panel img {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin-inline: auto;
    box-shadow: 0 20px 35px rgba(23, 55, 91, 0.15);
  }
  .hero-panel figcaption {
    margin-top: 16px;
    color: #345171;
    font-size: 14px;
  }

  .story-section {
    padding-top: 130px;
  }
  .problem-section .story-copy {
    max-width: 900px;
  }
  .problem-section .story-copy > p:not(.eyebrow) {
    margin-top: 24px;
    line-height: 1.85;
    text-wrap: pretty;
  }
  .problem-images {
    display: grid;
    gap: 16px;
    margin-top: 48px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--sunken);
  }
  .problem-images.result-images {
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    padding: 20px;
  }
  .problem-images img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
  }
  @media (min-width: 760px) {
    .problem-images {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .story-copy {
    max-width: 840px;
  }
