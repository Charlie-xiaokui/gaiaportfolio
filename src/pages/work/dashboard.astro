---
import '@/styles/case-unified.css';
import BaseLayout from '@/layouts/BaseLayout.astro';

const a = (name: string) => `/dashboard-case/${name}.jpg`;

const decisions = [
  {
    key: 'axis',
    tab: '坐标轴',
    title: '标签不再挤成一条线',
    problem: '轴标签被遮挡或过度旋转，读者很难快速找到对应信息。',
    choice: '时间轴采用抽样展示；分类轴支持纵排与旋转，根据数据情况调整标签策略。',
    trade: '时间抽样减少拥挤，但不再显示所有标签；分类轴则需要兼顾完整文字和可用空间。',
    image: a('轴标签对照'),
    alt: '时间抽样与分类轴标签策略的前后对照原稿',
    caption: '时间抽样 + 分类轴纵排 / 旋转',
  },
  {
    key: 'label',
    tab: '数据标签',
    title: '让信息与背景拉开距离',
    problem: '标签颜色看不清、彼此重叠，长内容又容易被截断。',
    choice: '根据图元颜色智能反色；采用先占位先绘制策略，必要时隐藏部分标签；长内容自动换行。',
    trade: '优先保证可读，不强行显示每一个标签；标签与数据图形之间保留足够辨识度。',
    image: a('标签对照'),
    alt: '数据标签智能反色、局部隐藏与自动换行对照原稿',
    caption: '智能反色、局部隐藏与自动换行',
  },
  {
    key: 'width',
    tab: '图元宽度',
    title: '数据变多变少，秩序仍然成立',
    problem: '极多与极少数据让图元过细或过粗，同一仪表盘里的图表显得不协调。',
    choice: '结合仪表盘排布，设置图元宽度档位和范围，而不是所有场景都用同一固定宽度。',
    trade: '宽度档位优先适应数据和视觉均衡，不追求所有图表拥有完全相同的柱宽。',
    image: a('图元对照'),
    alt: '固定宽度与宽度档位方案对照原稿',
    caption: '从固定宽度到宽度档位',
  },
  {
    key: 'tip',
    tab: '提示信息',
    title: '提示框不该比数据更抢眼',
    problem: '提示位置左右晃动；用户想看总计和更多明细时，现有信息又不够。',
    choice: '明确提示框与鼠标的位置关系，仅在视窗边缘和图表交界触发位置切换；支持自定义提示内容。',
    trade: '稳定位置与边界避让并存；自定义内容增加场景适配能力，不把所有信息强塞进默认提示框。',
    image: a('提示信息对照'),
    alt: '提示框位置规范与自定义内容对照原稿',
    caption: '位置规范与自定义提示内容',
  },
];

const inspects = [
  { key: 'metrics', title: '核心指标：先交代构成', desc: '核心指标用“总计 = 质量 + 体验”的构成关系组织，帮助读者先建立整张仪表盘的理解框架。', short: '用异形、重色与加法关系明确拆解思路' },
  { key: 'trend', title: '趋势：让总体和局部关联', desc: '趋势图采用双轴展示，颜色关联总体与模块，让读者看清变化趋势与构成关系。', short: '双轴图配合一致的颜色关系' },
  { key: 'rank', title: '排行：先给读者关键线索', desc: '热门反馈从条形图改成排行榜，并突出结论性信息。读者先找到需要关注的线索，再向维度分析深入。', short: '把条形图改为排行榜，突出结论性信息' },
  { key: 'visual', title: '行业表达：从汽车语言提炼', desc: '头部、指标卡和容器提炼汽车行业的流线、几何与简洁特征。全局图表加强存在感，重复的分维度图表保持轻量。', short: '流线、几何与简洁图形贯穿头部和容器' },
];

const scoreRows = [
  { name: '清晰度', before: 6.7, after: 8.1 },
  { name: '易读性', before: 6.5, after: 7.9 },
  { name: '美观度', before: 7.0, after: 7.7 },
  { name: '流畅度', before: 7.2, after: 8.0 },
];
---

<BaseLayout
  title="仪表盘优化专项 · 从图表可读性到售前演示体验"
  description="客户说看不清、售前需要讲得清。建立图表评估标准、优化四类高优图表问题，并把散乱的仪表盘重组为有层次、有行业辨识度的产品演示。"
  type="article"
  closing={false}
>
  <article class="dash-case">
    <header class="shell pt-12 sm:pt-16">
      <nav aria-label="面包屑" class="rise text-sm text-muted">
        <a href="/">作品案例</a> <span aria-hidden="true"> / </span>
        <span class="text-ink">仪表盘优化专项</span>
      </nav>
      <p class="rise kicker mt-12" style="--rise-step:1">图表设计 / 数据体验</p>
      <h1 class="rise case-title mt-6" style="--rise-step:2">好看的图表，只是第一步</h1>
      <p class="rise case-lead mt-8" style="--rise-step:3">客户说“看不清”，售前却需要“讲得清”。我从这些模糊的反馈出发，和团队一起建立评估标准、优化图表，再把散乱的仪表盘重组为有层次、有行业辨识度的产品演示。</p>
      <dl class="rise case-meta mt-12" style="--rise-step:4">
        <div><dt>我的角色</dt><dd>项目设计负责人：图表体验梳理、评估体系搭建与 Demo 设计优化</dd></div>
        <div><dt>核心工作</dt><dd>图表治理（92 个问题自查、四维评估）/ 商业仪表盘 Demo 重构</dd></div>
        <div><dt>项目成果</dt><dd>图表整体评分 6.8 → 7.9（+16.2%）；多主题 Demo 获“超出预期”评价</dd></div>
      </dl>
    </header>

    <div class="shell mt-14">
      <figure class="hero-panel">
        <img src={a('汽车反馈成品')} width="1500" height="844" alt="优化后的汽车用户反馈仪表盘" fetchpriority="high" data-lightbox />
        <figcaption>从零散展示，到逐层阅读的汽车用户反馈仪表盘</figcaption>
      </figure>
    </div>

    <!-- 01 问题 -->
    <section class="shell story-section reveal" aria-labelledby="problem-title">
      <div class="story-copy">
        <p class="eyebrow">01 / 从反馈切入</p>
        <h2 id="problem-title">问题不是“还不够漂亮”，而是信息没有被读懂</h2>
        <p>这是一个报表产品。商业售卖中，客户反复提到图表残缺、模糊、挤在一起，但这些词无法直接变成设计任务；另一端，售前 Demo 缺少故事线与行业特征，也难以有效展示产品能力。</p>
      </div>
      <blockquote class="pull-quote">“阅读性很低、有残缺、很糊、坨在一起……”</blockquote>
      <div class="two-layers">
        <article><span class="layer-tag">图表层 · 先让信息可读</span><p>轴标签、数据标签、图元宽度、提示信息——先解决单张图表能否准确传达信息。</p></article>
        <article><span class="layer-tag">页面层 · 再让业务可理解</span><p>故事线、视觉层次、行业表达——再解决整张仪表盘能否带着读者理解业务。</p></article>
      </div>
      <figure class="shot-panel">
        <img src="/dashboard-case/dashboard-hd-02.jpg" width="1920" height="1080" alt="客户反馈与售前演示的两类问题原稿" loading="lazy" data-lightbox />
        <figcaption>客户反馈与售前演示，是两类需要分开处理的问题</figcaption>
      </figure>
      <div class="role-boundary">
        <h3>我负责设计推进，标准与落地由团队共同完成</h3>
        <div class="boundary-grid">
          <p><b>我的责任边界：</b>围绕实际场景识别设计机会，推进图表体验问题梳理、评估体系搭建与 Demo 的设计优化。</p>
          <p><b>团队共同工作：</b>业务、产品、研发和设计共同讨论评估标准，结合图表能力、场景需求与测试反馈协作落实。评估体系与项目结果不归为个人独立成果。</p>
        </div>
      </div>
    </section>

    <!-- 02 标准 -->
    <section class="shell story-section reveal" aria-labelledby="standard-title">
      <div class="story-copy">
        <p class="eyebrow">02 / 把感受变成标准</p>
        <h2 id="standard-title">先对“好图表”形成共同判断</h2>
        <p>如果团队只说“更清楚一点”，优化就很难被验证。我们从体验自查和专家讨论中，把图表表现拆成可描述的维度，再关联到具体影响因素，让每一次改动都能解释为什么。</p>
      </div>
      <ol class="path">
        <li><b>场景自查</b><p>走查正常、极少、极多数据场景，按组件构成整理并提取共性问题。</p></li>
        <li><b>共同定义标准</b><p>邀请业务、产品、研发、设计专家，经三版迭代，围绕设计目的与影响因素建立体系。</p></li>
        <li><b>聚焦优先问题</b><p>综合客户反馈、设计自查与图表评估，把关注点收敛为四类高优问题。</p></li>
      </ol>
      <div class="fact-grid">
        <div class="fact"><strong>92</strong><span>自查发现的图表问题</span></div>
        <div class="fact"><strong>12</strong><span>参与讨论的图表专家</span></div>
        <div class="fact"><strong>3 版</strong><span>评估体系迭代</span></div>
        <div class="fact"><strong>4 维度</strong><span>清晰度 / 美观度 / 易读性 / 流畅度</span></div>
      </div>
      <details class="source-details">
        <summary>看评估体系与原始依据</summary>
        <figure class="shot-panel"><img src="/dashboard-case/dashboard-hd-04.jpg" width="1920" height="1080" alt="评估维度与影响因素原稿" loading="lazy" data-lightbox /><figcaption>评估维度与影响因素</figcaption></figure>
        <p class="metric-note">逐字稿明确清晰度权重为 40%，其他权重未提供，因此不补造完整权重分布；原稿第 5 页的问题比例缺少统计样本口径，不作为新增量化结论展示。</p>
      </details>
    </section>

    <!-- 03 四个决策 -->
    <section class="shell story-section reveal" aria-labelledby="decision-title">
      <div class="story-copy">
        <p class="eyebrow">03 / 让图表适应真实数据</p>
        <h2 id="decision-title">不是多给几个开关，而是少让用户手动调整</h2>
        <p>四类问题背后有一个共同点：数据条件变化时，原有展示规则失效。方向是把常见场景的处理变成系统策略，同时保留必要的场景弹性。点击各项查看真实对照。</p>
      </div>
      <div class="decision-tabs" data-decision-tabs role="tablist" aria-label="四项图表设计决策">
        {decisions.map((d, i) => (
          <button type="button" role="tab" id={`dash-decision-tab-${d.key}`} aria-controls={`dash-decision-panel-${d.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class={i === 0 ? 'is-active' : ''} data-decision-key={d.key}>{d.tab}</button>
        ))}
      </div>
      {decisions.map((d, i) => (
        <div class={`decision-panel${i === 0 ? ' is-active' : ''}`} id={`dash-decision-panel-${d.key}`} role="tabpanel" aria-labelledby={`dash-decision-tab-${d.key}`} aria-hidden={i === 0 ? 'false' : 'true'} data-decision-panel={d.key}>
          <div class="decision-text">
            <h3>{d.title}</h3>
            <p class="dp"><b>问题</b>{d.problem}</p>
            <p class="dp"><b>设计选择</b>{d.choice}</p>
            <p class="dp trade"><b>为什么这样取舍</b>{d.trade}</p>
          </div>
          <figure class="decision-figure"><img src={d.image} alt={d.alt} loading="lazy" data-lightbox /><figcaption>{d.caption}</figcaption></figure>
        </div>
      ))}
    </section>

    <!-- 04 Demo 故事 -->
    <section class="dark-section" aria-labelledby="story-title">
      <div class="shell story-section reveal">
        <div class="story-copy on-dark">
          <p class="eyebrow">04 / 从组件走向业务故事</p>
          <h2 id="story-title">图表变清楚之后，还需要一条阅读路径</h2>
          <p>汽车用户反馈 Demo 的目标，是监控反馈数据、为产品优化提供依据。原来的图表各自成立，但组合起来缺少顺序。我们先理解主题、目的与核心指标，再把内容重组为逐层下钻的结构。</p>
        </div>
        <ol class="path on-dark">
          <li><b>先看大盘</b><p>从核心指标和变化趋势，知道整体发生了什么。</p></li>
          <li><b>再找差异</b><p>用热门反馈与分维度分析，缩小需要关注的范围。</p></li>
          <li><b>最后看明细</b><p>回到具体反馈，继续查找业务细节。</p></li>
        </ol>
        <figure class="shot-panel on-dark">
          <img src="/dashboard-case/dashboard-hd-13.jpg" width="1920" height="1080" alt="从杂乱动线到逐层下钻的阅读结构原稿" loading="lazy" data-lightbox />
          <figcaption class="on-dark">从杂乱动线，到逐层下钻的阅读结构</figcaption>
        </figure>

        <div class="inspect-head">
          <h3>点击一个设计切入点，把“变好看”说具体</h3>
          <p>视觉设计集中在最影响第一印象与阅读效率的地方：核心指标、趋势与排行，以及头部、指标卡、容器。不是每个组件都装饰，而是按信息重要性分配视觉重量。</p>
        </div>
        <div class="inspect">
          <figure class="shot-panel on-dark inspect-figure">
            <img src={a('汽车反馈成品')} width="1500" height="844" alt="汽车用户反馈仪表盘成品，可点击放大" loading="lazy" data-lightbox />
            <figcaption class="on-dark">汽车用户反馈仪表盘成品</figcaption>
          </figure>
          <div class="inspect-controls" role="group" aria-label="设计切入点">
            {inspects.map((it, i) => (
              <button type="button" class={i === 0 ? 'is-active' : ''} aria-pressed={i === 0 ? 'true' : 'false'} data-inspect-key={it.key} data-inspect-desc={it.desc}>
                <b>{it.title}</b><span>{it.short}</span>
              </button>
            ))}
          </div>
        </div>
        <p class="inspect-desc on-dark" id="dash-inspect-desc" aria-live="polite">{inspects[0].desc}</p>

        <div class="header-compare">
          <figure class="shot-panel on-dark"><img src={a('头部优化前')} alt="头部优化前：仅有标题" loading="lazy" data-lightbox /><figcaption class="on-dark">头部优化前：仅有标题，缺少整体氛围</figcaption></figure>
          <figure class="shot-panel on-dark"><img src={a('头部优化后')} alt="头部优化后：字体、图形、氛围共同组织" loading="lazy" data-lightbox /><figcaption class="on-dark">头部优化后：字体、图形、氛围共同组织</figcaption></figure>
        </div>
        <details class="source-details on-dark-details">
          <summary>看指标卡、容器与行业语言的细节设计</summary>
          <div class="detail-pair">
            <figure class="shot-panel on-dark"><img src={a('指标卡')} alt="信息层级与 mini 环图原稿" loading="lazy" data-lightbox /><figcaption class="on-dark">指标卡：信息层级与 mini 环图</figcaption></figure>
            <figure class="shot-panel on-dark"><img src={a('容器设计')} alt="图表容器视觉语言原稿" loading="lazy" data-lightbox /><figcaption class="on-dark">容器：全局图表强化，分维度图表轻量修饰</figcaption></figure>
          </div>
          <figure class="shot-panel on-dark"><img src={a('行业语言')} alt="汽车行业元素提炼原稿" loading="lazy" data-lightbox /><figcaption class="on-dark">从汽车行业的流线、几何与简洁特征提炼界面语言</figcaption></figure>
        </details>
      </div>
    </section>

    <!-- 05 验证 -->
    <section class="shell story-section reveal" aria-labelledby="result-title">
      <div class="story-copy">
        <p class="eyebrow">05 / 回到同一套标准验证</p>
        <h2 id="result-title">有没有变好，不只靠设计师判断</h2>
        <p>使用真实数据在原环境和测试环境搭建对照看板，先让用户比较差异，再收集维度评分与影响因素。评分用于验证当前改善，问题提及频率则继续指导后续优先级。</p>
      </div>
      <div class="result-grid">
        <div class="score-board">
          <div class="result-title">+16.2%</div>
          <p class="result-sub">24 位测试样本、1 对 1 访谈；图表整体平均分从 <b>6.8 提升至 7.9</b>。</p>
          <div class="score-list">
            {scoreRows.map((row) => (
              <div class="score-row">
                <span class="score-name">{row.name}</span>
                <div class="score-track" aria-label={`${row.name}优化前${row.before}，优化后${row.after}`}>
                  <span class="score-before" style={`width:${row.before * 10}%`}></span>
                  <span class="score-after" style={`width:${row.after * 10}%`}></span>
                </div>
                <span class="score-val">{row.before} → {row.after}</span>
              </div>
            ))}
          </div>
          <p class="score-key">灰色：优化前　蓝色：优化后　·　四维度共用 0–10 分刻度</p>
        </div>
        <aside class="business-stats">
          <div><strong>超出预期</strong><p>多主题 Demo 产出在双月总结中获得项目团队评价。</p></div>
          <div><strong>1600+</strong><p>学习 Demo 材料的用户；原稿记录，未作为签单增长证明。</p></div>
          <div><strong>220+</strong><p>完成学习和看板搭建；采用本轮确认口径。</p></div>
        </aside>
      </div>
      <p class="metric-note">这里能证明的是图表体验评分改善和 Demo 的学习使用反馈，不能据此推导签单率、营收或转化率提升。16.2% 按 (7.9 − 6.8) ÷ 6.8 计算并保留一位小数。</p>
      <div class="principle">
        <span>长期价值</span>
        <p>让一次优化，成为后续可复用的起点：整理图表组件、通用元素与使用说明书供各业务线取用。评估体系负责持续发现问题，设计规范负责减少重复解决问题。</p>
      </div>
      <details class="source-details">
        <summary>看验证过程与图表规范沉淀</summary>
        <div class="detail-pair">
          <figure class="shot-panel"><img src="/dashboard-case/dashboard-hd-10.jpg" width="1920" height="1080" alt="数据收集与结果分析原稿" loading="lazy" data-lightbox /><figcaption>数据收集与结果分析</figcaption></figure>
          <figure class="shot-panel"><img src="/dashboard-case/dashboard-hd-11.jpg" width="1920" height="1080" alt="图表组件和使用说明原稿" loading="lazy" data-lightbox /><figcaption>图表组件和使用说明书</figcaption></figure>
        </div>
      </details>
    </section>

    <div class="shell back-link"><a href="/">返回作品集 <span aria-hidden="true">↗</span></a></div>
  </article>

  <div class="dash-lightbox" id="dash-lightbox" aria-hidden="true">
    <button type="button" class="dash-lightbox-close" id="dash-lightbox-close" aria-label="关闭">×</button>
    <div class="dash-lightbox-body" id="dash-lightbox-body"></div>
  </div>
</BaseLayout>

<script>
  (function () {
    try {
      var reduce = matchMedia('(prefers-reduced-motion: reduce)');

      // 四项图表设计决策切换
      document.querySelectorAll<HTMLElement>('[data-decision-tabs]').forEach(function (tablist) {
        var tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
        var panels = Array.from(document.querySelectorAll<HTMLElement>('[data-decision-panel]'));
        function activate(key: string) {
          tabs.forEach(function (tab) {
            var selected = tab.dataset.decisionKey === key;
            tab.setAttribute('aria-selected', String(selected));
            tab.classList.toggle('is-active', selected);
            tab.tabIndex = selected ? 0 : -1;
          });
          panels.forEach(function (panel) {
            var selected = panel.dataset.decisionPanel === key;
            panel.classList.toggle('is-active', selected);
            panel.setAttribute('aria-hidden', String(!selected));
          });
        }
        tabs.forEach(function (tab, index) {
          tab.addEventListener('click', function () { activate(tab.dataset.decisionKey || ''); });
          tab.addEventListener('keydown', function (event) {
            if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
            event.preventDefault();
            var next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
            activate(tabs[next].dataset.decisionKey || '');
            tabs[next].focus();
          });
        });
      });

      // 仪表盘设计切入点
      var inspectButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-inspect-key]'));
      var inspectDesc = document.getElementById('dash-inspect-desc');
      inspectButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          inspectButtons.forEach(function (b) {
            var selected = b === btn;
            b.classList.toggle('is-active', selected);
            b.setAttribute('aria-pressed', String(selected));
          });
          if (inspectDesc) inspectDesc.textContent = btn.dataset.inspectDesc || '';
        });
      });

      // 原稿灯箱
      var box = document.getElementById('dash-lightbox');
      var bodyEl = document.getElementById('dash-lightbox-body');
      var closeBtn = document.getElementById('dash-lightbox-close');
      function closeBox() { if (!box || !bodyEl) return; box.classList.remove('is-open'); box.setAttribute('aria-hidden', 'true'); bodyEl.innerHTML = ''; }
      document.querySelectorAll<HTMLImageElement>('[data-lightbox]').forEach(function (img) {
        img.style.cursor = 'zoom-in';
        img.addEventListener('click', function () {
          if (!box || !bodyEl) return;
          var clone = img.cloneNode(true) as HTMLImageElement;
          clone.removeAttribute('loading');
          clone.style.cursor = 'default';
          bodyEl.innerHTML = '';
          bodyEl.appendChild(clone);
          box.classList.add('is-open');
          box.setAttribute('aria-hidden', 'false');
        });
      });
      if (closeBtn) closeBtn.addEventListener('click', closeBox);
      if (box) box.addEventListener('click', function (e) { if (e.target === box) closeBox(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeBox(); });

      // 滚动揭示
      var revealEls = Array.from(document.querySelectorAll('.reveal'));
      if (!reduce.matches && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) { entry.target.classList.add('in'); io.unobserve(entry.target); }
          });
        }, { threshold: 0.1 });
        revealEls.forEach(function (el) { io.observe(el); });
      } else {
        revealEls.forEach(function (el) { el.classList.add('in'); });
      }
    } catch (error) {
      console.error(error);
    }
  })();
</script>

<style>
