  <script>
    import { casePreview, videoPoster } from '@/lib/case-media';

    const init = () => {
      const revealPanel = (panel: HTMLElement) => {
        panel.getAnimations().forEach((animation) => animation.cancel());
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        panel.animate([{ opacity: 0 }, { opacity: 1 }], {
          duration: 200,
          easing: 'ease-out',
        });
      };
      document.querySelectorAll<HTMLElement>('.miaoda-paper').forEach((root) => {
        if (root.dataset.ready) return;
        root.dataset.ready = 'true';
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const videoObserver = new IntersectionObserver((entries) => {
          entries.forEach(({ target, isIntersecting }) => {
            const video = target as HTMLVideoElement;
            if (isIntersecting && !reducedMotion.matches) {
              void video.play().catch(() => {});
            } else {
              video.pause();
            }
          });
        }, { threshold: 0.2 });
        const observeVideos = (container: HTMLElement) => {
          container.querySelectorAll('video').forEach((video) => videoObserver.observe(video));
        };
        const createMedia = (name: string, label: string) => {
          const src = '/miaoda-case/' + name;
          if (name.endsWith('.mp4')) {
            const video = document.createElement('video');
            video.className = 'miaoda-video';
            video.src = src;
            video.poster = videoPoster(src);
            video.setAttribute('aria-label', label);
            video.controls = video.muted = video.loop = video.playsInline = true;
            video.preload = 'none';
            return video;
          }
          const image = document.createElement('img');
          image.className = 'miaoda-image';
          image.src = casePreview(src);
          image.alt = label;
          image.loading = 'lazy';
          return image;
        };
        const configs = [
          {
            labels: ['飞书妙搭', '飞书 aPaaS'],
            media: ['background-apaas-01.png', 'background-apaas-02.png'],
            captions: [
              '目标用户：业务人员、产品、运营、数字化负责人，以及没有深厚编程基础、但能说清业务需求的人。产品定位：AI 驱动的应用开发平台，以自然语言描述需求，由 AI 生成并持续修改应用。',
              '目标用户：企业 IT、数字化团队和专业开发者\n产品定位：企业级低代码开发平台，通过可视化配置和少量代码构建内部应用，更侧重复杂流程、权限、集成和长期治理等企业系统需求',
            ],
          },
          {
            labels: ['保持妙搭站点框架', '专业能力扩展'],
            media: ['expert-workspace.png'],
            captions: [
              '入口只增加 PRO 按钮和功能说明，不替换用户熟悉的站点组织与开发起点',
              '',
            ],
          },
          {
            labels: ['消息队列引导', '任务导航'],
            media: ['task-navigation.mp4'],
            captions: ['待执行消息里提供转为并行任务的入口', '任务导航承接任务状态、任务切换与继续对话'],
          },
          {
            labels: ['独立分支，统一管理', '发布支持详细设置'],
            media: ['publish-settings.mp4'],
            captions: ['', '发布详情：查看发布分支、代码变更与环境变量设置'],
          },
        ];
        configs.forEach((config, groupIndex) => {
          const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-case-tab]')).filter((b) =>
            config.labels.includes(b.textContent?.trim() || ''),
          );
          if (!buttons.length) return;
          const buttonRow = buttons[0].parentElement!;
          const list = groupIndex === 0 ? buttonRow.parentElement! : buttonRow;
          list.setAttribute('role', 'tablist');
          list.setAttribute('aria-label', config.labels.join(' / '));
          const panel = document.createElement('div');
          panel.id = 'miaoda-panel-' + groupIndex;
          panel.setAttribute('role', 'tabpanel');
          panel.tabIndex = 0;
          let sibling = list.nextElementSibling;
          while (sibling) {
            const next = sibling.nextElementSibling;
            panel.append(sibling);
            sibling = next;
          }
          list.after(panel);
          const original = Array.from(panel.childNodes);
          let alternate: Node[] | undefined;
          let activeIndex = -1;
          const select = (index: number) => {
            if (index === activeIndex) return;
            const initial = activeIndex === -1;
            activeIndex = index;
            panel.querySelectorAll('video').forEach((video) => {
              video.pause();
              videoObserver.unobserve(video);
            });
            buttons.forEach((b, j) => {
              b.id = 'miaoda-tab-' + groupIndex + '-' + j;
              b.setAttribute('role', 'tab');
              b.setAttribute('aria-controls', panel.id);
              b.setAttribute('aria-selected', String(j === index));
              b.tabIndex = j === index ? 0 : -1;
            });
            panel.setAttribute('aria-labelledby', buttons[index].id);
            if (index === 0) {
              if (!initial) panel.replaceChildren(...original);
            } else if (alternate) {
              panel.replaceChildren(...alternate);
            } else if (config.media[0]?.endsWith('.mp4')) {
              alternate = original.map((node) => node.cloneNode(true));
              panel.replaceChildren(...alternate);
              const video = panel.querySelector('video')!;
              const src = '/miaoda-case/' + config.media[0];
              video.poster = videoPoster(src);
              video.src = src;
              video.setAttribute('aria-label', config.labels[index]);
              panel.querySelector('[data-video-caption]')!.textContent = config.captions[index];
            } else {
              const caption = document.createElement('p');
              caption.className = 'miaoda-media-caption';
              caption.textContent = config.captions[index];
              const items = config.media.map((name, i) =>
                createMedia(name, config.labels[index] + (config.media.length > 1 ? ' ' + (i + 1) : '')),
              );
              if (groupIndex === 0) {
                const pair = document.createElement('div');
                pair.className = 'miaoda-image-pair';
                caption.className = 'text-[13px] leading-[180%] whitespace-pre-line text-[#6A6964]';
                const imageLabels = ['aPaaS 首页', 'aPaaS 开发页'];
                items.forEach((item, i) => {
                  const figure = document.createElement('figure');
                  item.setAttribute('width', '5760');
                  item.setAttribute('height', '3600');
                  item.setAttribute('alt', imageLabels[i]);
                  figure.append(item);
                  pair.append(figure);
                });
                alternate = [caption, pair];
              } else {
                alternate = caption.textContent ? [...items, caption] : items;
              }
              panel.replaceChildren(...alternate);
            }
            observeVideos(panel);
            revealPanel(panel);
          };
          buttons.forEach((b, index) => {
            b.addEventListener('click', () => select(index));
            b.addEventListener('keydown', (event) => {
              let next = index;
              if (event.key === 'ArrowRight') next = (index + 1) % buttons.length;
              else if (event.key === 'ArrowLeft') next = (index - 1 + buttons.length) % buttons.length;
              else if (event.key === 'Home') next = 0;
              else if (event.key === 'End') next = buttons.length - 1;
              else return;
              event.preventDefault();
              select(next);
              buttons[next].focus();
            });
          });
          select(0);
        });
        observeVideos(root);
        const abilities = [
          ['ability-code-review.png', '代码审查：在扩展工作区查看与确认代码变更'],
          ['ability-open-api.png', '开放 API：连接外部系统'],
          ['ability-database.png', '数据库：管理应用数据'],
          ['ability-env-vars.png', '环境变量：配置运行参数'],
        ];
        const cards = Array.from(root.querySelectorAll<HTMLElement>('.h-26\\.25'));
        if (cards.length === 4) {
          const row = cards[0].parentElement!;
          row.setAttribute('role', 'tablist');
          row.setAttribute('aria-label', '专业开发与集成能力');
          const panel = row.nextElementSibling as HTMLElement;
          const image = panel.querySelector('img')!;
          panel.id = 'ability-panel';
          panel.setAttribute('role', 'tabpanel');
          const buttons = cards.map((card, index) => {
            const button = document.createElement('button');
            button.className = card.className + ' ability-tab';
            button.innerHTML = card.innerHTML;
            button.type = 'button';
            button.id = 'ability-tab-' + index;
            button.setAttribute('role', 'tab');
            button.setAttribute('aria-controls', panel.id);
            card.replaceWith(button);
            return button;
          });
          let timer: ReturnType<typeof setTimeout>;
          const selectAbility = (index: number) => {
            clearTimeout(timer);
            buttons.forEach((button, j) => {
              button.setAttribute('aria-selected', String(j === index));
              button.tabIndex = j === index ? 0 : -1;
            });
            panel.setAttribute('aria-labelledby', buttons[index].id);
            const [name, description] = abilities[index];
            image.src = casePreview('/miaoda-case/' + name);
            image.alt = description;
            revealPanel(panel);
            timer = setTimeout(() => selectAbility((index + 1) % 4), 5000);
          };
          buttons.forEach((button, index) => {
            button.addEventListener('click', () => selectAbility(index));
            button.addEventListener('keydown', (event) => {
              let next = index;
              if (event.key === 'ArrowRight') next = (index + 1) % 4;
              else if (event.key === 'ArrowLeft') next = (index + 3) % 4;
              else if (event.key === 'Home') next = 0;
              else if (event.key === 'End') next = 3;
              else return;
              event.preventDefault();
              selectAbility(next);
              buttons[next].focus();
            });
          });
          selectAbility(0);
        }
      });
    };
    init();
    document.addEventListener('astro:page-load', init);
  </script>
  <NextProject slug="miaoda" />
</BaseLayout>
