---
import '@/styles/case-unified.css';
import BaseLayout from '@/layouts/BaseLayout.astro';
const galleries = [
  { key: 'entry', title: '同一个起点，按需进入专家模式', intro: '专业能力从入口开始解释，但不要求每个人都先做一遍专业配置。', images: [ ['entry','熟悉的站点框架：仍从输入需求开始'], ['entry-pro','PRO 入口说明：先说明适用场景，再介绍能力'] ] },
  { key: 'tasks', title: '第二件事出现时，再展开多任务', intro: '并行是可选的补充方式。继续补充当前需求，不必每次都创建新任务。', images: [ ['queue','待执行消息里提供转为并行任务的入口'], ['new-task','进行中任务的输入框提示：支持作为新任务执行'], ['tasks','任务导航承接状态、切换与继续对话'] ] },
  { key: 'git', title: '独立开发，也要知道如何汇合', intro: '把分支、变更与提交记录放进统一管理路径；协作开发与最终发布分别确认。', images: [ ['git-changes','分支管理：当前分支、与源分支的差异、未提交与已提交变更'], ['git-history','提交记录：查看变化来源与历史'] ] },
  { key: 'publish', title: '把发布变成一次有依据的确认', intro: '多分支、多环境不成为每次对话的前置门槛，而是在发布这个影响线上使用的节点集中提示。', images: [ ['publish-branch','发布入口：明确发布分支，提示线上已有新代码'], ['publish-detail','发布详情：汇总代码、数据库变更与环境变量设置'] ] },
  { key: 'data', title: '把数据边界放到数据操作旁', intro: '应用开始被真实用户使用后，开发与线上数据隔离成为继续迭代的必要保障。', images: [ ['data-online','线上环境的显性标识'], ['data-dev','开发环境说明：用于开发与测试，不直接影响线上数据'] ] },
  { key: 'extend', title: '复杂能力有入口，不抢默认工作区', intro: '代码管理、开放 API 与环境变量等能力按需进入；原稿展示了代码审查及数据库扩展入口。', images: [ ['code-review','代码审查：在扩展工作区查看与确认代码变更'], ['extensions','数据库扩展：变更历史、日志、备份恢复与扩展管理'] ] },
];
---
<BaseLayout title="妙搭支持专家模式 · 能力进阶，路径不换" description="在既定整合战略下，以统一应用框架守住简单开发路径，按并行开发、多人协作、数据隔离与外部集成场景逐步展开专业能力。" image="/miaoda-case/workspace.webp" type="article" closing={false}>
<article class="miaoda-case">
  <header class="case-wrap hero">
    <nav aria-label="面包屑"><a href="/">作品案例</a><span aria-hidden="true"> / </span>妙搭支持专家模式</nav>
    <p class="eyebrow">产品整合 / 渐进式专业能力</p>
    <h1>能力可以进阶，<br />熟悉的路径不必重来。</h1>
    <p class="lead">当一个用对话就能开始的应用，逐渐需要并行开发、多人协作和真实数据保护，用户是否必须换一套工具？<br />这次设计把专业能力接进妙搭，而不是把另一套开发工具搬过来。</p>
    <dl class="meta"><div><dt>项目</dt><dd>妙搭支持专家模式</dd></div><div><dt>设计命题</dt><dd>专业用户用得起来，普通用户仍然用得简单</dd></div><div><dt>贡献视角</dt><dd>在既定整合战略下，解决体验落地风险</dd></div></dl>
    <div class="hero-diagram" aria-label="共同简单路径与按需展开的专业能力">
      <div class="path-label">所有人共有的开发主线</div>
      <ol class="main-path"><li>说需求</li><li>看效果</li><li>修改</li><li>发布</li></ol>
      <div class="branch-line">需求变复杂时，能力在同一框架里展开</div>
      <div class="branches"><span>另一件事 → 并行任务</span><span>一起做 → 独立分支</span><span>已有人用 → 数据隔离</span><span>接外部系统 → 扩展能力</span></div>
    </div>
    <figure class="source-figure hero-image"><a class="source-open" href="/miaoda-case/workspace-full.webp"><img src="/miaoda-case/workspace.webp" width="3200" height="2000" alt="以妙搭对话和应用工作区为基础扩展的专业开发界面" fetchpriority="high" /><span class="zoom-label">查看原尺寸原稿</span></a><figcaption>沿用对话与应用工作区；代码编辑器是可进入的能力，不替代共同的开发路径。首屏仅裁去原图外侧黑色留白，放大查看保留完整原稿。</figcaption></figure>
  </header>

  <section class="case-wrap section" id="background">
    <h2>项目背景</h2>
    <p class="copy">这次整合有两类不同的诉求：公司侧希望更有效地做产品、卖产品；用户侧希望同一个应用从简单开始，走到复杂需求时仍能继续。</p>
    <div class="two-col background-pair"><div><h3>公司侧的收益：让产品形成合力</h3><p>统一品牌与商业化，减少重复的底层建设，推动能力复用，并降低两条产品线之间的组织协同成本。它解决的是“公司怎么更有效地做产品、卖产品”。</p></div><div><h3>用户侧的连续性：同一个应用继续成长</h3><p>先用简单对话开始，后续需要异步任务、开发与生产数据隔离等能力时，仍能在同一个应用里继续，而不用换到另一款产品。</p></div></div>
  </section>

  <section class="case-wrap section objectives" id="objectives">
    <p class="eyebrow">价值验证</p><h2>在既定整合战略下，<br />我解决哪些体验风险，让目标可落地？</h2>
    <p class="copy">这里的价值验证聚焦设计贡献：不是重新证明整合战略，而是把战略落到用户能够理解、继续操作的体验中。</p>
    <p class="thesis">目标：<strong>专业用户用得起来，普通用户仍然用得简单。</strong></p>
    <div class="two-col goal-pair"><div><h3>守住简单路径</h3><p>保留熟悉的应用框架，让“说需求 → 看效果 → 修改 → 发布”不增加非必要步骤和概念。</p></div><div><h3>建立进阶路径</h3><p>当并行开发、多人协作、数据隔离或外部集成需求出现时，提供可发现、可理解、可完成的操作路径。</p></div></div>
  </section>

  <section class="dark-section" id="simple"><div class="case-wrap section">
    <p class="eyebrow">1 · 守住简单路径</p><h2>保留统一的应用框架，<br />不是把另一套开发工具直接搬过来。</h2>
    <h3 class="structure-label">设计挑战</h3><p class="copy">整合不仅要承接专业能力，也要避免把原 4.0 的界面和操作逻辑直接搬进妙搭，让用户为了继续开发，被迫学习一套新的工具。</p>
    <h3 class="structure-label">设计策略</h3><p class="copy">保持妙搭站点框架，仅在入口侧提供 PRO 按钮及功能说明；专业开发能力均以妙搭应用开发界面为基础扩展。</p>
    <div class="rules"><div><b>保持站点框架</b><p>入口只增加 PRO 按钮和功能说明，不替换用户熟悉的站点组织与开发起点。</p></div><div><b>沿用应用开发界面</b><p>专业能力在妙搭原有应用开发界面上扩展，不把另一套工具的操作逻辑直接搬过来。</p></div><div><b>多任务侧边栏默认收起</b><p>按需展开任务导航，并记录用户的使用习惯，保留日常对话与应用工作区。</p></div><div><b>代码 / Git / API 作为二级入口</b><p>专业工具按需进入，不成为整个界面的中心。</p></div></div>
    <p class="copy">涉及多数据环境和多分支时，在发布节点提示，让复杂概念在需要作决定时出现。</p>
    <div class="gallery" data-gallery="entry">
      <div class="tabs" role="tablist" aria-label="专家模式入口原稿"><button id="entry-tab-0" role="tab" aria-selected="true" aria-controls="entry-panel-0" tabindex="0" data-tab="0">共同起点</button><button id="entry-tab-1" role="tab" aria-selected="false" aria-controls="entry-panel-1" tabindex="-1" data-tab="1">展开 PRO 说明</button></div>
      {galleries[0].images.map(([name,caption],i)=><div id={`entry-panel-${i}`} role="tabpanel" aria-labelledby={`entry-tab-${i}`} data-panel={i} hidden={i!==0}><figure class="source-figure"><a class="source-open" href={`/miaoda-case/${name}-full.webp`}><img src={`/miaoda-case/${name}.webp`} width="3200" height="2000" loading="lazy" alt={caption}/><span class="zoom-label">查看原稿</span></a><figcaption>{caption}</figcaption></figure></div>)}
    </div>
    <h3 class="structure-label result-label">设计结果</h3><p class="takeaway">专业用户加入已有产品框架，<br />用户仍沿用熟悉的开发路径：说需求 → 看效果 → 修改 → 发布。</p>
  </div></section>

  <section class="case-wrap section" id="scenarios">
    <p class="eyebrow">2 · 建立进阶路径</p><h2>按场景引入复杂度，<br />不是一次展示所有专业能力。</h2>
    <h3 class="structure-label">设计挑战</h3><p class="copy">如果用户刚开始开发，就要选择任务、迭代和数据库环境，会把学习成本放在用户还没理解价值的时候，也不符合实际操作动线。</p>
    <h3 class="structure-label">设计策略</h3><p class="copy">以共同的简单开发路径为基础，围绕并行开发、多人协作、数据安全和外部集成场景，逐步展开进阶操作。</p>
    <nav class="path-index" aria-label="四条进阶路径"><a href="#scene-panel-0">1 想同时处理另一件事</a><a href="#scene-panel-1">2 明确修改与发布版本</a><a href="#scene-panel-2">3 修改不影响真实数据</a><a href="#scene-panel-3">4 进阶开发与集成</a></nav>
    <div class="scenario-explorer">
      <section class="progressive-path" id="scene-panel-0">
        <div class="scene-copy"><p class="path-number">进阶路径 1 · 想同时处理另一件事</p><h3>从等待执行，到并行推进</h3><p>在用户有进行中任务时，输入框提示可以作为新任务执行；消息队列中提供新建任务引导。在对话与应用工作区旁增加任务导航，支持查看状态、切换任务和继续对话。</p><p class="scene-tradeoff"><b>设计取舍：</b>并行是可选的补充方式，不把每次需求补充都变成新任务。</p></div>
        <div class="task-demo" id="task-demo"><p class="demo-note">交互示意 · 演示任务组织方式，不连接真实 Agent</p><div class="demo-body"><div class="task-list"><div class="task-current">当前任务<br /><b>完善应用首页</b><span>进行中</span></div><div class="task-new" hidden>独立任务<br /><b>增加详情页面</b><span>并行推进</span></div></div><div class="demo-chat"><p>还有一个需求：增加详情页面。</p><div class="demo-actions"><button data-task-action="continue" aria-pressed="true">继续当前任务</button><button data-task-action="parallel" aria-pressed="false">作为新任务</button></div><p id="task-feedback" role="status">保留在当前对话中，等待当前任务继续处理；任务导航没有增加新任务。</p></div></div></div>
        <div class="gallery" data-gallery="tasks"><div class="tabs" role="tablist" aria-label="并行开发原稿">{galleries[1].images.map(([,caption],i)=><button id={`tasks-tab-${i}`} role="tab" aria-selected={i===0?'true':'false'} aria-controls={`tasks-panel-${i}`} tabindex={i===0?0:-1} data-tab={i}>{['消息队列引导','输入框提示','任务导航'][i]}</button>)}</div>{galleries[1].images.map(([name,caption],i)=><div id={`tasks-panel-${i}`} role="tabpanel" aria-labelledby={`tasks-tab-${i}`} data-panel={i} hidden={i!==0}><figure class="source-figure"><a class="source-open" href={`/miaoda-case/${name}-full.webp`}><img src={`/miaoda-case/${name}.webp`} width="3200" height="2000" loading="lazy" alt={caption}/><span class="zoom-label">查看原稿</span></a><figcaption>{caption}</figcaption></figure></div>)}</div>
      </section>
      <section class="progressive-path" id="scene-panel-1">
        <div class="scene-copy"><p class="path-number">进阶路径 2 · 多人协作下，明确修改与发布版本</p><h3>支持独立开发，也说清哪一版走向线上</h3><p>支持独立分支协作开发和统一管理。发布时查看发布分支，并提供发布详情，包含代码变更、环境变量设置等信息。</p><p class="scene-tradeoff"><b>设计取舍：</b>开发时能各自推进，发布时再集中核对版本与影响，而不是每次对话都增加版本管理步骤。</p></div>
        <ol class="collab-flow"><li><b>独立开发</b><span>在各自分支推进修改</span></li><li><b>查看变化</b><span>对照分支与提交记录</span></li><li><b>发布确认</b><span>核对分支、代码及环境设置</span></li></ol>
        {[galleries[2],galleries[3]].map(g=><div class="gallery" data-gallery={g.key}><h4>{g.title}</h4><div class="tabs" role="tablist" aria-label={g.title}>{g.images.map(([,caption],i)=><button id={`${g.key}-tab-${i}`} role="tab" aria-selected={i===0?'true':'false'} aria-controls={`${g.key}-panel-${i}`} tabindex={i===0?0:-1} data-tab={i}>{g.key==='git'?['分支与变更','提交记录'][i]:['发布分支','发布详情'][i]}</button>)}</div>{g.images.map(([name,caption],i)=><div id={`${g.key}-panel-${i}`} role="tabpanel" aria-labelledby={`${g.key}-tab-${i}`} data-panel={i} hidden={i!==0}><figure class="source-figure"><a class="source-open" href={`/miaoda-case/${name}-full.webp`}><img src={`/miaoda-case/${name}.webp`} width="3200" height="2000" loading="lazy" alt={caption}/><span class="zoom-label">查看原稿</span></a><figcaption>{caption}</figcaption></figure></div>)}</div>)}
      </section>
      <section class="progressive-path" id="scene-panel-2">
        <div class="scene-copy"><p class="path-number">进阶路径 3 · 应用有人用，后续修改怕影响真实数据</p><h3>开发时独立测试，线上继续使用真实数据</h3><p>当应用进入实际使用阶段，引入开发与线上数据隔离：开发时在独立环境中测试，线上用户继续使用真实数据。</p><p class="scene-tradeoff"><b>设计取舍：</b>不让用户在创作起点提前学习所有环境概念；实际使用阶段，则在数据操作旁明确当前环境及其影响边界。</p></div>
        <div class="environment-demo" id="environment-demo"><p class="demo-note">交互示意 · 下方只有本页内存中的示例记录，不触及真实数据库</p><div class="env-actions"><button id="test-write">在开发环境添加测试记录</button><button id="test-reset">重置演示</button></div><div class="two-col"><div class="env-box dev"><span>开发环境</span><h4>开发与测试</h4><ul id="dev-records"><li>示例记录 A</li><li>示例记录 B</li></ul></div><div class="env-box production"><span>线上环境</span><h4>真实使用继续</h4><ul id="online-records"><li>示例记录 A</li><li>示例记录 B</li></ul></div></div><p id="env-feedback" role="status">两侧各有两条示例记录。点击测试写入，观察哪一侧改变。</p></div>
        <div class="gallery" data-gallery="data"><div class="tabs" role="tablist" aria-label="数据环境原稿"><button id="data-tab-0" role="tab" aria-selected="true" aria-controls="data-panel-0" tabindex="0" data-tab="0">线上标识</button><button id="data-tab-1" role="tab" aria-selected="false" aria-controls="data-panel-1" tabindex="-1" data-tab="1">开发环境说明</button></div>{galleries[4].images.map(([name,caption],i)=><div id={`data-panel-${i}`} role="tabpanel" aria-labelledby={`data-tab-${i}`} data-panel={i} hidden={i!==0}><figure class="source-figure"><a class="source-open" href={`/miaoda-case/${name}-full.webp`}><img src={`/miaoda-case/${name}.webp`} width="3200" height="2000" loading="lazy" alt={caption}/><span class="zoom-label">查看原稿</span></a><figcaption>{caption}</figcaption></figure></div>)}</div>
      </section>
      <section class="progressive-path" id="scene-panel-3">
        <div class="scene-copy"><p class="path-number">进阶路径 4 · 支持进阶开发与集成能力</p><h3>统一收纳专业能力，需要时再进入</h3><p>将非日常必需的代码管理、开放 API、环境变量等能力收纳到统一扩展入口，保持默认工作区简洁。当用户需要管理代码、连接外部系统或配置运行参数时，再按需进入。</p><p class="scene-tradeoff"><b>设计取舍：</b>默认不展示全部能力，但需要时必须可发现、可理解、可完成。</p></div>
        <div class="capability-paths"><div><span>管理代码</span><b>扩展入口 → 代码 / Git</b></div><div><span>连接外部系统</span><b>扩展入口 → 开放 API</b></div><div><span>配置运行参数</span><b>扩展入口 → 环境变量</b></div></div>
        <p class="note">能力路径为依据项目叙述整理的示意；以下原稿提供代码审查与数据库扩展的界面证据，不替代尚未提供的 API 配置细节。</p>
        <div class="gallery" data-gallery="extend"><div class="tabs" role="tablist" aria-label="扩展能力原稿"><button id="extend-tab-0" role="tab" aria-selected="true" aria-controls="extend-panel-0" tabindex="0" data-tab="0">代码审查</button><button id="extend-tab-1" role="tab" aria-selected="false" aria-controls="extend-panel-1" tabindex="-1" data-tab="1">数据库扩展入口</button></div>{galleries[5].images.map(([name,caption],i)=><div id={`extend-panel-${i}`} role="tabpanel" aria-labelledby={`extend-tab-${i}`} data-panel={i} hidden={i!==0}><figure class="source-figure"><a class="source-open" href={`/miaoda-case/${name}-full.webp`}><img src={`/miaoda-case/${name}.webp`} width="3200" height="2000" loading="lazy" alt={caption}/><span class="zoom-label">查看原稿</span></a><figcaption>{caption}</figcaption></figure></div>)}</div>
      </section>
    </div>
    <h3 class="structure-label result-label">设计结果</h3><p class="takeaway">不要求用户提前学习所有专业能力，<br />而是在具体需求出现时，提供清晰、可完成的进阶路径。</p>
  </section>

  <section class="case-wrap evidence-summary" id="value">
    <p class="note">资料说明：以上为设计方案及界面原稿的呈现，不外推未提供的上线业务收益。</p>
  </section>
  <section class="case-wrap closing"><h2>让专业能力成为下一步，<br />而不是第一步的门槛。</h2><p class="copy">复杂度没有消失；设计决定它在什么时候出现、为什么出现，以及用户能否顺着已有路径完成它。</p><a href="/" class="return-link">返回作品案例</a></section>
</article>
<dialog id="miaoda-lightbox" aria-label="查看完整设计原稿"><div class="lightbox-toolbar"><span>原尺寸原稿 · 可滚动查看细节</span><button id="miaoda-fit" aria-pressed="false">原尺寸查看</button><button id="miaoda-close" aria-label="关闭原稿">关闭</button></div><div class="lightbox-scroll"><img id="miaoda-full-image" alt="完整设计原稿" /></div></dialog>
<style>
.miaoda-case{--case-bg:#f5f7fa;--case-ink:#111827;--case-muted:#566477;--case-blue:#1558d6;--case-line:#dce3ed;--case-night:#0f1a2b;--case-soft:#eaf1ff;--case-white:#fff;background:var(--case-bg);color:var(--case-ink);font-family:'PingFang SC','Microsoft YaHei',sans-serif}.miaoda-case *{box-sizing:border-box}.case-wrap{width:min(1120px,calc(100% - 40px));margin-inline:auto}.hero{padding:40px 0 0}nav{font-size:14px;color:var(--case-muted)}nav a:hover{text-decoration:underline}.eyebrow{color:var(--case-blue);font-size:14px;margin:40px 0 18px;font-weight:600}h1{font-size:clamp(36px,4.8vw,68px);line-height:1.2;letter-spacing:-.045em;font-weight:650;margin:0}h2{font-size:clamp(28px,3.2vw,44px);line-height:1.35;letter-spacing:-.035em;margin:0 0 24px;font-weight:600}h3{font-size:22px;line-height:1.45;margin:0 0 12px}h4{font-size:19px;margin:0 0 14px}.lead{font-size:18px;line-height:1.95;max-width:840px;color:var(--case-muted);margin:28px 0}.copy{max-width:820px;font-size:16px;line-height:1.95;color:var(--case-muted);margin:0 0 30px}p{overflow-wrap:break-word}.meta{display:grid;gap:20px;border-block:1px solid var(--case-line);padding:24px 0;margin:36px 0}dt{font-size:14px;color:var(--case-muted);margin-bottom:9px}dd{margin:0;font-size:15px;line-height:1.8}.hero-diagram{padding:24px 20px;background:var(--case-white);border:1px solid var(--case-line);border-radius:16px;margin:32px 0}.path-label{font-size:14px;color:var(--case-muted);margin-bottom:14px}.main-path{list-style:none;display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:0;padding:0}.main-path li{background:var(--case-soft);color:var(--case-blue);padding:18px;font-size:20px;font-weight:600;text-align:center;border-radius:8px}.branch-line{font-size:14px;color:var(--case-muted);margin:24px 0 12px;padding-top:20px;border-top:1px dashed var(--case-line)}.branches{display:grid;gap:10px;font-size:14px}.branches span{padding:12px;border:1px solid var(--case-line);border-radius:6px}.source-figure{margin:20px 0 0}.source-open{display:block;position:relative;background:var(--case-white);border:1px solid var(--case-line);border-radius:12px;overflow:hidden}.source-open img{display:block;width:100%;height:auto}.source-open:hover{outline:2px solid var(--case-blue);outline-offset:2px}.zoom-label{position:absolute;right:12px;bottom:12px;background:var(--case-night);color:var(--case-white);padding:8px 12px;border-radius:7px;font-size:14px}.source-figure figcaption{font-size:14px;line-height:1.8;color:var(--case-muted);margin:12px 0 0}.hero-image{margin-top:32px}.section{padding-block:64px}.section>.eyebrow{margin-top:0}.two-col{display:grid;gap:20px}.background-pair>div{padding:26px;background:var(--case-white);border:1px solid var(--case-line);border-radius:12px}.background-pair p{font-size:16px;line-height:1.9;color:var(--case-muted)}.note,.demo-note{font-size:14px;line-height:1.75;color:var(--case-muted)}.thesis{border-block:1px solid var(--case-line);font-size:clamp(21px,2.6vw,30px);line-height:1.75;margin:34px 0 0;padding:28px 0}.thesis strong{font-weight:600}.dark-section{background:var(--case-night);color:var(--case-white)}.dark-section .copy,.dark-section .note,.dark-section figcaption,.dark-section .rules p{color:#bdcadd}.dark-section .eyebrow{color:#94baff}.rules{display:grid;gap:20px;margin:32px 0}.rules>div{border-top:1px solid #344056;padding-top:18px}.rules b{font-size:18px;font-weight:600}.rules p{font-size:15px;line-height:1.85;margin-bottom:0}.tabs{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0 14px}button{cursor:pointer;min-height:44px;font:inherit;font-size:14px;border:1px solid var(--case-line);background:var(--case-white);color:var(--case-ink);border-radius:8px;padding:10px 16px;line-height:1.4}button:focus-visible,a:focus-visible{outline:3px solid #83b3ff;outline-offset:3px}button[aria-selected="true"],button[aria-pressed="true"]{background:var(--case-blue);border-color:var(--case-blue);color:var(--case-white)}.dark-section .tabs button{background:#1b2c45;color:var(--case-white);border-color:#344056}.dark-section .tabs button[aria-selected="true"]{background:var(--case-blue)}.takeaway{font-size:26px;line-height:1.6;margin:32px 0 0}.scenario-tabs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.scenario-tabs button{text-align:left;padding:18px 14px;background:var(--case-white);min-width:0}.scenario-tabs button span{display:block;font-size:14px;margin-bottom:10px}.scenario-tabs button b{font-size:18px;font-weight:600}.scenario-tabs button[aria-selected="true"]{background:var(--case-blue)}.scene-copy{padding:28px 0 6px}.scene-copy p{font-size:16px;line-height:1.9;color:var(--case-muted);margin:12px 0}.scene-tradeoff{padding:16px 20px;background:var(--case-soft);border-radius:8px}.task-demo,.environment-demo{background:var(--case-white);padding:20px;border:1px solid var(--case-line);border-radius:12px;margin:18px 0 30px}.demo-note{margin-top:0}.demo-body{display:grid;gap:18px}.task-list{background:var(--case-bg);padding:16px;border-radius:8px;font-size:14px}.task-list b{display:block;line-height:1.8;font-size:16px}.task-list span{display:inline-block;margin-top:8px;background:var(--case-soft);color:var(--case-blue);border-radius:4px;padding:4px 8px}.task-new{margin-top:18px;padding-top:18px;border-top:1px solid var(--case-line)}.demo-chat>p:first-child{background:var(--case-soft);padding:20px;margin:0 0 18px;font-size:16px}.demo-actions,.env-actions{display:flex;flex-wrap:wrap;gap:10px}.demo-chat [role="status"],#env-feedback{font-size:15px;line-height:1.9;color:var(--case-muted)}.collab-flow{display:grid;list-style:none;padding:0;margin:22px 0 30px;gap:12px}.collab-flow li{padding:22px;background:var(--case-soft);border-radius:8px}.collab-flow b,.collab-flow span{display:block}.collab-flow span{margin-top:8px;font-size:14px;color:var(--case-muted)}.gallery{margin-top:26px}.env-box{padding:22px;background:var(--case-bg);border:1px solid var(--case-line);border-radius:8px;margin-top:20px}.env-box>span{display:inline-block;font-size:14px;padding:5px 9px;margin-bottom:12px;background:var(--case-soft);color:var(--case-blue);border-radius:5px}.env-box.production>span{background:#e5f1e8;color:#205d3f}.env-box ul{padding-left:20px;margin-bottom:0;line-height:2;font-size:15px}.capability-paths{display:grid;gap:12px;margin-bottom:20px}.capability-paths div{padding:20px;background:var(--case-white);border:1px solid var(--case-line);border-radius:8px}.capability-paths span,.capability-paths b{display:block}.capability-paths span{font-size:14px;color:var(--case-muted);margin-bottom:8px}.capability-paths b{font-size:16px;font-weight:500}.risk-ledger>div{display:grid;gap:12px;border-top:1px solid #344056;padding:24px 0}.risk-ledger p{font-size:15px;line-height:1.8;margin:0}.risk-ledger span{display:block;font-size:14px;color:#94baff;margin-bottom:8px}.risk-ledger b{font-size:18px;font-weight:500}.evidence-boundary{font-size:15px;line-height:1.9;padding:24px;background:#1b2c45;border-radius:8px;color:#bdcadd}.evidence-boundary b{color:var(--case-white)}.closing{padding:64px 0 80px}.return-link{display:inline-flex;min-height:44px;align-items:center;border-bottom:1px solid var(--case-line);font-size:16px}[hidden]{display:none!important}
#miaoda-lightbox{width:96vw;max-width:1800px;max-height:92vh;padding:0;border:0;border-radius:12px;background:#0f1a2b;color:#fff}#miaoda-lightbox::backdrop{background:#050a14d9}.lightbox-toolbar{display:flex;align-items:center;flex-wrap:wrap;gap:12px;padding:14px 18px;font-size:14px}.lightbox-toolbar span{flex:1}.lightbox-toolbar button{font-size:14px;padding:10px 14px}.lightbox-scroll{overflow:auto;max-height:calc(92vh - 85px);background:#fff}.lightbox-scroll img{display:block;width:100%;height:auto;max-width:none}.lightbox-scroll.is-native img{width:auto}
@media(min-width:768px){.case-wrap{width:min(1120px,calc(100% - 80px))}.hero{padding-top:56px}.meta{grid-template-columns:1fr 1.4fr 1.4fr}.main-path{grid-template-columns:repeat(4,1fr);gap:26px}.main-path li{position:relative}.main-path li:not(:last-child):after{content:'→';position:absolute;right:-23px;color:var(--case-muted);font-size:18px;top:20px}.branches{grid-template-columns:repeat(4,1fr)}.section{padding-block:90px}.two-col,.rules{grid-template-columns:repeat(2,minmax(0,1fr))}.scenario-tabs{grid-template-columns:repeat(4,minmax(0,1fr))}.demo-body{grid-template-columns:230px 1fr}.collab-flow{grid-template-columns:repeat(3,1fr)}.capability-paths{grid-template-columns:repeat(3,1fr)}.risk-ledger>div{grid-template-columns:1fr 1fr 1.4fr;gap:30px}.closing{padding-block:80px 100px}.zoom-label{opacity:0;transition:opacity .2s}.source-open:hover .zoom-label,.source-open:focus .zoom-label{opacity:1}}
.structure-label{font-size:16px;color:var(--case-blue);font-weight:600;margin-top:30px;margin-bottom:14px}.dark-section .structure-label{color:#94baff}.result-label{margin-top:40px;padding-top:24px;border-top:1px solid var(--case-line)}.dark-section .result-label{border-color:#344056}.goal-pair{margin-top:28px}.goal-pair>div{padding-block:20px}.goal-pair p{font-size:16px;line-height:1.9;color:var(--case-muted)}.objectives{padding-top:0}.path-index{display:flex;flex-wrap:wrap;gap:8px;margin:30px 0 0}.path-index a{display:flex;align-items:center;min-height:44px;padding:10px 16px;background:var(--case-white);border:1px solid var(--case-line);border-radius:8px;color:var(--case-blue);font-size:14px}.path-index a:hover{text-decoration:underline}.progressive-path{scroll-margin-top:100px;padding:30px 0 50px;border-bottom:1px solid var(--case-line)}.scene-copy .path-number{font-size:16px;color:var(--case-blue);font-weight:600;margin-bottom:14px}.evidence-summary{padding-top:0}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
</style>
<script>
(() => {
  try {
    const root = document.querySelector<HTMLElement>('.miaoda-case');
    if (!root) return;
    root.querySelectorAll<HTMLElement>('[data-gallery]').forEach(group => {
      const tabs = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-tab]')).filter(tab => tab.closest('[data-gallery]') === group);
      const panels = Array.from(group.querySelectorAll<HTMLElement>('[data-panel]')).filter(panel => panel.closest('[data-gallery]') === group);
      const select = (key: string) => {
        tabs.forEach(tab => { const active=tab.dataset.tab===key; tab.setAttribute('aria-selected',String(active)); tab.tabIndex=active?0:-1; });
        panels.forEach(panel => { panel.hidden=panel.dataset.panel!==key; });
      };
      tabs.forEach((tab,index) => {
        tab.addEventListener('click',()=>select(tab.dataset.tab || '0'));
        tab.addEventListener('keydown',event=>{
          let next=index;
          if(event.key==='ArrowRight') next=(index+1)%tabs.length;
          else if(event.key==='ArrowLeft') next=(index-1+tabs.length)%tabs.length;
          else if(event.key==='Home') next=0;
          else if(event.key==='End') next=tabs.length-1;
          else return;
          event.preventDefault(); select(tabs[next].dataset.tab || '0'); tabs[next].focus();
        });
      });
    });
    root.querySelectorAll<HTMLButtonElement>('[data-task-action]').forEach(button=>button.addEventListener('click',()=>{
      const parallel=button.dataset.taskAction==='parallel';
      const task=root.querySelector<HTMLElement>('.task-new');
      const feedback=document.getElementById('task-feedback');
      if(task) task.hidden=!parallel;
      root.querySelectorAll<HTMLButtonElement>('[data-task-action]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
      if(feedback) feedback.textContent=parallel?'增加详情页面已成为独立任务；原任务保留自己的对话，新任务可以并行推进。':'保留在当前对话中，等待当前任务继续处理；任务导航没有增加新任务。';
    }));
    let testCount=0;
    const dev=document.getElementById('dev-records');
    const envFeedback=document.getElementById('env-feedback');
    document.getElementById('test-write')?.addEventListener('click',()=>{
      if(!dev || !envFeedback) return;
      if(testCount>=3){envFeedback.textContent='演示已添加三条测试记录。线上示例记录始终未变；可重置重新观察。';return;}
      testCount++;const li=document.createElement('li');li.textContent=`测试记录 ${testCount}`;li.dataset.test='true';dev.appendChild(li);
      envFeedback.textContent=`测试记录只进入开发环境。线上两条示例记录没有变化。`;
    });
    document.getElementById('test-reset')?.addEventListener('click',()=>{dev?.querySelectorAll('[data-test]').forEach(li=>li.remove());testCount=0;if(envFeedback) envFeedback.textContent='已重置。两侧各有两条示例记录，可以再次观察测试写入。';});
    const dialog=document.getElementById('miaoda-lightbox') as HTMLDialogElement|null;
    const image=document.getElementById('miaoda-full-image') as HTMLImageElement|null;
    const scroll=dialog?.querySelector<HTMLElement>('.lightbox-scroll');
    const fit=document.getElementById('miaoda-fit');
    let previousFocus:HTMLElement|null=null;
    root.querySelectorAll<HTMLAnchorElement>('.source-open').forEach(link=>link.addEventListener('click',event=>{
      if(!dialog || !image || typeof dialog.showModal!=='function')return;
      event.preventDefault();previousFocus=link;image.src=link.href;image.alt=link.querySelector('img')?.alt || '完整设计原稿';scroll?.classList.remove('is-native');fit?.setAttribute('aria-pressed','false');if(fit)fit.textContent='原尺寸查看';dialog.showModal();
    }));
    document.getElementById('miaoda-close')?.addEventListener('click',()=>dialog?.close());
    fit?.addEventListener('click',()=>{const native=scroll?.classList.toggle('is-native') || false;fit.setAttribute('aria-pressed',String(native));fit.textContent=native?'适应宽度':'原尺寸查看';});
    dialog?.addEventListener('close',()=>{if(image)image.removeAttribute('src');previousFocus?.focus();});
    dialog?.addEventListener('click',event=>{if(event.target===dialog){const r=dialog.getBoundingClientRect();if(event.clientX<r.left || event.clientX>r.right || event.clientY<r.top || event.clientY>r.bottom)dialog.close();}});
  } catch(error) { console.error('妙搭案例交互初始化失败',error); }
})();
</script>
</BaseLayout>
