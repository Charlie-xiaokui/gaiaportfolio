  <script>
    const init = () => {
      const revealPanel = (panel: HTMLElement) => {
        panel.getAnimations().forEach((animation) => animation.cancel());
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        panel.animate([{ opacity: 0 }, { opacity: 1 }], {
          duration: 200,
          easing: 'ease-out',
        });
      };
      document.querySelectorAll<HTMLElement>('.miaoda-paper').forEach((root) => {
        if (root.dataset.ready) return;
        root.dataset.ready = 'true';
        const configs = [
          {
            labels: ['飞书妙搭', '飞书 aPaaS'],
            captions: [
              '目标用户：业务人员、产品、运营、数字化负责人，以及没有深厚编程基础、但能说清业务需求的人。产品定位：AI 驱动的应用开发平台，以自然语言描述需求，由 AI 生成并持续修改应用。',
              '飞书 aPaaS：面向专业开发场景，承接更复杂的应用开发与管理需求。',
            ],
          },
          {
            labels: ['保持妙搭站点框架', '专业能力扩展'],
            captions: [
              '入口只增加 PRO 按钮和功能说明，不替换用户熟悉的站点组织与开发起点',
              '多任务侧边栏默认收起，并记录用户习惯；代码编辑器 / Git / API 作为二级入口；多数据环境和多分支在发布时提示',
            ],
          },
          {
            labels: ['消息队列引导', '任务导航'],
            captions: ['待执行消息里提供转为并行任务的入口', '任务导航承接任务状态、任务切换与继续对话'],
          },
          {
            labels: ['发布分支', '发布详情'],
            captions: ['发布入口：明确发布分支，提示线上已有新代码', '发布详情：汇总代码、数据库变更与环境变量设置'],
          },
        ];
        configs.forEach((config, groupIndex) => {
          const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-case-tab]')).filter((b) =>
            config.labels.includes(b.textContent?.trim() || ''),
          );
          if (!buttons.length) return;
          const buttonRow = buttons[0].parentElement!;
          const list = groupIndex === 0 ? buttonRow.parentElement! : buttonRow;
          list.setAttribute('role', 'tablist');
          list.setAttribute('aria-label', config.labels.join(' / '));
          const panel = document.createElement('div');
          panel.id = 'miaoda-panel-' + groupIndex;
          panel.setAttribute('role', 'tabpanel');
          panel.tabIndex = 0;
          let sibling = list.nextElementSibling;
          while (sibling) {
            const next = sibling.nextElementSibling;
            panel.append(sibling);
            sibling = next;
          }
          list.after(panel);
          const original = panel.innerHTML;
          const select = (index: number) => {
            buttons.forEach((b, j) => {
              b.id = 'miaoda-tab-' + groupIndex + '-' + j;
              b.setAttribute('role', 'tab');
              b.setAttribute('aria-controls', panel.id);
              b.setAttribute('aria-selected', String(j === index));
              b.tabIndex = j === index ? 0 : -1;
            });
            panel.setAttribute('aria-labelledby', buttons[index].id);
            if (index === 0) {
              panel.innerHTML = original;
            } else {
              panel.replaceChildren();
              const placeholder = document.createElement('div');
              placeholder.dataset.placeholder = '';
              placeholder.setAttribute('aria-label', config.labels[index] + '界面占位图');
              const caption = document.createElement('p');
              caption.textContent = config.captions[index];
              caption.style.cssText = 'font-size:14px;line-height:1.8;text-align:center;margin-top:16px;color:inherit';
              panel.append(placeholder, caption);
            }
            revealPanel(panel);
          };
          buttons.forEach((b, index) => {
            b.addEventListener('click', () => select(index));
            b.addEventListener('keydown', (event) => {
              let next = index;
              if (event.key === 'ArrowRight') next = (index + 1) % buttons.length;
              else if (event.key === 'ArrowLeft') next = (index - 1 + buttons.length) % buttons.length;
              else if (event.key === 'Home') next = 0;
              else if (event.key === 'End') next = buttons.length - 1;
              else return;
              event.preventDefault();
              select(next);
              buttons[next].focus();
            });
          });
          select(0);
        });
        const labels = ['代码审查', '开放 API', '数据库', '环境变量'];
        const cards = Array.from(root.querySelectorAll<HTMLElement>('.h-26\\.25'));
        if (cards.length === 4) {
          const row = cards[0].parentElement!;
          row.setAttribute('role', 'tablist');
          row.setAttribute('aria-label', '专业开发与集成能力');
          const panel = row.nextElementSibling as HTMLElement;
          panel.id = 'ability-panel';
          panel.setAttribute('role', 'tabpanel');
          const buttons = cards.map((card, index) => {
            const button = document.createElement('button');
            button.className = card.className + ' ability-tab';
            button.innerHTML = card.innerHTML;
            button.type = 'button';
            button.id = 'ability-tab-' + index;
            button.setAttribute('role', 'tab');
            button.setAttribute('aria-controls', panel.id);
            card.replaceWith(button);
            return button;
          });
          let timer: ReturnType<typeof setTimeout>;
          const selectAbility = (index: number) => {
            clearTimeout(timer);
            buttons.forEach((button, j) => {
              button.setAttribute('aria-selected', String(j === index));
              button.tabIndex = j === index ? 0 : -1;
            });
            panel.setAttribute('aria-labelledby', buttons[index].id);
            panel.replaceChildren();
            const placeholder = document.createElement('div');
            placeholder.dataset.placeholder = '';
            placeholder.setAttribute('aria-label', labels[index] + '界面占位图');
            const caption = document.createElement('p');
            caption.textContent = labels[index] + '：界面示意图待补充';
            caption.style.cssText = 'text-align:center;font-size:14px;margin-top:16px;color:#6a6964';
            panel.append(placeholder, caption);
            revealPanel(panel);
            timer = setTimeout(() => selectAbility((index + 1) % 4), 5000);
          };
          buttons.forEach((button, index) => {
            button.addEventListener('click', () => selectAbility(index));
            button.addEventListener('keydown', (event) => {
              let next = index;
              if (event.key === 'ArrowRight') next = (index + 1) % 4;
              else if (event.key === 'ArrowLeft') next = (index + 3) % 4;
              else if (event.key === 'Home') next = 0;
              else if (event.key === 'End') next = 3;
              else return;
              event.preventDefault();
              selectAbility(next);
              buttons[next].focus();
            });
          });
          selectAbility(0);
        }
      });
    };
    init();
    document.addEventListener('astro:page-load', init);
  </script>
