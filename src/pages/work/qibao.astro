---
import '@/styles/case-unified.css';
import BaseLayout from '@/layouts/BaseLayout.astro';

const fig = {
  model: '/qibao-case/pdf-final-page.png',
  cDecision: '/qibao-case/c-decision.jpg',
  cOrder: '/qibao-case/c-order.jpg',
  bOldNew: '/qibao-case/b-old-new.jpg',
  bWorkbench: '/qibao-case/b-workbench.jpg',
  bMobile: '/qibao-case/b-mobile.jpg',
  trustOnline: '/qibao-case/trust-online.jpg',
  trustSop: '/qibao-case/trust-sop.jpg',
  handoff: '/qibao-case/handoff.jpg',
  opsBanner: '/qibao-case/ops-banner.jpg',
};

const roles = [
  {
    key: 'c',
    tab: 'C端 · 敢下单',
    title: 'C 端：把服务信息变成决策依据',
    body: '用户需要快速理解快保利益、门店差异、可约时间、订单进度与正品保障。设计重点是前置透传、卡片化状态和显性反馈。',
    points: [
      '首页与服务详情透传“30分钟快保”、超时赔付与正品保障等利益点。',
      '以门店为维度的卡片、筛选与优惠信息，帮助用户选到合适的门店。',
      '预约是 30 分钟时效成立的前提；订单状态让用户随时知道服务进度。',
    ],
    image: fig.cDecision,
    alt: 'C 端首页、服务详情、开单二维码弹窗与门店列表原稿',
    caption: '真实原稿：首页、服务详情、开单弹窗与门店',
  },
  {
    key: 'b',
    tab: 'B端 · 能交付',
    title: 'B 端：让认证店也能按统一节奏交付',
    body: '门店侧要把线上下单后的开单、施工、安心检测、核销、交车串起来，并在手机场景里降低操作门槛。',
    points: [
      '新增功能聚合型工作台，承接开单、仓储、预约、缺货等高频任务。',
      '重构作业流程，让维修保养与安心检测按现场真实分工并行。',
      '把 Pad 的大而全界面拆成手机上的连续步骤，适配认证店人员能力。',
    ],
    image: fig.bWorkbench,
    alt: 'B 端手机商户端工作台与功能分层原稿',
    caption: '真实原稿：手机商户端工作台',
  },
  {
    key: 's',
    tab: 'S端 · 供得准',
    title: 'S 端：把采购、支付与商家信息补成闭环',
    body: '认证店扩张后，B2B 平台需要支持平台采购、多商家销售同一配件、在线支付与商家信息补齐，否则门店侧的正品与履约承诺缺少后台支撑。',
    points: [
      '平台化采购与在线支付，降低新增认证店的接入门槛。',
      '允许不同商家销售同一配件，同时在平台补齐商家信息。',
      '用结构化信息支撑前端的授权、配件与服务展示。',
    ],
    image: fig.trustOnline,
    alt: '线上正品授权与商品信息透传原稿',
    caption: '真实原稿：线上入口、商品详情与正品页',
  },
  {
    key: 'o',
    tab: '运营 · 看得懂',
    title: '运营：先让用户看见，再转化为预约',
    body: '运营侧负责活动入口、首页氛围与优惠透传。视觉不是单独的装饰，而是让“30分钟快保”在复杂首页中被快速识别。',
    points: [
      '沉浸式 Banner 与背景建立活动氛围，强化“30”与小桔养车记忆点。',
      '用动效与差异化视觉突出限时优惠和服务入口。',
      '活动信息最终回流到服务详情、预约与门店选择，而非停留在曝光。',
    ],
    image: fig.opsBanner,
    alt: '车生活首页活动氛围与 Banner 原稿',
    caption: '真实原稿：首页活动氛围与 Banner',
  },
];

const journeySteps = [
  { n: '1', t: '看见爆品', d: '首页 Banner 突出 “30 分钟快保” 与优惠，帮助用户快速识别服务价值' },
  { n: '2', t: '理解服务', d: '详情页透传机油品牌、服务内容、正品保障、30分钟快保与门店信息' },
  { n: '3', t: '选门店与时间', d: '门店卡片承接距离、评分、服务与优惠；预约把等待前置为可计划的时间' },
  { n: '4', t: '到店后反馈', d: '二维码快速开单，订单状态卡片化，支付、预约、导航、施工状态显性化' },
];

const sopSteps = [
  { t: '货架 / 仓库取货', h: '让材料先被看见', d: '从货架或仓库取出本次服务使用的材料，让用户在施工前就能接触到实物，而不是只看到最终报价。', tags: ['看到实物', '确认项目', '进入施工'] },
  { t: '引导完成验真', h: '把验真权交给用户', d: '现场引导用户完成验真操作，让品牌授权和防伪码不只是线上页面里的说明，而是本次订单可以亲自确认的动作。', tags: ['扫码验证', '当场确认', '解除顾虑'] },
  { t: '转交施工', h: '验证后再转交施工', d: '材料确认后再进入施工，顺序上先解决信任、再进入技术性的保养操作，减少“已经换上才怀疑”的被动。', tags: ['先验证', '后施工', '顺序清晰'] },
  { t: '交还剩余机油', h: '离店时留下证据', d: '结算交车时交还剩余机油，配合环检报告、结算单、安心检测单、发票、车钥匙与定制信封，完成最后一次正品提醒。', tags: ['剩余物料', '完整单据', '可追溯'] },
];
---

<BaseLayout
  title="汽车维保30分钟快保 · 多端联动促进成交"
  description="用 C 端、B 端、S 端与线下 SOP 的联动，把时间不确定、材料不放心的保养，重构成用户敢下单、门店能交付、正品可感知的标准化产品。"
  type="article"
  closing={false}
>
  <article class="qibao-case">
    <header class="shell pt-12 sm:pt-16">
      <nav aria-label="面包屑" class="rise text-sm text-muted">
        <a href="/">作品案例</a> <span aria-hidden="true"> / </span>
        <span class="text-ink">汽车维保服务体验设计</span>
      </nav>
      <h1 class="rise case-title mt-8" style="--rise-step:1">多端协同，提升用户确定感</h1>
      <p class="rise case-lead mt-8" style="--rise-step:2">联动 C 端、B 端、S 端与线下 SOP，把“时间不确定、材料不放心”的服务，重构成用户敢下单、门店能交付、正品可感知的标准化产品</p>
      <dl class="rise case-meta mt-12" style="--rise-step:3">
        <div><dt>职责</dt><dd>B端设计 &amp; S端设计</dd></div>
        <div><dt>设计范围</dt><dd>C 端用户、B 端门店、S 端供应链与运营的多端联动设计</dd></div>
        <div><dt>项目成果</dt><dd>快保单 GMV 86W；NPS 80.1%→83.5%；正品可验知晓率 24%→56%</dd></div>
      </dl>
    </header>

    <div class="shell mt-14">
      <figure class="hero-panel">
        <img src={fig.model} width="3200" height="1800" alt="汽车维保业务 PDF 最后一页：100% 正品保障与正品可验知晓率提升" fetchpriority="high" data-lightbox />
      </figure>
    </div>

    <!-- 01 问题 -->
    <section class="shell story-section reveal" aria-labelledby="problem-title">
      <div class="story-copy paper-head">
        <p class="eyebrow">01 / 背景与问题</p>
        <h2 id="problem-title">不是没有流量，而是无法稳定承诺</h2>
        <p>行业供大于求、平台竞争加剧。小桔养车从直营店扩展到品类授权和认证店后，仅靠直营管控已无法保证每家店的体验一致</p>
      </div>
      <div class="problem-grid">
        <article class="problem-card">
          <span class="badge red">问题一 · 时间不可预期</span>
          <h3>同一个小保养<br />不同店的交付时间不一样</h3>
          <p>不同门店在流程、人员分工和系统使用上差异明显，用户到店后无法判断要等多久，很难形成明确的下单理由</p>
        </article>
        <article class="problem-card">
          <span class="badge red">问题二 · 正品不可验证</span>
          <h3>机油等关键材料<br />用户却难以确认来源</h3>
          <p>材料是否为真、是否被替换、剩余机油如何处理，都缺少能被用户看见和参与验证的环节</p>
        </article>
      </div>
    </section>

    <!-- 02 角色 -->
    <section class="shell story-section reveal touchpoint-section" aria-labelledby="roles-title">
      <div class="story-copy paper-head">
        <p class="eyebrow">02 / 触点拆解</p>
        <h2 id="roles-title">一个服务承诺，为什么要四端一起改</h2>
        <p>承诺不是一句话，是一条链：运营让活动先被看见；C 端讲清服务，用户才敢下单；B 端理顺流程，认证店才交得出；S 端补齐采购与正品，配件才供得上</p>
      </div>
      <div class="touchpoint-grid">
        <article class="touchpoint-card"><p class="touchpoint-label">运营</p><h3>看得懂</h3><p class="touchpoint-desc">先让用户看见，再转化为预约</p></article>
        <article class="touchpoint-card"><p class="touchpoint-label">C端</p><h3>敢下单</h3><p class="touchpoint-desc">把服务信息变成决策依据</p></article>
        <article class="touchpoint-card"><p class="touchpoint-label">B端</p><h3>能交付</h3><p class="touchpoint-desc">让认证店也能按统一节奏交付</p></article>
        <article class="touchpoint-card"><p class="touchpoint-label">S端</p><h3>供得准</h3><p class="touchpoint-desc">补齐采购、支付与商家信息</p></article>
      </div>
    </section>

    <!-- 03 C端决策链 -->
    <section class="dark-section" aria-labelledby="journey-title">
      <div class="shell story-section reveal">
        <div class="story-copy on-dark journey-paper-head">
          <p class="eyebrow">03 / 运营 和 C端</p>
          <h2 id="journey-title">从活动吸引到按时到店，每一步都要减少不确定性</h2>
          <p>快保不是用户点进详情页才开始的，运营入口、服务说明、门店选择、二维码开单、订单进度与预约反馈共同构成决策链</p>
        </div>
        <ol class="journey-map">
          {journeySteps.map((step) => (
            <li><b>{step.n}　{step.t}</b><p>{step.d}</p></li>
          ))}
        </ol>
        <div class="journey-gallery">
          <img src="/qibao-case/运营首页@4x.png" width="4800" height="2420" alt="运营首页：30 分钟快保活动 Banner 与首页入口" loading="lazy" data-lightbox />
          <img src="/qibao-case/服务透传@4x.png" width="4800" height="2716" alt="服务透传：C 端首页、服务详情、二维码开单与门店选择" loading="lazy" data-lightbox />
          <img src="/qibao-case/预约反馈@4x.png" width="4800" height="2672" alt="预约反馈：订单状态卡片与预约流程" loading="lazy" data-lightbox />
        </div>
      </div>
    </section>

    <!-- 04 B 端关键决策 -->
    <section class="shell story-section reveal b-paper-section" aria-labelledby="flow-title">
      <div class="story-copy paper-head">
        <p class="eyebrow">04 / B端解决方案</p>
        <h2 id="flow-title">让门店按真实工作方式交付</h2>
        <p>原系统的串行流程与单一设备操作，难以适配门店实际。解决方案从作业协同与设备适配入手，减少交付阻力，流程与现场并行，界面与人员能力匹配，门店才能稳定兑现前台的服务承诺。</p>
      </div>
      <div class="b-paper-cards">
        <article><span class="badge">01 / 流程重构</span><h3>支持双人并行，减少流程等待</h3><p>现场由两名员工同步完成维保与安心检测，旧流程却要求依次操作。新流程支持两项作业并行，完成后统一进入核销与交车，减少系统等待</p></article>
        <article><span class="badge amber">02 / 分设备设计</span><h3>适配门店差异，区分操作方式</h3><p>Pad 端以中心化工作台承载分散操作，支持灵活切换；手机端将操作串联为连续步骤，引导逐步完成任务</p></article>
      </div>
      <figure class="b-paper-images">
        <img src="/qibao-case/b-solution-final.png" width="3600" height="5802" alt="B端解决方案：流程重构与分设备设计完整长图" loading="lazy" data-lightbox />
      </figure>
    </section>

    <!-- 05 正品透传 -->
    <section class="shell story-section reveal trust-paper-section" aria-labelledby="trust-title">
      <div class="story-copy paper-head">
        <p class="eyebrow">05 / 全链路正品透传</p>
        <h2 id="trust-title">正品不是一句承诺，<br />而是线上可查、线下可验、离店可带走的证据链</h2>
        <p>用户担心的不是“页面有没有写正品”，而是我这次保养用的那瓶机油，能不能被看见、验证并追溯。</p>
      </div>
      <div class="trust-paper-gallery">
        <img src="/qibao-case/trust-paper-17.png" width="2934" height="1650" alt="正品授权线上透传：从首页入口到服务与商品详情" loading="lazy" data-lightbox />
        <img src="/qibao-case/trust-paper-18.png" width="2934" height="1650" alt="正品授权线上透传：正品页与授权证明" loading="lazy" data-lightbox />
        <div class="trust-paper-crop"><img src="/qibao-case/trust-paper-20.png" width="2934" height="1650" alt="线下正品告知 SOP：取货、验真、施工与交还剩余机油" loading="lazy" data-lightbox /></div>
        <img src="/qibao-case/trust-paper-22.png" width="2934" height="1650" alt="交车物品清单：报告、单据、发票、车钥匙与定制信封" loading="lazy" data-lightbox />
      </div>
    </section>

    <!-- 06 结果 -->
    <section class="dark-section result-section" aria-labelledby="result-title">
      <div class="shell story-section reveal">
        <div class="story-copy on-dark result-heading">
          <p class="eyebrow">06 / 项目结果</p>
          <h2 id="result-title">“承诺—系统—现场动作”是否真正闭环</h2>
          <p>快保 GMV、NPS 与正品知晓率分别对应成交、体验和信任三条线索。</p>
        </div>
        <div class="metric-board">
          <div class="metrics" aria-label="项目结果的三个指标">
            <div class="metric metric-gmv">
              <div class="gmv-terms">
                <div class="gmv-term"><span class="gmv-value">5.6</span><span class="gmv-label">单店日均单量</span></div>
                <div class="gmv-term"><span class="gmv-value">8</span><span class="gmv-label">认证店数</span></div>
                <div class="gmv-term"><span class="gmv-value">300</span><span class="gmv-label">客均单价</span></div>
                <div class="gmv-term gmv-total"><strong class="gmv-value">86<em>W</em></strong><span class="gmv-label">30分钟快保单GMV</span></div>
              </div>
            </div>
            <div class="metric metric-change"><div class="metric-equation"><span>80.1<em>%</em></span><i class="metric-arrow">⟶</i><strong>83.5<em>%</em></strong></div><div class="metric-caption">NPS变化</div></div>
            <div class="metric metric-change"><div class="metric-equation"><span>24<em>%</em></span><i class="metric-arrow">⟶</i><strong>56<em>%</em></strong></div><div class="metric-caption">正品可验知晓率</div></div>
          </div>
          <figure class="result-chart">
            <div class="result-chart-scroll">
              <svg viewBox="0 0 1120 365" role="img" aria-labelledby="result-chart-title result-chart-desc" xmlns="http://www.w3.org/2000/svg">
                <title id="result-chart-title">30 分钟快保爆品累计单量持续增长</title>
                <desc id="result-chart-desc">4 月 18 日上线；5 月 8 日累计 954 单；5 月 29 日累计 1892 单；6 月 24 日累计 2956 单。</desc>
                <defs><pattern id="result-chart-grid" width="22" height="22" patternUnits="userSpaceOnUse"><path d="M 0 0 V 246" fill="none" stroke="#777783" stroke-opacity=".48" stroke-width="1" stroke-dasharray="2 3" /></pattern></defs>
                <rect x="58" y="46" width="1004" height="246" fill="url(#result-chart-grid)" />
                <path d="M 58 292 H 1062" fill="none" stroke="#d0d0d3" stroke-width="1" />
                <path d="M 58 253 C 191 250 284 240 394 226 S 618 198 702 178 S 937 122 1036 96" fill="none" stroke="#FF9900" stroke-width="3.5" stroke-linecap="round" />
                <g fill="#252531" stroke="#FF9900" stroke-width="3"><circle cx="58" cy="253" r="5.5" /><circle cx="394" cy="226" r="5.5" /><circle cx="702" cy="178" r="5.5" /><circle cx="1036" cy="96" r="5.5" /></g>
                <g class="result-chart-badges" text-anchor="middle">
                  <g transform="translate(0 208)"><rect width="116" height="27" rx="2" fill="#FF9900" /><path d="M 54 27 L 58 33 L 62 27" fill="#FF9900" /><text x="58" y="18">30分钟快保上线</text></g>
                  <g transform="translate(330 181)"><rect width="128" height="27" rx="2" fill="#FF9900" /><path d="M 60 27 L 64 33 L 68 27" fill="#FF9900" /><text x="64" y="18">爆品累计单量：954</text></g>
                  <g transform="translate(638 133)"><rect width="128" height="27" rx="2" fill="#FF9900" /><path d="M 60 27 L 64 33 L 68 27" fill="#FF9900" /><text x="64" y="18">爆品累计单量：1892</text></g>
                  <g transform="translate(970 51)"><rect width="132" height="27" rx="2" fill="#FF9900" /><path d="M 62 27 L 66 33 L 70 27" fill="#FF9900" /><text x="66" y="18">爆品累计单量：2956</text></g>
                </g>
                <g class="result-chart-dates" text-anchor="middle"><text x="76" y="320">04.18</text><text x="394" y="320">05.08</text><text x="702" y="320">05.29</text><text x="1036" y="320">06.24</text></g>
              </svg>
            </div>
          </figure>
        </div>
      </div>
    </section>

    <div class="shell back-link"><a href="/">返回作品集 <span aria-hidden="true">↗</span></a></div>
  </article>

  <div class="qibao-lightbox" id="qibao-lightbox" aria-hidden="true">
    <button type="button" class="qibao-lightbox-close" id="qibao-lightbox-close" aria-label="关闭">×</button>
    <div class="qibao-lightbox-body" id="qibao-lightbox-body"></div>
  </div>
</BaseLayout>

<script>
  (function () {
    try {
      var reduce = matchMedia('(prefers-reduced-motion: reduce)');

      // 多端角色切换（手动，不自动轮播）
      document.querySelectorAll<HTMLElement>('[data-role-tabs]').forEach(function (tablist) {
        var tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
        var panels = Array.from(document.querySelectorAll<HTMLElement>('[data-role-panel]'));
        function activate(key: string) {
          tabs.forEach(function (tab) {
            var selected = tab.dataset.roleKey === key;
            tab.setAttribute('aria-selected', String(selected));
            tab.classList.toggle('is-active', selected);
            tab.tabIndex = selected ? 0 : -1;
          });
          panels.forEach(function (panel) {
            var selected = panel.dataset.rolePanel === key;
            panel.classList.toggle('is-active', selected);
            panel.setAttribute('aria-hidden', String(!selected));
          });
        }
        tabs.forEach(function (tab, index) {
          tab.addEventListener('click', function () { activate(tab.dataset.roleKey || ''); });
          tab.addEventListener('keydown', function (event) {
            if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
            event.preventDefault();
            var next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
            activate(tabs[next].dataset.roleKey || '');
            tabs[next].focus();
          });
        });
      });

      // 旧 / 新流程对照
      var flowData: Record<string, { work: [string, string]; check: [string, string]; verify: [string, string]; deliver: [string, string]; note: string }> = {
        old: { work: ['0%', '32%'], check: ['32%', '24%'], verify: ['56%', '12%'], deliver: ['68%', '14%'], note: '旧流程把施工、安心检测、核销、交车依次排列，系统节奏与线下两名工作人员并行作业的真实情况不一致。' },
        new: { work: ['0%', '42%'], check: ['8%', '34%'], verify: ['42%', '12%'], deliver: ['54%', '14%'], note: '新流程让安心检测与维修保养重叠，完成后再进入核销与交车。系统模型匹配现场分工，为 30 分钟承诺创造条件。' },
      };
      function setFlow(mode: string) {
        var d = flowData[mode];
        var map: Record<string, [string, string]> = { work: d.work, check: d.check, verify: d.verify, deliver: d.deliver };
        Object.keys(map).forEach(function (k) {
          var el = document.getElementById('qibao-bar-' + k) as HTMLElement | null;
          if (el) { el.style.left = map[k][0]; el.style.width = map[k][1]; }
        });
        var note = document.getElementById('qibao-flow-note');
        if (note) note.textContent = d.note;
        document.querySelectorAll<HTMLElement>('[data-flow]').forEach(function (btn) {
          var selected = btn.dataset.flow === mode;
          btn.setAttribute('aria-selected', String(selected));
          btn.classList.toggle('is-active', selected);
        });
      }
      document.querySelectorAll<HTMLElement>('[data-flow]').forEach(function (btn) {
        btn.addEventListener('click', function () { setFlow(btn.dataset.flow || 'old'); });
      });
      setFlow('old');

      // 正品 SOP 分步
      var sopData = [
        { h: '让材料先被看见', d: '从货架或仓库取出本次服务使用的材料，让用户在施工前就能接触到实物，而不是只看到最终报价。', tags: ['看到实物', '确认项目', '进入施工'] },
        { h: '把验真权交给用户', d: '现场引导用户完成验真操作，让品牌授权和防伪码不只是线上页面里的说明，而是本次订单可以亲自确认的动作。', tags: ['扫码验证', '当场确认', '解除顾虑'] },
        { h: '验证后再转交施工', d: '材料确认后再进入施工，顺序上先解决信任、再进入技术性的保养操作，减少“已经换上才怀疑”的被动。', tags: ['先验证', '后施工', '顺序清晰'] },
        { h: '离店时留下证据', d: '结算交车时交还剩余机油，配合环检报告、结算单、安心检测单、发票、车钥匙与定制信封，完成最后一次正品提醒。', tags: ['剩余物料', '完整单据', '可追溯'] },
      ];
      var sopBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sop]'));
      sopBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var i = Number(btn.dataset.sop);
          var data = sopData[i];
          var title = document.getElementById('qibao-sop-title');
          var text = document.getElementById('qibao-sop-text');
          var tags = document.getElementById('qibao-sop-tags');
          if (title) title.textContent = data.h;
          if (text) text.textContent = data.d;
          if (tags) tags.innerHTML = data.tags.map(function (t) { return '<span>' + t + '</span>'; }).join('');
          sopBtns.forEach(function (b) { b.setAttribute('aria-selected', String(b === btn)); b.classList.toggle('is-active', b === btn); });
        });
      });

      // 原稿灯箱
      var box = document.getElementById('qibao-lightbox');
      var body = document.getElementById('qibao-lightbox-body');
      var closeBtn = document.getElementById('qibao-lightbox-close');
      function closeBox() { if (!box || !body) return; box.classList.remove('is-open'); box.setAttribute('aria-hidden', 'true'); body.innerHTML = ''; }
      document.querySelectorAll<HTMLImageElement>('[data-lightbox]').forEach(function (img) {
        img.style.cursor = 'zoom-in';
        img.addEventListener('click', function () {
          if (!box || !body) return;
          var clone = img.cloneNode(true) as HTMLImageElement;
          clone.removeAttribute('loading');
          clone.style.cursor = 'default';
          body.innerHTML = '';
          body.appendChild(clone);
          box.classList.add('is-open');
          box.setAttribute('aria-hidden', 'false');
        });
      });
      if (closeBtn) closeBtn.addEventListener('click', closeBox);
      if (box) box.addEventListener('click', function (e) { if (e.target === box) closeBox(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeBox(); });

      // 滚动揭示（低动效时直接显示）
      var revealEls = Array.from(document.querySelectorAll('.reveal'));
      if (!reduce.matches && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) { entry.target.classList.add('in'); io.unobserve(entry.target); }
          });
        }, { threshold: 0.12 });
        revealEls.forEach(function (el) { io.observe(el); });
      } else {
        revealEls.forEach(function (el) { el.classList.add('in'); });
      }
    } catch (error) {
      console.error(error);
    }
  })();
</script>

