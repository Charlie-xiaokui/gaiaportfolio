---
import BaseLayout from '@/layouts/BaseLayout.astro';

const fig = {
  model: '/qibao-case/model-map.jpg',
  cDecision: '/qibao-case/c-decision.jpg',
  cOrder: '/qibao-case/c-order.jpg',
  bOldNew: '/qibao-case/b-old-new.jpg',
  bWorkbench: '/qibao-case/b-workbench.jpg',
  bMobile: '/qibao-case/b-mobile.jpg',
  trustOnline: '/qibao-case/trust-online.jpg',
  trustSop: '/qibao-case/trust-sop.jpg',
  handoff: '/qibao-case/handoff.jpg',
  opsBanner: '/qibao-case/ops-banner.jpg',
  results: '/qibao-case/results.jpg',
};

const roles = [
  {
    key: 'c',
    tab: 'C端 · 敢下单',
    title: 'C 端：把服务信息变成决策依据',
    body: '用户需要快速理解快保利益、门店差异、可约时间、订单进度与正品保障。设计重点是前置透传、卡片化状态和显性反馈。',
    points: [
      '首页与服务详情透传“30分钟快保”、超时赔付与正品保障等利益点。',
      '以门店为维度的卡片、筛选与优惠信息，帮助用户选到合适的门店。',
      '预约是 30 分钟时效成立的前提；订单状态让用户随时知道服务进度。',
    ],
    image: fig.cDecision,
    alt: 'C 端首页、服务详情、开单二维码弹窗与门店列表原稿',
    caption: '真实原稿：首页、服务详情、开单弹窗与门店',
  },
  {
    key: 'b',
    tab: 'B端 · 能交付',
    title: 'B 端：让认证店也能按统一节奏交付',
    body: '门店侧要把线上下单后的开单、施工、安心检测、核销、交车串起来，并在手机场景里降低操作门槛。',
    points: [
      '新增功能聚合型工作台，承接开单、仓储、预约、缺货等高频任务。',
      '重构作业流程，让维修保养与安心检测按现场真实分工并行。',
      '把 Pad 的大而全界面拆成手机上的连续步骤，适配认证店人员能力。',
    ],
    image: fig.bWorkbench,
    alt: 'B 端手机商户端工作台与功能分层原稿',
    caption: '真实原稿：手机商户端工作台',
  },
  {
    key: 's',
    tab: 'S端 · 供得准',
    title: 'S 端：把采购、支付与商家信息补成闭环',
    body: '认证店扩张后，B2B 平台需要支持平台采购、多商家销售同一配件、在线支付与商家信息补齐，否则门店侧的正品与履约承诺缺少后台支撑。',
    points: [
      '平台化采购与在线支付，降低新增认证店的接入门槛。',
      '允许不同商家销售同一配件，同时在平台补齐商家信息。',
      '用结构化信息支撑前端的授权、配件与服务展示。',
    ],
    image: fig.trustOnline,
    alt: '线上正品授权与商品信息透传原稿',
    caption: '真实原稿：线上入口、商品详情与正品页',
  },
  {
    key: 'o',
    tab: '运营 · 看得懂',
    title: '运营：先让用户看见，再转化为预约',
    body: '运营侧负责活动入口、首页氛围与优惠透传。视觉不是单独的装饰，而是让“30分钟快保”在复杂首页中被快速识别。',
    points: [
      '沉浸式 Banner 与背景建立活动氛围，强化“30”与小桔养车记忆点。',
      '用动效与差异化视觉突出限时优惠和服务入口。',
      '活动信息最终回流到服务详情、预约与门店选择，而非停留在曝光。',
    ],
    image: fig.opsBanner,
    alt: '车生活首页活动氛围与 Banner 原稿',
    caption: '真实原稿：首页活动氛围与 Banner',
  },
];

const journeySteps = [
  { n: '1', t: '看见爆品', d: '首页 Banner 与活动氛围突出“30分钟”和优惠，让用户先识别到一个明确产品。' },
  { n: '2', t: '理解服务', d: '详情页透传机油品牌、服务内容、正品保障、30分钟快保与门店信息。' },
  { n: '3', t: '选门店与时间', d: '门店卡片承接距离、评分、服务与优惠；预约把等待前置为可计划的时间。' },
  { n: '4', t: '到店后反馈', d: '二维码快速开单，订单状态卡片化，支付、预约、导航、施工状态显性化。' },
];

const sopSteps = [
  { t: '货架 / 仓库取货', h: '让材料先被看见', d: '从货架或仓库取出本次服务使用的材料，让用户在施工前就能接触到实物，而不是只看到最终报价。', tags: ['看到实物', '确认项目', '进入施工'] },
  { t: '引导完成验真', h: '把验真权交给用户', d: '现场引导用户完成验真操作，让品牌授权和防伪码不只是线上页面里的说明，而是本次订单可以亲自确认的动作。', tags: ['扫码验证', '当场确认', '解除顾虑'] },
  { t: '转交施工', h: '验证后再转交施工', d: '材料确认后再进入施工，顺序上先解决信任、再进入技术性的保养操作，减少“已经换上才怀疑”的被动。', tags: ['先验证', '后施工', '顺序清晰'] },
  { t: '交还剩余机油', h: '离店时留下证据', d: '结算交车时交还剩余机油，配合环检报告、结算单、安心检测单、发票、车钥匙与定制信封，完成最后一次正品提醒。', tags: ['剩余物料', '完整单据', '可追溯'] },
];
---

<BaseLayout
  title="汽车维保30分钟快保 · 多端联动促进成交"
  description="用 C 端、B 端、S 端与线下 SOP 的联动，把时间不确定、材料不放心的保养，重构成用户敢下单、门店能交付、正品可感知的标准化产品。"
  type="article"
  closing={false}
>
  <article class="qibao-case">
    <header class="shell pt-12 sm:pt-16">
      <nav aria-label="面包屑" class="rise text-sm text-muted">
        <a href="/">作品案例</a> <span aria-hidden="true"> / </span>
        <span class="text-ink">汽车维保“30分钟快保”服务</span>
      </nav>
      <p class="rise kicker mt-12" style="--rise-step:1">多端服务设计 / 流程重构 / 信任体系</p>
      <h1 class="rise case-title mt-6" style="--rise-step:2">把一次不确定的小保养，做成可承诺的“30分钟快保”</h1>
      <p class="rise case-lead mt-8" style="--rise-step:3">这不是单端页面改版，而是用 C 端、B 端、S 端与线下 SOP 的联动，把“时间不确定、材料不放心”的服务，重构成用户敢下单、门店能交付、正品可感知的标准化产品。</p>
      <dl class="rise case-meta mt-12" style="--rise-step:4">
        <div><dt>项目主题</dt><dd>汽车维保“30分钟快保”爆品与多端服务闭环</dd></div>
        <div><dt>设计范围</dt><dd>C 端用户、B 端门店、S 端供应链与运营的多端联动设计</dd></div>
        <div><dt>项目成果</dt><dd>快保单 GMV 86W；NPS 80.1%→83.5%；正品可验知晓率 24%→56%</dd></div>
      </dl>
    </header>

    <div class="shell mt-14">
      <figure class="hero-panel">
        <img src={fig.model} width="848" height="653" alt="小桔养车从直营店到认证店，用标准化 SOP 发展 30 分钟快保的多端关系图" fetchpriority="high" data-lightbox />
        <figcaption>用标准化 SOP，同时建立稳定的时间预期与产品预期</figcaption>
      </figure>
    </div>

    <!-- 01 问题 -->
    <section class="shell story-section reveal" aria-labelledby="problem-title">
      <div class="story-copy">
        <p class="eyebrow">01 / 背景与问题</p>
        <h2 id="problem-title">增长的难点，不是没有流量，而是服务无法被稳定承诺</h2>
        <p>行业供大于求、平台竞争加剧。小桔养车从直营店扩展到品类授权和认证店后，仅靠直营管控已无法保证每家店的体验一致。</p>
      </div>
      <div class="problem-grid">
        <article class="problem-card">
          <span class="badge red">问题一 · 时间不可预期</span>
          <h3>同是小保养，每家店的交付节奏都不一样</h3>
          <p>不同门店在流程、人员分工和系统使用上差异明显，用户到店后无法判断要等多久，很难形成明确的下单理由。</p>
        </article>
        <article class="problem-card">
          <span class="badge amber">问题二 · 正品不可验证</span>
          <h3>机油等关键材料就在眼前，用户却难以确认来源</h3>
          <p>材料是否为真、是否被替换、剩余机油如何处理，都缺少能被用户看见和参与验证的环节。</p>
        </article>
      </div>
      <div class="thesis">
        <div><span>设计命题</span><strong>用标准化 SOP 打造“30分钟快保”爆品</strong></div>
        <div class="thesis-arrow" aria-hidden="true">→</div>
        <div><span>同时建立两种预期</span><strong>稳定的时间预期 × 稳定的产品 / 材料预期</strong></div>
      </div>
    </section>

    <!-- 02 角色 -->
    <section class="shell story-section reveal" aria-labelledby="roles-title">
      <div class="story-copy">
        <p class="eyebrow">02 / 角色拆解</p>
        <h2 id="roles-title">一个服务承诺，为什么要四端一起改</h2>
        <p>切换角色可以看到同一目标在不同角色上的设计任务。关键不是多做几个页面，而是把承诺拆成每一端必须完成的动作。</p>
      </div>
      <div class="role-tabs" data-role-tabs role="tablist" aria-label="多端角色">
        {roles.map((role, i) => (
          <button type="button" role="tab" id={`qibao-role-tab-${role.key}`} aria-controls={`qibao-role-panel-${role.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class={i === 0 ? 'is-active' : ''} data-role-key={role.key}>{role.tab}</button>
        ))}
      </div>
      <div class="role-panels">
        {roles.map((role, i) => (
          <div class={`role-panel${i === 0 ? ' is-active' : ''}`} id={`qibao-role-panel-${role.key}`} role="tabpanel" aria-labelledby={`qibao-role-tab-${role.key}`} aria-hidden={i === 0 ? 'false' : 'true'} data-role-panel={role.key}>
            <div class="role-text">
              <h3>{role.title}</h3>
              <p>{role.body}</p>
              <ul>{role.points.map((point) => <li>{point}</li>)}</ul>
            </div>
            <figure class="role-figure">
              <img src={role.image} alt={role.alt} loading="lazy" data-lightbox />
              <figcaption>{role.caption}</figcaption>
            </figure>
          </div>
        ))}
      </div>
    </section>

    <!-- 03 C端决策链 -->
    <section class="dark-section" aria-labelledby="journey-title">
      <div class="shell story-section reveal">
        <div class="story-copy on-dark">
          <p class="eyebrow">03 / C 端决策链</p>
          <h2 id="journey-title">从被活动吸引到按时到店，每一步都要减少不确定性</h2>
          <p>快保不是用户点进详情页才开始的。运营入口、服务说明、门店选择、二维码开单、订单进度与预约反馈共同构成决策链。</p>
        </div>
        <ol class="journey-map">
          {journeySteps.map((step) => (
            <li><b>{step.n}　{step.t}</b><p>{step.d}</p></li>
          ))}
        </ol>
        <div class="seg-toggle" data-journey-toggle role="tablist" aria-label="C 端决策阶段">
          <button type="button" role="tab" aria-selected="true" class="is-active" data-journey="decision">决策前 · 首页 / 详情 / 门店 / 开单</button>
          <button type="button" role="tab" aria-selected="false" data-journey="status">决策后 · 订单 / 预约 / 反馈</button>
        </div>
        <figure class="shot-panel on-dark">
          <img class="journey-img is-active" data-journey-img="decision" src={fig.cDecision} width="1530" height="1201" alt="C 端首页、服务详情、开单弹窗与门店决策链路原稿" loading="lazy" data-lightbox />
          <img class="journey-img" data-journey-img="status" src={fig.cOrder} width="1530" height="1246" alt="C 端订单状态卡片化与预约流程原稿" loading="lazy" data-lightbox />
          <figcaption class="on-dark">点击切换决策前的信息透传与决策后的状态反馈</figcaption>
        </figure>
        <div class="two-col">
          <figure class="shot-panel on-dark">
            <img src={fig.cOrder} width="1530" height="1246" alt="订单状态与预约流程原稿" loading="lazy" data-lightbox />
            <figcaption class="on-dark">订单状态卡片化，减少用户反复询问</figcaption>
          </figure>
          <figure class="shot-panel on-dark">
            <img src={fig.bOldNew} width="1155" height="1163" alt="B 端新旧界面对比" loading="lazy" data-lightbox />
            <figcaption class="on-dark">线上订单必须被门店标准化接住</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 04 流程重构 -->
    <section class="shell story-section reveal" aria-labelledby="flow-title">
      <div class="story-copy">
        <p class="eyebrow">04 / 关键决策一</p>
        <h2 id="flow-title">系统原来按“一个人串行”设计，现场其实是“两个人并行”</h2>
        <p>这是项目里最典型的流程取舍：如果系统继续把施工、安心检测、核销、交车排成一条线，30 分钟承诺就很难稳定达成。</p>
      </div>
      <div class="seg-toggle light" data-flow-toggle role="tablist" aria-label="作业流程对照">
        <button type="button" role="tab" aria-selected="true" class="is-active" data-flow="old">旧流程 · 串行等待</button>
        <button type="button" role="tab" aria-selected="false" data-flow="new">新流程 · 并行重叠</button>
      </div>
      <div class="flow-board">
        <div class="lane"><span class="lane-name">维修保养</span><div class="lane-track"><div class="bar bar-work" id="qibao-bar-work">施工</div></div></div>
        <div class="lane"><span class="lane-name">安心检测</span><div class="lane-track"><div class="bar bar-check" id="qibao-bar-check">安心检测</div></div></div>
        <div class="lane"><span class="lane-name">结算离店</span><div class="lane-track"><div class="bar bar-verify" id="qibao-bar-verify">核销</div><div class="bar bar-deliver" id="qibao-bar-deliver">交车</div></div></div>
        <p class="flow-note" id="qibao-flow-note">旧流程把施工、安心检测、核销、交车依次排列，系统节奏与线下两名工作人员并行作业的真实情况不一致。</p>
      </div>
      <div class="persona-grid">
        <article class="persona"><span class="badge">自营店 SA</span><h3>专业、服务项目多</h3><p>需要处理更复杂的事务，Pad 端的信息密度与多入口仍有使用场景。</p></article>
        <article class="persona"><span class="badge amber">认证店 SA</span><h3>相对业余、服务项目少</h3><p>更重要的是高效完成一件事，因此手机端把复杂表单拆成连续步骤。</p></article>
      </div>
      <figure class="shot-panel">
        <img src={fig.bMobile} width="975" height="1050" alt="Pad 端到 Mobile 端的信息聚焦设计原稿" loading="lazy" data-lightbox />
        <figcaption>化整为零、信息聚焦、串联核心流程：基本信息 → 环检信息 → 添加服务 → 开始施工</figcaption>
      </figure>
    </section>

    <!-- 05 正品透传 -->
    <section class="shell story-section reveal" aria-labelledby="trust-title">
      <div class="story-copy">
        <p class="eyebrow">05 / 关键决策二</p>
        <h2 id="trust-title">正品不是一句承诺，而是线上可查、线下可验、离店可带走的证据链</h2>
        <p>用户担心的不是“页面有没有写正品”，而是我这次保养用的那瓶机油，能不能被看见、验证并追溯。</p>
      </div>
      <div class="two-col trust-cols">
        <article class="trust-card">
          <h3>线上：在决策前反复透传</h3>
          <p>正品信息分布在 O2O 首页、B2C 首页、O2O 服务详情、B2C 商品详情与正品页，用品牌直采、正品保障、防伪验证、假一赔十、授权书与供应链图片建立信任。</p>
          <figure><img src={fig.trustOnline} width="1545" height="1261" alt="线上正品授权入口原稿" loading="lazy" data-lightbox /></figure>
        </article>
        <article class="trust-card">
          <h3>线下：把验证动作嵌入 SOP</h3>
          <p>真正解除顾虑的时刻发生在门店：取货时让用户看到材料，施工前引导扫码验真，结算交车时交还剩余机油，让“正品”从品牌话术变成本次订单的具体证据。</p>
          <figure><img src={fig.trustSop} width="1260" height="638" alt="线下正品告知 SOP 原稿" loading="lazy" data-lightbox /></figure>
        </article>
      </div>
      <div class="sop-walk">
        <h3>逐步查看：线下正品告知 SOP</h3>
        <p class="sop-cost">落地成本：约 1 周线下 SOP 培训</p>
        <div class="sop-buttons" role="tablist" aria-label="正品告知步骤">
          {sopSteps.map((step, i) => (
            <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} class={i === 0 ? 'is-active' : ''} data-sop={i}>{step.t}</button>
          ))}
        </div>
        <div class="sop-body">
          <div><h4 id="qibao-sop-title">{sopSteps[0].h}</h4><p id="qibao-sop-text">{sopSteps[0].d}</p><div class="sop-tags" id="qibao-sop-tags">{sopSteps[0].tags.map((tag) => <span>{tag}</span>)}</div></div>
          <figure><img src={fig.trustSop} width="1260" height="638" alt="正品告知 SOP 四步：取货、验真、施工、交还剩余机油" loading="lazy" data-lightbox /></figure>
        </div>
      </div>
      <figure class="shot-panel">
        <img src={fig.handoff} width="1440" height="1246" alt="交车物品清单原稿" loading="lazy" data-lightbox />
        <figcaption>交车不是说一声“好了”：双手递交、送司机上车、引导离店，并交付完整单据与定制信封</figcaption>
      </figure>
    </section>

    <!-- 06 结果 -->
    <section class="dark-section" aria-labelledby="result-title">
      <div class="shell story-section reveal">
        <div class="story-copy on-dark">
          <p class="eyebrow">06 / 项目结果</p>
          <h2 id="result-title">结果验证的是“承诺—系统—现场动作”是否真正闭环</h2>
          <p>快保 GMV、NPS 与正品知晓率分别对应成交、体验和信任三条线索。这里只呈现原始资料口径，不额外推导增长率。</p>
        </div>
        <div class="result-grid">
          <div class="metric-board">
            <div class="metrics">
              <div class="metric"><b>86W</b><span>30分钟快保单 GMV</span></div>
              <div class="metric"><b>83.5%</b><span>NPS 80.1% → 83.5%，提升 3.4 个百分点</span></div>
              <div class="metric"><b>56%</b><span>正品可验知晓率 24% → 56%，提升 32 个百分点</span></div>
            </div>
            <figure class="metric-figure"><img src={fig.results} width="1553" height="1170" alt="项目成果与爆品累计单量趋势原稿" loading="lazy" data-lightbox /></figure>
            <p class="metric-note">口径说明：86W 在原稿中由“单店日均单量 5.6 × 认证店数 8 × 客均单价 300”推导呈现；爆品累计单量在 04.18、05.08、05.29、06.24 分别记录为 954、1892、2956，起点为“30分钟爆品上线”。本页只复述材料，不外推缺失日期的销量。</p>
          </div>
          <aside class="ability-card">
            <h3>这个案例体现的设计能力</h3>
            <p><b>把模糊业务问题改写成可设计的产品承诺。</b>从“体验不稳定”收敛到“30分钟”和“正品可验”两个用户能理解的承诺。</p>
            <p><b>做多端责任划分。</b>C 端负责决策，B 端负责履约，S 端负责供应链与信息，运营负责入口与氛围。</p>
            <p><b>把现场 SOP 当成体验设计的一部分。</b>授权页解决认知，扫码验真解决当下顾虑，剩余物料和交车清单让信任延续到离店。</p>
            <p><b>用结果反向验证设计。</b>成交、满意度与正品知晓率分别检验商业、服务与信任目标，而不是只看界面是否好看。</p>
          </aside>
        </div>
      </div>
