  .journey-map li { position: relative; border: 1px solid rgba(255,255,255,.14); border-radius: 20px; padding: 22px; background: rgba(255,255,255,.05); }
  .journey-map b { display: block; font-size: 19px; margin-bottom: 8px; } .journey-map p { margin: 0; color: #c5cedb; font-size: 14px; line-height: 1.7; }
