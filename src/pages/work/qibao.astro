  .bar-work { background: #293241; left: 0; width: 32%; } .bar-check { background: var(--q-teal); left: 32%; width: 24%; }
  .bar-verify { background: var(--q-blue); left: 56%; width: 12%; } .bar-deliver { background: var(--q-orange); color: #1e1500; left: 68%; width: 14%; }
  .flow-note { margin: 20px 0 0; padding: 16px 18px; border-radius: 14px; background: #eef6ff; color: #16558f; line-height: 1.7; }
