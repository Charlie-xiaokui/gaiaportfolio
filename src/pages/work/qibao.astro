  .seg-toggle button:focus-visible { outline: 2px solid var(--q-orange); outline-offset: 2px; }
  .shot-panel { margin: 28px 0 0; border-radius: 24px; overflow: hidden; background: #fff; border: 1px solid var(--q-line); padding: 16px; }
