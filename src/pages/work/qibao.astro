  .trust-cols { gap: 24px; } .trust-card { background: #fff; border: 1px solid var(--q-line); border-radius: 24px; padding: 26px; }
  .trust-card h3 { margin: 0 0 12px; font-size: 23px; } .trust-card > p { color: var(--q-muted); line-height: 1.8; margin: 0 0 18px; }
  .trust-card figure { margin: 0; } .trust-card figure img { border-radius: 14px; width: 100%; height: auto; }
  .sop-walk { margin-top: 28px; background: #fff; border: 1px solid var(--q-line); border-radius: 26px; padding: 28px; }
