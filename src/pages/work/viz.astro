---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/case-unified.css';
const a=(name:string)=>`/viz-case/${name}.jpg`;
const chapters=[
{id:'structure',n:'01',name:'灵活拓展',title:'先让工作有顺序，再让界面有弹性。',intro:'从字段到配置，再到结果，三类用户的工作都可以沿着同一条路径展开。框架不再围绕功能堆叠，而是围绕任务组织。',decisions:[{title:'页面框架：字段 → 配置 → 结果',text:'把分散的操作收进三个明确区域，让用户知道从哪里开始、在哪里调整、去哪里看结果。随着任务深入，配置可以扩展，结果仍然保留清晰的位置。',image:'user-paths'},{title:'工具条：没有所有人共同的“高频”',text:'原本希望统一提取高频命令，但使用分布显示，不同用户的常用功能差异明显。最终选择自定义工具条，把功能选择和排列交还给用户。',image:'toolbar'},{title:'筛选布局：在屏效与调整成本之间取舍',text:'等分、适宽和网格各有适用条件。方案选择规整、调整成本较低的等分布局，并提供六种预设组合，减少筛选器对图表展示空间的挤占。',image:'layout'}]},
{id:'efficiency',n:'02',name:'配置提效',title:'把反复调整，变成更接近任务的选择。',intro:'用户来编辑器是为了得到结果。把常见场景沉淀为预设，把连续分析放回结果旁边，配置才真正服务于工作。',decisions:[{title:'图表预设：封装场景里的最佳实践',text:'长字段需要完整阅读，重点排名需要一眼可见。预设将这些真实需求封装为可选择的展示方式，让用户从业务目标出发，而非逐项试调格式。',image:'preset-long'},{title:'分析配置：观察与调整同时发生',text:'探索分析是一个不断往返的过程。以侧边面板承载分析条件，避免弹窗遮挡数据，让观察结果、修改条件、再次观察成为连续动作。',image:'analysis'}]},
{id:'learning',n:'03',name:'简单易学',title:'让界面解释能力，让用户看见结果。',intro:'当一个选项难以理解时，更多术语并不能帮助用户。示例、业务语言、空态和帮助文档共同构成了学习路径。',decisions:[{title:'复杂配置：把规则和例子放在一起',text:'配置项旁提供实际结果示例，帮助用户理解不同选项会怎样影响数据，减少依靠猜测和反复尝试来学习的成本。',image:'topn'},{title:'查询表达：从代码转成业务语言',text:'把查询条件翻译成容易理解的业务描述，再以表单输入承接操作，让不会编写 SQL 的用户也能表达自己的取数需求。',image:'sql'},{title:'图表空态：还没放入数据，也能知道怎么开始',text:'空态展示图表骨架、数据构成和适用场景；悬停时给出示例结果，让用户先看懂图表，再选择是否使用。',image:'empty'},{title:'帮助文档：用熟悉的故事解释陌生概念',text:'通过类比体系与漫画，把数据集搭建、查询等抽象过程转成容易理解的情境，让帮助内容更愿意被读、更容易被记住。',image:'comic'}]},
{id:'visual',n:'04',name:'优化视效',title:'从界面到图表，建立清晰而一致的表达。',intro:'精致度服务于辨识和阅读。界面用层级突出字段与结果，图表则通过配色研究提升区分度与使用舒适度。',decisions:[{title:'图形与界面：让重要信息先被看见',text:'强化图标的代表性特征，优化图形质感；整体界面保持简洁，以清晰层级组织复杂内容，让视觉表达帮助用户理解功能。',image:'icons'},{title:'图表配色：从行业特征到实际可读性',text:'针对风格、对比、文字清晰度和方案数量的问题，提取行业代表色并推导色彩关系，再结合辨识度、舒适度评估进行调整，最终形成八套配色。',image:'color-process'},{title:'八套方案：放回真实图表检验',text:'配色最终需要在不同图表类型中成立。统一观察柱状、折线、饼图等场景，兼顾风格一致、系列区分和信息阅读。',image:'palette-overview'}]},
];
---
<BaseLayout title="可视化查询 · 设计重构" description="从产品定位、用户研究到四项设计策略，重构数据分析编辑器，并以分期验证完成版本迁移。" closing={false}>
<article class="viz-case pdf-case">
<header class="shell hero"><nav><a href="/">作品案例</a> / 可视化查询设计重构</nav><p class="overline">风神 BI / 产品体验重构</p><h1>从取数到分析，<br />重新理顺工作的路径。</h1><p class="intro">同一套编辑器，要让简单取数更容易，也要承接持续深入的分析。这次重构从产品定位和用户任务出发，重新组织框架、配置、学习与视觉体验。</p><dl><div><dt>我的职责</dt><dd>项目设计 Owner</dd></div><div><dt>工作范围</dt><dd>专家走查、需求梳理、用户访谈、框架优化、交互与视觉设计</dd></div><div><dt>项目结果</dt><dd>新版上线一个月后，UV 占比均值 66.4%</dd></div></dl><figure class="hero-image"><img src={a('hero')} alt="重构后的可视化查询编辑器" width="1868" height="1028" fetchpriority="high" /></figure></header>
<section class="shell section"><div class="section-heading"><p class="overline">先认识产品</p><h2>它是制图工具，也是取数与分析的工作台。</h2><p>可视化查询将数据转换成图表，让不会 SQL 的人查询数据，也让专业用户继续探索数据之间的关联。重新设计之前，首先要明确这三种价值，避免把复杂编辑器简单理解成一张图表画布。</p></div><div class="jobs"><div><span>01</span><h3>图表生产</h3><p>把数据转化成可以阅读、交付的图表。</p></div><div><span>02</span><h3>数据查询</h3><p>让不会 SQL 的用户，也能找到所需数据。</p></div><div><span>03</span><h3>探索分析</h3><p>通过持续调整，挖掘数据背后的关联。</p></div></div></section>
<section class="shell section"><div class="section-heading"><p class="overline">背景与诊断</p><h2>功能已经很多，完成任务却不够顺畅。</h2><p>内部工具走向商业化，对体验提出了更高要求。旧版的问题集中在屏效、信息架构、扩展性和视觉完成度：图表被配置挤压，功能缺少清晰归属，新能力难以被发现。</p></div><figure><img src={a('before')} alt="重构前功能平铺、结果区域受挤压的界面" loading="lazy"/><figcaption>原有界面：功能不断增长，工作路径却没有同步变清晰</figcaption></figure><div class="diagnosis"><p><b>屏效</b>结果区域受限，配置占据大量展示空间</p><p><b>架构</b>内容分类不清，用户需要自行寻找操作路径</p><p><b>拓展</b>新增功能难发现，界面缺少持续生长的空间</p><p><b>视效</b>精致度与信息层级需要满足商业产品要求</p></div></section>
<section class="shell section"><div class="section-heading"><p class="overline">研究与策略</p><h2>先理解不同的人，再寻找共同的路径。</h2><p>用户研究区分了简单取数、图表生产和探索分析三类诉求。结合专家自查与竞品对比，我们把“易用、高效”拆成四项策略，每项策略都对应具体的设计决策。</p></div><figure><img src={a('user-paths')} alt="不同任务路径与页面框架的关系" loading="lazy" /></figure><nav class="strategy-nav" aria-label="四项设计策略">{chapters.map(c=><a href={`#${c.id}`}><span>{c.n}</span><strong>{c.name}</strong><span aria-hidden="true">↓</span></a>)}</nav></section>
{chapters.map(c=><section class="shell section chapter" id={c.id}><div class="section-heading"><p class="overline">{c.n} / {c.name}</p><h2>{c.title}</h2><p>{c.intro}</p></div><div class="decision-list">{c.decisions.map((d,i)=><div class="decision"><div class="decision-copy"><span class="decision-number">{c.n}.{i+1}</span><h3>{d.title}</h3><p>{d.text}</p></div><figure><button class="zoom" data-src={a(d.image)} aria-label={`放大查看：${d.title}`}><img src={a(d.image)} alt={d.title} loading="lazy"/><span>放大查看 ↗</span></button></figure></div>)}</div></section>)}
<section class="validation"><div class="shell section"><div class="section-heading"><p class="overline">从方案到上线</p><h2>设计完成后，还要验证用户能否真正用起来。</h2><p>关键方案先征集意见，再分期测试上线；上线后继续监测与回访。验证贯穿整个重构过程，让方案在真实反馈中逐步收敛。</p></div><ol class="timeline"><li><b>征询意见</b><p>分享关键产出，收集反馈，并提前传达变化。</p></li><li><b>分期验证</b><p>拆为四期上线，每期在测试环境开展可用性测试。</p></li><li><b>监测与回访</b><p>关注新版表现，也主动了解旧版用户继续保留旧习惯的原因。</p></li></ol><figure><img src={a('validation')} alt="问卷征询、可用性测试和数据监测过程" loading="lazy" /></figure></div></section>
<section class="shell section"><div class="section-heading"><p class="overline">结果与沉淀</p><h2>让一次重构，成为后续迭代的起点。</h2><p>新版上线一个月后，UV 占比均值达到 66.4%。培训获得正向反馈，也为后续模块重构提供了参考。项目结束后，监测、方法与可复用组件继续作为团队资产沉淀。</p></div><figure><img src={a('uv')} alt="新版 UV 占比变化，均值为 66.4%" loading="lazy" /></figure><div class="jobs"><div><h3>持续观察体验</h3><p>建立监测看板，让体验变化能够被持续追踪。</p></div><div><h3>复用重构方法</h3><p>整理经验与问题，为后续模块提供判断依据。</p></div><div><h3>沉淀设计资产</h3><p>归纳可复用模块，减少后续设计的重复投入。</p></div></div><a class="return" href="/">返回作品集 ↗</a></section>
</article><dialog id="viz-reader"><button class="close">关闭 ×</button><img src={a('hero')} alt="设计方案放大预览"/></dialog>
</BaseLayout>
<script>
const dialog=document.querySelector<HTMLDialogElement>('#viz-reader');document.querySelectorAll<HTMLButtonElement>('[data-src]').forEach(b=>b.addEventListener('click',()=>{if(dialog){dialog.querySelector('img')!.src=b.dataset.src!;dialog.showModal()}}));dialog?.querySelector('button')?.addEventListener('click',()=>dialog.close());dialog?.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});
</script>
<style>
.pdf-case{background:var(--canvas);padding-bottom:96px}.hero{padding-top:48px}nav{font-size:14px;color:var(--muted)}.overline{font-size:13px;letter-spacing:.06em;color:var(--muted);margin-bottom:24px}.hero>.overline{margin-top:72px}.hero h1{margin:0;max-width:1000px}.intro{font-size:22px;line-height:1.85;max-width:840px;margin-top:32px;color:var(--body)}dl{display:grid;grid-template-columns:1fr 2fr 1.5fr;gap:40px;border-block:1px solid var(--line);padding:32px 0;margin-top:56px}dt{font-size:13px;color:var(--muted)}dd{margin-top:8px;font-size:17px;line-height:1.8}figure{margin-top:40px}figure img{display:block;width:100%;height:auto;border-radius:16px}.hero-image{background:var(--sunken);padding:24px;border-radius:16px;margin-top:48px}figcaption{text-align:center;color:var(--muted);margin-top:16px;font-size:14px}.section{padding-top:128px}.section-heading{max-width:840px}.section-heading>p:last-child{font-size:18px;line-height:1.9;color:var(--body);margin-top:24px}.jobs{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;margin-top:48px}.jobs>div{border-top:1px solid var(--line);padding-top:24px}.jobs span{font-size:13px;color:var(--muted)}h3{font-size:24px;line-height:1.45;font-weight:500}.jobs h3{margin-top:12px}.jobs p{color:var(--body);line-height:1.85;margin-top:16px}.diagnosis{display:grid;grid-template-columns:1fr 1fr;gap:24px 48px;margin-top:40px}.diagnosis p{line-height:1.8;color:var(--body)}.diagnosis b{display:block;color:var(--ink);margin-bottom:8px}.strategy-nav{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:48px}.strategy-nav a{padding:24px;background:var(--surface);border:1px solid var(--line);border-radius:12px;display:flex;flex-direction:column;gap:16px}.strategy-nav strong{font-size:22px;font-weight:500;color:var(--ink)}.strategy-nav a:hover{background:var(--accent);color:#121211}.chapter{scroll-margin-top:100px}.decision-list{margin-top:56px}.decision{padding-block:48px;border-top:1px solid var(--line)}.decision-copy{display:grid;grid-template-columns:64px 1fr 1.4fr;gap:24px;align-items:start}.decision-copy p{font-size:17px;line-height:1.9;color:var(--body)}.decision-number{font-size:13px;color:var(--muted);padding-top:6px}.zoom{position:relative;width:100%;display:block;cursor:zoom-in;background:var(--sunken);padding:16px;border-radius:16px}.zoom>span{position:absolute;right:28px;bottom:28px;background:var(--inverse);color:var(--on-inverse);padding:8px 14px;border-radius:999px;font-size:13px}.zoom img{max-height:850px;object-fit:contain}.validation{margin-top:96px;background:#171716;color:#fafaf7;padding-bottom:80px}.validation .overline{color:#d4f84a}.validation .section-heading>p:last-child{color:#c7c7bf}.timeline{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;margin:48px 0 0;padding:0;list-style:none;counter-reset:steps}.timeline li{border-top:1px solid #55554e;padding-top:24px;counter-increment:steps}.timeline b{font-size:22px;font-weight:500}.timeline b:before{content:'0' counter(steps) ' / ';color:#d4f84a}.timeline p{color:#c7c7bf;line-height:1.8;margin-top:16px}.return{display:inline-block;margin-top:72px;padding-block:16px;border-bottom:1px solid var(--line)}#viz-reader{margin:auto;width:94vw;max-width:1800px;max-height:94vh;border:0;padding:20px;background:var(--surface);border-radius:16px}#viz-reader::backdrop{background:#000c}#viz-reader img{width:100%;height:auto}.close{display:block;margin:0 0 16px auto;padding:8px 16px;background:var(--inverse);color:var(--on-inverse);border-radius:999px;cursor:pointer}@media(max-width:767px){.section{padding-top:80px}.intro{font-size:18px}dl,.jobs,.timeline,.decision-copy{grid-template-columns:1fr;gap:20px}.diagnosis,.strategy-nav{grid-template-columns:1fr 1fr}.hero-image{padding:12px}.zoom{padding:8px}.zoom>span{right:16px;bottom:16px}.validation{margin-top:64px}.decision{padding-block:32px}}
</style>
