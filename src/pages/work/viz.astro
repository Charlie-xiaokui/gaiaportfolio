---
import BaseLayout from '@/layouts/BaseLayout.astro';

const a = (name: string) => `/viz-case/${name}.jpg`;

const tasks = [
  {
    key: 'query',
    tab: '快速取数',
    title: '先拿到工作需要的数据。',
    copy: '运营、产品、设计等用户，需要查业务数据、做排序或简单分析，用于日报与周报。',
    route: ['选择字段', '查看结果'],
    needs: ['快速找到目标功能，并理解怎样使用。', '减少常规数据处理的重复配置。'],
  },
  {
    key: 'chart',
    tab: '图表生产',
    title: '让数据成为可以交付的图表。',
    copy: '数据 BP 等用户要长期维护图表与仪表盘，除了取数，还需要清晰表达与合适的默认样式。',
    route: ['选择字段', '选择图表与样式', '产出结果'],
    needs: ['默认图表清晰准确地展示数据。', '提供模板，减少格式调整与重复制作。'],
  },
  {
    key: 'analysis',
    tab: '探索分析',
    title: '看见结果之后，继续提出问题。',
    copy: '数据分析师等用户探索关联，需要持续使用分析能力，反复改变计算方式、观察结果。',
    route: ['选择字段', '调整分析条件', '观察结果并再调整'],
    needs: ['分析功能与计算能力足够完整。', '让条件与结果同时可见，不中断连续探索。'],
  },
];

const presets = [
  { key: 'normal', tab: '常规展示', explain: '常规展示：标签、数值与条形在同一行，便于直接比较。', long: false, softFrom: -1 },
  { key: 'long', tab: '标签过长', explain: '标签过长：文字移到条形上方，不挤占条形宽度，也不截断标签。', long: true, softFrom: -1 },
  { key: 'top', tab: '强调前三', explain: '强调前三：前三项保持视觉主导，后续项弱化，但完整数值仍可读。', long: false, softFrom: 3 },
];

const bars = [
  { name: '东北', full: '中国-东北区', value: 2000, width: '100%' },
  { name: '华东', full: '中国-华东区', value: 1800, width: '90%' },
  { name: '中南', full: '中国-中南区', value: 1700, width: '85%' },
  { name: '西北', full: '中国-西北区', value: 1550, width: '77.5%' },
  { name: '西南', full: '中国-西南区', value: 1450, width: '72.5%' },
  { name: '华北', full: '中国-华北区', value: 1300, width: '65%' },
];

const palettes = [
  ['蓝色科技'], ['年轻零售'], ['电商零售'], ['复古商务'], ['传统制造'], ['政府金融'], ['医疗环保'], ['多彩泛互'],
].map((p, i) => ({ key: String(i), name: p[0] }));

const launch = [
  { t: '在用户群里，把变化提前讲清。', d: '分享关键产出、征询意见，同时预告重构进度，给用户留出理解与适应的缓冲。' },
  { t: '分四期上线，每期先做可用性测试。', d: '在测试环境发现问题并调整；全量灰度前开展新版培训，让功能和变化被看见，而不是等发布后集中承担风险。' },
  { t: '监测新版，也回访留下的人。', d: '用看板观察行为变化，主动了解旧版忠实用户的顾虑，再做小范围的精准调整。' },
  { t: '让迁移完成，再告别旧版。', d: '上线一个月后，新版 UV 占比均值达到 66.4%；两个月后旧版下线。资料记录这次切换未引发用户负面反馈。' },
];
---

<BaseLayout
  title="可视化查询设计重构 · 降低学习门槛，不牺牲专业能力"
  description="一个已经被熟练用户用顺手的数据工具，如何变得对新手友好。围绕快速取数、图表生产、探索分析三类任务重构框架、配置、学习与视觉，并陪伴用户完成迁移。"
  type="article"
  closing={false}
>
  <article class="viz-case">
    <header class="shell pt-12 sm:pt-16">
      <nav aria-label="面包屑" class="rise text-sm text-muted">
        <a href="/">作品案例</a> <span aria-hidden="true"> / </span>
        <span class="text-ink">可视化查询设计重构</span>
      </nav>
      <p class="rise kicker mt-12" style="--rise-step:1">风神 BI · 可视化查询体验重构</p>
      <h1 class="rise case-title mt-6" style="--rise-step:2">把门槛降下来，不把专业性拿走</h1>
      <p class="rise case-lead mt-8" style="--rise-step:3">一个已经被熟练用户“用顺手”的数据工具，如何变得对新手友好？这次重构没有把复杂功能藏起来，而是重新设计了从字段到结果的路径。</p>
      <dl class="rise case-meta mt-12" style="--rise-step:4">
        <div><dt>我的职责</dt><dd>项目设计 Owner</dd></div>
        <div><dt>工作范围</dt><dd>专家走查、需求梳理、用户访谈、结构与框架优化、交互与视觉设计</dd></div>
        <div><dt>项目过程</dt><dd>半年重构，分 4 期上线</dd></div>
      </dl>
    </header>

    <div class="shell mt-14">
      <figure class="hero-stage">
        <div class="hero-toggle" role="group" aria-label="查看重构前后界面">
          <button type="button" data-hero="before" aria-pressed="false">看原来的界面</button>
          <button type="button" data-hero="after" aria-pressed="true" class="is-active">看重构后的界面</button>
        </div>
        <img id="viz-hero-img" src={a('hero')} width="1868" height="1028" alt="新版可视化查询界面，左侧字段、中间配置、右侧结果" fetchpriority="high" data-lightbox />
        <figcaption id="viz-hero-caption">新版：字段、配置与结果沿工作路径展开（真实原稿，非可操作系统）</figcaption>
      </figure>
    </div>

    <!-- 01 矛盾 -->
    <section class="shell story-section reveal" aria-labelledby="challenge-title">
      <div class="story-copy">
        <p class="eyebrow">01 / 重构的起点</p>
        <h2 id="challenge-title">“更易用、更高效”，不是把按钮做得更少</h2>
        <p>可视化查询原本是内部数据工具的重要模块。商业化推进后体验标准提高了；但面对同一个编辑器，运营与设计同学想快速取数，数据分析师却希望更完整、更连续地探索。</p>
      </div>
      <div class="two-col">
        <article class="text-card">
          <h3>新手被复杂度挡在门外</h3>
          <p>内容分类不合理，新增功能难发现，部分配置含义不直观。学习一个工具，变成了理解一套系统术语。</p>
        </article>
        <article class="text-card">
          <h3>老用户不愿为“简化”付出代价</h3>
          <p>原有交互已经形成肌肉记忆。从 1 到 2 的重构，任何变化都可能带来额外使用成本。</p>
        </article>
      </div>
      <figure class="shot-panel">
        <img src={a('before')} width="927" height="519" alt="原来的编辑界面：顶部功能平铺，结果区域受挤压" loading="lazy" data-lightbox />
        <figcaption>旧界面：功能平铺、结果区域受挤压</figcaption>
      </figure>
      <div class="statement">我的切入点：让不同任务找到自己的路径，而不是用一种“简化”覆盖所有人。</div>
      <div class="two-col">
        <article class="text-card subtle"><h3>先诊断，而不是先换皮</h3><p>专家自查与用户研究定位到屏效、信息架构、扩展性和视觉精致度四类问题。</p></article>
        <article class="text-card subtle"><h3>借鉴的是思考逻辑</h3><p>围绕框架、图表组件、筛选组件与分析配置研究竞品，把成熟方案放回真实场景判断。</p></article>
      </div>
    </section>

    <!-- 02 用户与任务 -->
    <section class="shell story-section reveal" aria-labelledby="users-title">
      <div class="story-copy">
        <p class="eyebrow">02 / 理解用户</p>
        <h2 id="users-title">同一个人，也可能有三种任务：先按目标，而不是按资历分类</h2>
        <p>我们归纳了快速取数、图表生产、探索分析三类用户目标。每一类里都有新手、中间用户与熟练用户，不能把“取数”直接等同于“小白”。点击切换，观察路径与需求的差异。</p>
      </div>
      <div class="task-tabs" data-task-tabs role="tablist" aria-label="用户任务">
        {tasks.map((t, i) => (
          <button type="button" role="tab" id={`viz-task-tab-${t.key}`} aria-controls="viz-task-panel" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class={i === 0 ? 'is-active' : ''} data-task-key={t.key}>{t.tab}</button>
        ))}
      </div>
      <div class="task-preview" id="viz-task-panel" role="tabpanel" aria-live="polite">
        <h3 id="viz-task-title">{tasks[0].title}</h3>
        <p id="viz-task-copy">{tasks[0].copy}</p>
        <div class="task-route" id="viz-task-route">
          {tasks[0].route.map((step) => <span class="route-chip">{step}</span>)}
        </div>
        <ul id="viz-task-needs">
          {tasks[0].needs.map((need) => <li>{need}</li>)}
        </ul>
      </div>
      <figure class="shot-panel">
        <img src={a('user-paths')} width="2220" height="1290" alt="三类场景的工作路径以及框架前后对比原稿" loading="lazy" data-lightbox />
        <figcaption>同一框架承载不同任务：取数、制图与连续分析</figcaption>
      </figure>
    </section>

    <!-- 03 灵活拓展 -->
    <section class="shell story-section reveal" aria-labelledby="structure-title">
      <div class="story-copy">
        <p class="eyebrow">03 / 设计取舍 · 灵活拓展</p>
        <h2 id="structure-title">先把结构理顺，再把选择权还给用户</h2>
        <p>三类任务的起点不同，但都需要从字段到结果。框架重组让操作顺着任务发生，而不是让用户在平铺的功能里找路。</p>
      </div>
      <div class="three-zones" aria-label="重构框架示意">
        <div><strong>字段</strong>我要看什么</div>
        <div><strong>配置</strong>我要怎样看</div>
        <div><strong>结果</strong>数据说明什么</div>
      </div>
      <div class="two-col">
        <article class="text-card"><h3>一个被放弃的“理所当然”</h3><p>起初想把高频命令统一放到工具条。但使用数据说明：不同用户的“常用”差异很大，无法合理归为同一套默认。</p></article>
        <article class="text-card"><h3>所以，选择自定义</h3><p>让用户调整工具条的功能与顺序，既保留熟练操作，也让工作台随任务变化。</p></article>
      </div>
      <figure class="shot-panel">
        <img src={a('toolbar')} width="1553" height="1163" alt="默认工具条与可自定义工具条设计原稿" loading="lazy" data-lightbox />
        <figcaption>保留操作习惯，但不假设所有人的习惯相同</figcaption>
      </figure>
      <div class="sub-head">
        <h3>筛选器别再挤走图表</h3>
        <p>比较等分、适宽、网格布局后，选择调整成本较低、排列规整的等分方案，再提供“左右 / 上下 × 宽松 / 适中 / 紧凑”六种组合。</p>
      </div>
      <figure class="shot-panel">
        <img src={a('layout')} width="2033" height="600" alt="筛选器布局调整前后，图表区域获得更多空间" loading="lazy" data-lightbox />
        <figcaption>布局选择不是越自由越好，也要考虑操作成本与结构稳定</figcaption>
      </figure>
    </section>

    <!-- 04 配置提效 -->
    <section class="dark-section" aria-labelledby="efficiency-title">
      <div class="shell story-section reveal">
        <div class="story-copy on-dark">
          <p class="eyebrow">04 / 设计取舍 · 配置提效</p>
          <h2 id="efficiency-title">让配置跟着问题走，别让分析被窗口打断</h2>
          <p>配置不是分析的前置手续，而是探索的一部分。用户会观察结果、改变条件，再观察；界面要支撑这段循环。</p>
        </div>

        <div class="demo on-dark">
          <h3>同一份数据，三种阅读任务</h3>
          <p class="demo-note">点击模板，看长标签与重点信息如何被照顾。教学样例取自原稿，不是项目业务指标。</p>
          <div class="preset-tabs" data-preset-tabs role="tablist" aria-label="条形图预设">
            {presets.map((p, i) => (
              <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class={i === 0 ? 'is-active' : ''} data-preset-key={p.key}>{p.tab}</button>
            ))}
          </div>
          <div class="bar-demo" id="viz-bars">
            {bars.map((bar, i) => (
              <div class="bar-row" data-bar-index={i}>
                <span class="bar-name" data-short={bar.name} data-long={bar.full}>{bar.name}</span>
                <div class="bar-track"><div class="bar-fill" style={`width:${bar.width}`} data-soft={i >= 3 ? 'true' : 'false'}></div></div>
                <span class="bar-value">{bar.value}</span>
              </div>
            ))}
          </div>
          <p class="preset-explain" id="viz-preset-explain" aria-live="polite">{presets[0].explain}</p>
        </div>
        <div class="two-col dark-text">
          <article class="text-card on-dark"><h3>预设不是换皮，是封装实践</h3><p>长标签使用上下布局，避免截断；强调前三时降低后续项视觉权重。把反复格式调整，变成与业务任务相关的选择。</p></article>
          <article class="text-card on-dark"><h3>专业能力没有消失</h3><p>预设负责让常见需求更快落地，细节配置仍然支持继续调整。</p></article>
        </div>
        <figure class="shot-panel on-dark">
          <img src={a('preset-long')} width="570" height="471" alt="原稿中的长标签条形图预设" loading="lazy" data-lightbox />
          <figcaption class="on-dark">网页演示是对设计意图的重建，原始方案可放大对照</figcaption>
        </figure>

        <div class="sub-head on-dark">
          <h3>亲手感受“并排”与“遮挡”的区别</h3>
          <p>同样是设置 TopN，侧边面板让结果留在视野里；弹窗则遮住正在观察的数据。下面用同一组教学数据演示这个取舍。</p>
        </div>
        <div class="demo on-dark">
          <div class="analysis-toggle" data-analysis-toggle role="group" aria-label="分析面板方案对照">
            <button type="button" data-analysis="side" aria-pressed="true" class="is-active">方案：侧边面板</button>
            <button type="button" data-analysis="modal" aria-pressed="false">对照：遮挡式弹窗</button>
          </div>
          <div class="analysis-play" id="viz-analysis-play">
            <div class="fake-config">
              <label for="viz-topn">显示数量</label>
              <select id="viz-topn">
                <option value="6">全部 6 个地区</option>
                <option value="3">数量最高的 3 个地区</option>
                <option value="2">数量最高的 2 个地区</option>
              </select>
              <p class="select-note">教学示意，未连接查询服务</p>
            </div>
            <div class="result-table">
              <table>
                <thead><tr><th>地区</th><th>数量</th></tr></thead>
                <tbody id="viz-analysis-results">
                  {bars.map((bar) => <tr><td>{bar.name}</td><td>{bar.value}</td></tr>)}
                </tbody>
              </table>
            </div>
          </div>
          <p class="preset-explain" id="viz-analysis-explain" aria-live="polite">侧边面板：条件与结果同时可见，可以连续观察、调整，再观察。</p>
        </div>
        <figure class="shot-panel on-dark">
          <img src={a('analysis')} width="1388" height="863" alt="真实方案中分析面板与数据结果并排" loading="lazy" data-lightbox />
          <figcaption class="on-dark">分析面板和结果同时展示，保持探索连续性</figcaption>
        </figure>
      </div>
    </section>

    <!-- 05 简单易学 -->
    <section class="shell story-section reveal" aria-labelledby="learning-title">
      <div class="story-copy">
        <p class="eyebrow">05 / 设计取舍 · 简单易学</p>
        <h2 id="learning-title">不要求每个用户学会术语，先让他看懂会发生什么</h2>
        <p>复杂能力不必靠复杂表达证明。与其让用户猜“这个选项是什么意思”，不如展示它怎样改变结果。</p>
      </div>
      <div class="sql-grid">
        <div><label>列表筛选</label><p>“从所有省份中，选出北京、上海。”</p></div>
        <div><label>条件筛选</label><p>“查看人口数量大于 100 万的省份。”</p></div>
        <div><label>关联筛选</label><p>“已有一张省份排名，沿用其中的省份查看相关数据。”</p></div>
      </div>
      <p class="note">原稿中的业务语言示例，不代表真实人口统计或排名。</p>
      <figure class="shot-panel">
        <img src={a('sql')} width="1868" height="998" alt="将 SQL 与筛选规则转译为业务语言和表单输入的方案" loading="lazy" data-lightbox />
        <figcaption>把数据能力转译成用户任务，让不会 SQL 的人也能完成查询</figcaption>
      </figure>
      <div class="two-col learning-cols">
        <article>
          <h3>配置说明，用结果举例</h3>
          <p>对 TopN 等复杂分析选项，结合具体结果介绍计算规则，降低猜测成本。</p>
          <figure class="shot-panel inner"><img src={a('topn')} width="2678" height="1245" alt="复杂 TopN 选项搭配具体表格案例的说明" loading="lazy" data-lightbox /><figcaption>复杂规则与示例绑定</figcaption></figure>
        </article>
        <article>
          <h3>空态，也能教人怎样开始</h3>
          <p>默认呈现骨架、数据要求和适用场景，悬停后展示示例结果。空白不再是“没有数据”，而是学习入口。</p>
          <figure class="shot-panel inner"><img src={a('empty')} width="1553" height="663" alt="表格空态骨架与示例数据的对比" loading="lazy" data-lightbox /><figcaption>空态成为可视化最佳实践的传播阵地</figcaption></figure>
        </article>
      </div>
      <div class="two-col comic-col">
        <figure class="shot-panel"><img src={a('comic')} width="1335" height="720" alt="以图书馆类比数据集、漫画演绎查询分析" loading="lazy" data-lightbox /><figcaption>与运营共创，用类比和漫画解释数据能力</figcaption></figure>
        <article class="text-card">
          <h3>让说明有一个可理解的世界</h3>
          <p>“图书馆借书”类比数据集搭建，漫画演绎查询分析。帮助文档不再只是一份配置清单。</p>
          <p class="note">资料记录阅读量和点赞量提升，但未提供明细，因此作为教育方式的反馈，不包装成未经核对的增长数字。</p>
        </article>
      </div>
    </section>

    <!-- 06 优化视效 -->
    <section class="shell story-section reveal" aria-labelledby="visual-title">
      <div class="story-copy">
        <p class="eyebrow">06 / 设计取舍 · 优化视效</p>
        <h2 id="visual-title">数据可以更精致，但首先要看得清</h2>
        <p>视觉升级不仅是增加质感。信息层级、图标辨识和图表色彩，都要服务于“更快理解内容”。</p>
      </div>
      <div class="two-col">
        <article class="text-card"><h3>图形传达含义，层级让内容站出来</h3><p>强化图标的代表性特征，提升精致度；整体界面仍保持清爽，把字段和图表留在注意力中心。</p></article>
        <article class="text-card"><h3>颜色先解决辨识，再表达风格</h3><p>原配色存在对比不足、文字不清晰和选择过少的问题。行业代表色与色彩关系形成方案，辨识度与舒适度评估再把它收敛。</p></article>
      </div>
      <figure class="shot-panel">
        <img src={a('icons')} width="1034" height="761" alt="通知、确认与空态图形的设计素材" loading="lazy" data-lightbox />
        <figcaption>图标与情境表达，图形素材来自原稿，未重新生成</figcaption>
      </figure>
      <div class="sub-head">
        <h3>八套配色，放回同一组图表里看</h3>
        <p>切换原稿中的方案，比较的不只是色块，而是同一配色在折线、柱状、饼图和构成图中的表现。</p>
      </div>
      <div class="palette-tabs" data-palette-tabs role="tablist" aria-label="原稿八套配色">
        {palettes.map((p, i) => (
          <button type="button" role="tab" id={`viz-palette-tab-${p.key}`} aria-controls="viz-palette-panel" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class={i === 0 ? 'is-active' : ''} data-palette-key={p.key}>{p.name}</button>
        ))}
      </div>
      <figure class="shot-panel palette-panel" id="viz-palette-panel" role="tabpanel">
        <img id="viz-palette-img" src={a('palette-0')} width="608" height="604" alt="蓝色科技配色的图表应用" loading="lazy" data-lightbox />
        <figcaption id="viz-palette-caption">蓝色科技。真实方案取自原稿，图中数据为设计样例。</figcaption>
      </figure>
      <details class="source-details">
        <summary>查看配色的推导与评估依据</summary>
        <figure class="shot-panel"><img src={a('color-process')} width="1583" height="1214" alt="行业代表色、色彩关系、辨识与舒适度测试资料" loading="lazy" data-lightbox /><figcaption>原稿包含研究参考，不据此宣称已通过某项公开认证。</figcaption></figure>
      </details>
    </section>

    <!-- 07 验证与迁移 -->
    <section class="dark-section" aria-labelledby="launch-title">
      <div class="shell story-section reveal">
        <div class="story-copy on-dark">
          <p class="eyebrow">07 / 从方案到迁移</p>
          <h2 id="launch-title">交付不是把新版推给用户，而是陪他们走过变化</h2>
          <p>一个被用了很久的工具，不能只验证新用户能否上手。还要知道：老用户不愿切换，是习惯、能力缺失，还是其他顾虑？</p>
        </div>
        <ol class="launch-list">
          {launch.map((item, i) => (
            <li><i>{i + 1}</i><div><h3>{item.t}</h3><p>{item.d}</p></div></li>
          ))}
        </ol>
        <figure class="shot-panel on-dark">
          <img src={a('validation')} width="2723" height="1448" alt="问卷征询、分期测试上线与监测回访的过程原稿" loading="lazy" data-lightbox />
          <figcaption class="on-dark">问卷征询、四期测试上线、数据监测与旧版用户回访</figcaption>
        </figure>
      </div>
    </section>

    <!-- 08 结果 -->
    <section class="shell story-section reveal" aria-labelledby="result-title">
      <div class="story-copy">
        <p class="eyebrow">08 / 结果与边界</p>
        <h2 id="result-title">用户开始选择新版，重构也留下了可复用的方法</h2>
      </div>
      <div class="result-row">
        <div class="outcome">
          <strong>66.4%</strong>
          <p>模块上线一个月后，新版 UV 占比的均值。</p>
          <p class="result-note">这是使用占比，不是增长率，也不等于全体用户满意度；资料未提供完整样本及计算明细。</p>
        </div>
        <figure class="shot-panel inner-fig">
          <img src={a('uv')} width="1328" height="743" alt="原稿中的新旧版 UV 与占比变化图" loading="lazy" data-lightbox />
          <figcaption>行为监测原图，保留原图，不从截图反推日序列</figcaption>
        </figure>
      </div>
      <div class="two-col">
        <article class="text-card"><h3>两个月后，旧版下线</h3><p>资料记录未引发用户负面反馈；培训中也收到关于实用性与操作流畅度的正向评价。表述限于材料所记录的反馈范围，不等于对全部用户作出保证。</p></article>
        <article class="text-card"><h3>从单点重构，走向团队资产</h3><p>沉淀体验监测看板、重构方法和筛选组件合集，为后续模块迭代提供设计与验证依据。</p></article>
      </div>
      <div class="reflection">
        <article><h3>简化的是路径。</h3><p>专业能力不必被删掉；清晰结构与场景化默认，让不同任务都能找到工作入口。</p></article>
        <article><h3>验证的是变化。</h3><p>新版好不好看只是起点，更重要的是它能否接住已有习惯、解释新增能力并完成迁移。</p></article>
        <article><h3>留下的是方法。</h3><p>从调研、取舍到量化验证，让每次重构都能为下一次提供证据，而不只是一张漂亮截图。</p></article>
      </div>
      <details class="source-details">
        <summary>故事线与资料对应</summary>
        <ul class="source-list">
          <li>背景、问题和用户：PDF 1–5 页，讲解稿前半部分。</li>
          <li>结构与配置：PDF 6–11 页；上手与教育：PDF 12–15 页。</li>
          <li>视觉与配色：PDF 16–20 页；验证、结果与沉淀：PDF 21–23 页。</li>
          <li>项目叙述经过编辑重组；不补造用户原话、研究样本、功能上线时间或成绩。本页是案例展示，不是完整可视化查询应用。</li>
        </ul>
      </details>
    </section>

    <div class="shell back-link"><a href="/">返回作品集 <span aria-hidden="true">↗</span></a></div>
  </article>

  <div class="viz-lightbox" id="viz-lightbox" aria-hidden="true">
    <button type="button" class="viz-lightbox-close" id="viz-lightbox-close" aria-label="关闭">×</button>
    <div class="viz-lightbox-body" id="viz-lightbox-body"></div>
  </div>
</BaseLayout>

<script>
  (function () {
    try {
      var reduce = matchMedia('(prefers-reduced-motion: reduce)');

      function markGroup(selector: string, btn: Element, attr: string) {
        document.querySelectorAll<HTMLElement>(selector).forEach(function (b) {
          var selected = b === btn;
          b.setAttribute(attr, String(selected));
          if (attr === 'aria-selected') b.tabIndex = selected ? 0 : -1;
          b.classList.toggle('is-active', selected);
        });
      }

      // 三类任务切换
      var tasks: Record<string, { title: string; copy: string; route: string[]; needs: string[] }> = {
        query: { title: '先拿到工作需要的数据。', copy: '运营、产品、设计等用户，需要查业务数据、做排序或简单分析，用于日报与周报。', route: ['选择字段', '查看结果'], needs: ['快速找到目标功能，并理解怎样使用。', '减少常规数据处理的重复配置。'] },
        chart: { title: '让数据成为可以交付的图表。', copy: '数据 BP 等用户要长期维护图表与仪表盘，除了取数，还需要清晰表达与合适的默认样式。', route: ['选择字段', '选择图表与样式', '产出结果'], needs: ['默认图表清晰准确地展示数据。', '提供模板，减少格式调整与重复制作。'] },
        analysis: { title: '看见结果之后，继续提出问题。', copy: '数据分析师等用户探索关联，需要持续使用分析能力，反复改变计算方式、观察结果。', route: ['选择字段', '调整分析条件', '观察结果并再调整'], needs: ['分析功能与计算能力足够完整。', '让条件与结果同时可见，不中断连续探索。'] },
      };
      document.querySelectorAll<HTMLElement>('[data-task-key]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var t = tasks[btn.dataset.taskKey || 'query'];
          markGroup('[data-task-key]', btn, 'aria-selected');
          var title = document.getElementById('viz-task-title');
          var copy = document.getElementById('viz-task-copy');
          var route = document.getElementById('viz-task-route');
          var needs = document.getElementById('viz-task-needs');
          if (title) title.textContent = t.title;
          if (copy) copy.textContent = t.copy;
          if (route) route.innerHTML = t.route.map(function (s) { return '<span class="route-chip">' + s + '</span>'; }).join('');
          if (needs) needs.innerHTML = t.needs.map(function (s) { return '<li>' + s + '</li>'; }).join('');
        });
      });

      // hero 前后切换
      document.querySelectorAll<HTMLElement>('[data-hero]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var before = btn.dataset.hero === 'before';
          markGroup('[data-hero]', btn, 'aria-pressed');
          var img = document.getElementById('viz-hero-img') as HTMLImageElement | null;
          var cap = document.getElementById('viz-hero-caption');
          if (img) {
            img.src = before ? '/viz-case/before.jpg' : '/viz-case/hero.jpg';
            img.alt = before ? '重构前的可视化查询界面：功能平铺' : '新版可视化查询界面，左侧字段、中间配置、右侧结果';
          }
          if (cap) cap.textContent = before ? '旧版：功能平铺，结果区域受挤压' : '新版：字段、配置与结果沿工作路径展开（真实原稿，非可操作系统）';
        });
      });

      // 条形图预设
      var presetExplain: Record<string, string> = {
        normal: '常规展示：标签、数值与条形在同一行，便于直接比较。',
        long: '标签过长：文字移到条形上方，不挤占条形宽度，也不截断标签。',
        top: '强调前三：前三项保持视觉主导，后续项弱化，但完整数值仍可读。',
      };
      document.querySelectorAll<HTMLElement>('[data-preset-key]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var mode = btn.dataset.presetKey || 'normal';
          markGroup('[data-preset-key]', btn, 'aria-selected');
          document.querySelectorAll<HTMLElement>('.bar-row').forEach(function (row, i) {
            var nameEl = row.querySelector<HTMLElement>('.bar-name');
            var fill = row.querySelector<HTMLElement>('.bar-fill');
            var long = mode === 'long';
            row.classList.toggle('is-long', long);
            if (nameEl) nameEl.textContent = long ? (nameEl.dataset.long || '') : (nameEl.dataset.short || '');
            if (fill) fill.classList.toggle('is-soft', mode === 'top' && i >= 3);
          });
          var explain = document.getElementById('viz-preset-explain');
          if (explain) explain.textContent = presetExplain[mode];
        });
      });

      // 侧边 / 弹窗对照
      var analysisText: Record<string, string> = {
        side: '侧边面板：条件与结果同时可见，可以连续观察、调整，再观察。',
        modal: '遮挡式弹窗：结果被遮住，修改条件时难以同时参照结果。这里故意降低结果可见度，演示遮挡影响。',
      };
      document.querySelectorAll<HTMLElement>('[data-analysis]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var modal = btn.dataset.analysis === 'modal';
          markGroup('[data-analysis]', btn, 'aria-pressed');
          var play = document.getElementById('viz-analysis-play');
          var explain = document.getElementById('viz-analysis-explain');
          if (play) play.classList.toggle('is-modal', modal);
          if (explain) explain.textContent = modal ? analysisText.modal : analysisText.side;
        });
      });
      var names = ['东北', '华东', '中南', '西北', '西南', '华北'];
      var values = [2000, 1800, 1700, 1550, 1450, 1300];
      var topn = document.getElementById('viz-topn') as HTMLSelectElement | null;
      if (topn) topn.addEventListener('change', function () {
        var n = Number((topn as HTMLSelectElement).value);
        var body = document.getElementById('viz-analysis-results');
        if (!body || !([2, 3, 6] as number[]).includes(n)) return;
        body.innerHTML = names.slice(0, n).map(function (nm: string, i: number) { return '<tr><td>' + nm + '</td><td>' + values[i] + '</td></tr>'; }).join('');
      });

      // 八套配色
      var paletteNames = ['蓝色科技', '年轻零售', '电商零售', '复古商务', '传统制造', '政府金融', '医疗环保', '多彩泛互'];
      document.querySelectorAll<HTMLElement>('[data-palette-key]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var i = Number(btn.dataset.paletteKey);
          markGroup('[data-palette-key]', btn, 'aria-selected');
          var img = document.getElementById('viz-palette-img') as HTMLImageElement | null;
          var cap = document.getElementById('viz-palette-caption');
          if (img) { img.src = '/viz-case/palette-' + i + '.jpg'; img.alt = paletteNames[i] + '配色的图表应用'; }
          if (cap) cap.textContent = paletteNames[i] + '。真实方案取自原稿，图中数据为设计样例。';
        });
      });

      // Tablist 方向键
      document.querySelectorAll<HTMLElement>('[role="tablist"]').forEach(function (list) {
        list.addEventListener('keydown', function (e) {
          var tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
          var idx = tabs.indexOf(e.target as HTMLButtonElement);
          if (idx < 0) return;
          var next = idx;
          if (e.key === 'ArrowRight') next = (idx + 1) % tabs.length;
          else if (e.key === 'ArrowLeft') next = (idx + tabs.length - 1) % tabs.length;
          else if (e.key === 'Home') next = 0;
          else if (e.key === 'End') next = tabs.length - 1;
          else return;
          e.preventDefault();
          tabs[next].focus();
          tabs[next].click();
        });
      });

      // 灯箱
      var box = document.getElementById('viz-lightbox');
      var bodyEl = document.getElementById('viz-lightbox-body');
      var closeBtn = document.getElementById('viz-lightbox-close');
      function closeBox() { if (!box || !bodyEl) return; box.classList.remove('is-open'); box.setAttribute('aria-hidden', 'true'); bodyEl.innerHTML = ''; }
      document.querySelectorAll<HTMLImageElement>('[data-lightbox]').forEach(function (img) {
        img.style.cursor = 'zoom-in';
        img.addEventListener('click', function () {
          if (!box || !bodyEl) return;
          var clone = img.cloneNode(true) as HTMLImageElement;
          clone.removeAttribute('loading');
          clone.style.cursor = 'default';
          bodyEl.innerHTML = '';
          bodyEl.appendChild(clone);
          box.classList.add('is-open');
          box.setAttribute('aria-hidden', 'false');
        });
      });
      if (closeBtn) closeBtn.addEventListener('click', closeBox);
      if (box) box.addEventListener('click', function (e) { if (e.target === box) closeBox(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeBox(); });

      // 滚动揭示
      var revealEls = Array.from(document.querySelectorAll('.reveal'));
      if (!reduce.matches && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) { entry.target.classList.add('in'); io.unobserve(entry.target); }
          });
        }, { threshold: 0.1 });
        revealEls.forEach(function (el) { io.observe(el); });
      } else {
        revealEls.forEach(function (el) { el.classList.add('in'); });
      }
    } catch (error) {
      console.error(error);
    }
  })();
</script>

<style>
  :global(body), :global(body *) { font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; }
  .viz-case { --v-ink:#202630; --v-muted:#5d6775; --v-accent:#125fbd; --v-blue:#3a75dc; --v-teal:#259993; --v-deep:#0f1a2b; --v-line:#dce2e9; --v-panel:#f4f7fb; --v-tint:#edf4ff; padding-bottom: 96px; }
  .viz-case .shell { width: min(1120px, calc(100% - 40px)); margin-inline: auto; }
  .viz-case .kicker { color: var(--v-accent); font-size: 13px; letter-spacing: .14em; font-weight: 700; }
  .case-title { font-size: clamp(38px, 5.6vw, 70px); line-height: 1.1; letter-spacing: -.04em; font-weight: 650; }
  .case-lead { max-width: 50rem; font-size: clamp(17px, 1.8vw, 22px); line-height: 1.8; color: var(--v-muted); }
  .case-meta { display: grid; gap: 28px; padding-block: 32px; border-top: 1px solid var(--v-line); border-bottom: 1px solid var(--v-line); }
  .case-meta dt { font-size: 13px; color: var(--v-muted); } .case-meta dd { margin-top: 8px; line-height: 1.7; }

  .hero-stage { margin: 0; border: 1px solid var(--v-line); border-radius: 22px; background: #dce9f5; padding: 20px 24px 24px; }
  .hero-toggle { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; }
  .hero-toggle button { border: 1px solid #b9cde4; background: rgba(255,255,255,.85); color: #263341; border-radius: 999px; padding: 9px 18px; min-height: 42px; cursor: pointer; font-size: 14px; }
  .hero-toggle button.is-active { background: var(--v-accent); border-color: var(--v-accent); color: #fff; font-weight: 600; }
  .hero-stage img { width: 100%; height: auto; border-radius: 12px; }
  .hero-stage figcaption { margin-top: 12px; color: #315778; font-size: 13px; text-align: center; }

  .story-section { padding-top: 120px; }
  .story-copy { max-width: 840px; }
  .story-copy .eyebrow { color: var(--v-accent); font-size: 13px; letter-spacing: .12em; font-weight: 700; }
  .story-copy h2 { margin-top: 20px; font-size: clamp(28px, 3.8vw, 46px); line-height: 1.24; letter-spacing: -.03em; font-weight: 650; }
  .story-copy > p:not(.eyebrow) { margin-top: 22px; font-size: 18px; line-height: 34px; color: var(--v-muted); }
  .story-copy.on-dark h2 { color: #fff; } .story-copy.on-dark > p { color: #aebace; }

  .two-col { display: grid; gap: 18px; grid-template-columns: 1fr; margin-top: 28px; }
  .text-card { background: #fff; border: 1px solid var(--v-line); border-radius: 18px; padding: 26px; }
  .text-card h3 { margin: 0 0 12px; font-size: 21px; } .text-card p { margin: 0; color: var(--v-muted); line-height: 1.8; }
  .text-card.subtle { background: var(--v-panel); }
  .text-card.on-dark { background: #101c30; border-color: #293a53; } .text-card.on-dark h3 { color: #fff; } .text-card.on-dark p { color: #aebace; }
  .shot-panel { margin: 28px 0 0; background: #fff; border: 1px solid var(--v-line); border-radius: 18px; padding: 16px; }
  .shot-panel.on-dark { background: #101c30; border-color: #293a53; }
  .shot-panel img { width: 100%; height: auto; border-radius: 12px; }
  figcaption { color: var(--v-muted); font-size: 13px; margin-top: 12px; text-align: center; }
  figcaption.on-dark { color: #bacce3; }
  .statement { margin-top: 36px; padding: 28px 0; border-top: 1px solid var(--v-line); border-bottom: 1px solid var(--v-line); font-size: clamp(22px, 3vw, 30px); line-height: 1.55; font-weight: 600; }

  .task-tabs, .preset-tabs, .analysis-toggle, .palette-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 32px; }
  .task-tabs button, .preset-tabs button, .analysis-toggle button, .palette-tabs button { border: 1px solid var(--v-line); background: #fff; color: var(--v-ink); border-radius: 999px; padding: 11px 18px; min-height: 44px; cursor: pointer; font-size: 15px; }
  .task-tabs button.is-active, .preset-tabs button.is-active, .analysis-toggle button.is-active, .palette-tabs button.is-active { background: var(--v-accent); border-color: var(--v-accent); color: #fff; font-weight: 600; }
  .task-tabs button:focus-visible, .preset-tabs button:focus-visible, .analysis-toggle button:focus-visible, .palette-tabs button:focus-visible, .hero-toggle button:focus-visible { outline: 3px solid #71b3ff; outline-offset: 2px; }
  .task-preview { margin-top: 18px; background: var(--v-panel); border: 1px solid var(--v-line); border-radius: 18px; padding: 28px; }
  .task-preview h3 { margin: 0 0 10px; font-size: 22px; } .task-preview > p { margin: 0 0 16px; color: var(--v-muted); line-height: 1.8; }
  .task-route { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
  .route-chip { padding: 8px 14px; background: #fff; border: 1px solid var(--v-line); border-radius: 8px; font-size: 14px; }
  .route-chip:not(:last-child)::after { content: '›'; margin-left: 12px; color: var(--v-muted); }
  .task-preview ul { margin: 0; padding-left: 20px; color: var(--v-muted); display: grid; gap: 8px; line-height: 1.7; }

  .three-zones { display: grid; gap: 8px; grid-template-columns: 1fr; margin-top: 32px; color: #293844; }
  .three-zones div { padding: 20px; border-radius: 12px; text-align: center; line-height: 1.7; }
